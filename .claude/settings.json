{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Ls(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "TodoRead(*)",
      "TodoWrite(*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/token-session-init.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/aeonic-ingest.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/yuri-boot.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/startup-offload.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/nisaba-subagent-start.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/scout-init.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/eot-background-start.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/user-prompt-submit.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/nisaba-subagent-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scout-inject.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/aeonic-enforce.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-use.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/scout-spawn.js",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/nisaba-on-stop.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/token-session-end.js",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/token-status.js"
  },
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": false,
  "theme": "dark-ansi",
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true
}
