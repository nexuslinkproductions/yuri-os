{
  "env": {
    "CLAUDE_CODE_BASH_NO_TIMEOUT": "1",
    "NUDIMMUD_WORKHORSE_TIMEOUT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(chmod *)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Ls(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "TodoRead(*)",
      "TodoWrite(*)"
    ],
    "deny": [
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)",
      "MultiEdit(.env)",
      "Read(.claude/history.jsonl)",
      "Write(.claude/history.jsonl)",
      "Edit(.claude/history.jsonl)",
      "MultiEdit(.claude/history.jsonl)",
      "Write(.claude/state/session-state.json)",
      "Edit(.claude/state/session-state.json)",
      "MultiEdit(.claude/state/session-state.json)",
      "Write(.claude/memory-bus.json)",
      "Edit(.claude/memory-bus.json)",
      "MultiEdit(.claude/memory-bus.json)",
      "Write(.claude/state/scout-bus.json)",
      "Edit(.claude/state/scout-bus.json)",
      "MultiEdit(.claude/state/scout-bus.json)",
      "Write(.claude/state/scout-errors.log)",
      "Edit(.claude/state/scout-errors.log)",
      "MultiEdit(.claude/state/scout-errors.log)",
      "Write(.claude/state/token-session.json)",
      "Edit(.claude/state/token-session.json)",
      "MultiEdit(.claude/state/token-session.json)"
    ]
  },
  "model": "user-selected",
  "hooks": {
    "SessionStart": [
      {
        "priority": 90,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/token-session-init.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/brain-inject.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/musubi-protocol-ingest.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/startup-offload.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/scout-orchestrator.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/eot-background-start.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node Scripts/memory-archive.mjs --execute",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "priority": 50,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/user-prompt-submit.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "priority": 50,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/soul-persona-inject.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/yuri-sentinel-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "priority": 10,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-gate.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/bash-security-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/tirith-url-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/claude-protocol-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/musubi-protocol-enforce.js"
          }
        ]
      },
      {
        "priority": 30,
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/marcelspatz/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      },
      {
        "priority": 10,
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-spawn-guard.js",
            "timeout": 5,
            "statusMessage": "Agent spawn guard (NUDIMMUD policy)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "priority": 30,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-use.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/scout-orchestrator.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/token-tool-logger.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-checkpoint.js",
            "async": true
          }
        ]
      },
      {
        "priority": 30,
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/marcelspatz/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "priority": 90,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/yuri-sentinel-stop.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/token-session-end.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node Scripts/memory-session-write.mjs",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/token-status.js"
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "prefersReducedMotion": false,
  "theme": "dark-ansi",
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "agentPushNotifEnabled": true
}
