        "easing": {
          "snap": "cubic-bezier(.42, .0, .58, 1) — headings, quick-punch",
          "glide": "cubic-bezier(.25, .8, .5, 1) — panels/cards, soft-lag",
          "pop": "cubic-bezier(.68, -0.4, .265, 1.4) — badges/buttons, snappy-with-overshoot"
        },
        "radius": "lg 22px, md 16px, sm 10px",
