{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate Features",
  "description": "Market candidate with computed feature scores for filtering and ranking",
  "type": "object",
  "required": [
    "market_id",
    "symbol",
    "liquidity_score",
    "urgency_score",
    "volatility_score",
    "execution_feasibility_score",
    "timestamp"
  ],
  "properties": {
    "market_id": {
      "type": "string",
      "description": "Market identifier from snapshot"
    },
    "symbol": {
      "type": "string",
      "description": "Trading pair symbol"
    },
    "liquidity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Function of spread, depth, 24h volume normalized 0-1"
    },
    "urgency_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Time-to-expiry decay (not used for crypto; placeholder)"
    },
    "volatility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Recent price movement vs rolling baseline"
    },
    "execution_feasibility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Expected slippage for target position size"
    },
    "composite_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Weighted average for ranking"
    },
    "is_candidate": {
      "type": "boolean",
      "description": "Passes filter thresholds"
    },
    "filter_rejection_reason": {
      "type": "string",
      "description": "If not candidate: why (spread_too_wide, illiquid, etc.)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Feature computation timestamp"
    }
  },
  "examples": [
    {
      "market_id": "BTC-USD",
      "symbol": "BTC-USD",
      "liquidity_score": 0.95,
      "urgency_score": 0.5,
      "volatility_score": 0.62,
      "execution_feasibility_score": 0.88,
      "composite_score": 0.74,
      "is_candidate": true,
      "filter_rejection_reason": null,
      "timestamp": "2026-05-05T12:34:56.789Z"
    }
  ]
}
