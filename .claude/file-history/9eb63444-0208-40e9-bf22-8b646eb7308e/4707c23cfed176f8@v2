type RouteHealthPayload = {
    healthy?: boolean;
    ready?: boolean;
    alive?: boolean;
    status?: string;
    [key: string]: unknown;
};

type ApiRouteOptions = {
    getStatusPayload?: () => Promise<unknown>;
    getHealth?: () => Promise<RouteHealthPayload>;
    getReadiness?: () => Promise<RouteHealthPayload>;
    getLiveness?: () => RouteHealthPayload;
};

