### Step 5 — Add `/api/terminal/run` endpoint (HTTP fallback)
**File**: `backend/src/routes/api.ts`

Add a new route after the `/execute` route:

```ts
router.post('/terminal/run', authMiddleware, async (req, res) => {
    const { command } = req.body;
    if (typeof command !== 'string' || !command.trim()) {
        return res.status(400).json({ error: 'command required' });
    }
    try {
        const { stdout, stderr } = await new Promise<{stdout: string; stderr: string}>((resolve, reject) => {
            const child = spawn(command, [], { cwd: SystemConfig.ROOT, shell: true, env: process.env });
            let stdout = '', stderr = '';
            child.stdout.on('data', d => stdout += d.toString());
            child.stderr.on('data', d => stderr += d.toString());
            child.on('error', reject);
            child.on('close', () => resolve({ stdout, stderr }));
        });
        res.json({ stdout, stderr });
    } catch (err: any) {
        res.status(500).json({ stdout: '', stderr: err.message });
    }
});
```

- Update OracleTerminal.tsx fallback to use `apiFetch('/api/terminal/run', { method: 'POST', body: JSON.stringify({ command: cmd }) })`
- Import `apiFetch` from `../../lib/runtime`

