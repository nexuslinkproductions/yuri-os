## State Model

```typescript
// types.ts
interface NudimmudDesignConfig {
  theme: string;            // 'Cyber HUD' | 'Luxury Dark' | 'Neon Terminal' | ...
  motionIntensity: string;  // 'Calm' | 'Responsive' | 'Energetic' | 'Cinematic'
  backgroundLife: string;   // 'Static depth' | 'Animated gradient field' | ...
  layoutMode: string;       // 'Split HUD' | 'Floating panels' | ...
  componentStyle: string;   // 'Rounded glass' | 'Sharp tactical' | ...
  auditTone: string;        // 'Clean professional' | 'Game mission report' | ...
  enabledFunctions: string[];
  confirmed: boolean;
}

interface NUDIMMUD_DESIGN_HANDOFF {
  schema: '1.0.0';
  generated: string;        // ISO timestamp
  config: NudimmudDesignConfig;
  auditSummary: Record<string, number>;  // section -> score
  suggestions: { priority: 'HIGH'|'MED'|'LOW'; text: string }[];
  styleDirection: string;
  nextBuildInstructions: string[];
}
```

State lives in `DesignAuditHUD/index.tsx` via `useState`. Never in `localStorage`. Debug panel always-visible JSON view updates on every chip selection.

