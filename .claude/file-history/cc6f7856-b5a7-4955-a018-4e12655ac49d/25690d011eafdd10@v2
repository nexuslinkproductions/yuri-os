import React, { useCallback, useEffect, useRef, useState } from 'react';

interface TermLine { id: number; text: string; type: 'cmd' | 'out' | 'err' | 'info'; }

const CHEATSHEET = [
    {
        category: 'Oracle',
        commands: [
            { cmd: 'oracle <prompt>',       desc: 'Send prompt to Oracle (streaming)' },
            { cmd: 'oracle --council <q>',  desc: 'Aeonic Council deliberation' },
            { cmd: 'oracle status',         desc: 'System health + model status' },
        ]
    },
    {
        category: 'Offload',
        commands: [
            { cmd: 'offload deepseek <task>', desc: 'Route to local Deepseek' },
            { cmd: 'offload qwen <task>',     desc: 'Route to local Qwen' },
            { cmd: 'offload kimi <task>',     desc: 'Route to cloud Kimi' },
            { cmd: 'offload --swarm <task>',  desc: 'Fan-out via Ruflo swarm' },
        ]
    },
    {
        category: 'GitNexus',
        commands: [
            { cmd: 'gitnexus impact <sym>',   desc: 'Blast radius analysis' },
            { cmd: 'gitnexus context <sym>',  desc: 'Full symbol context' },
            { cmd: 'gitnexus query <concept>',desc: 'Semantic code search' },
        ]
    },
    {
        category: 'System',
        commands: [
            { cmd: 'tokens',        desc: 'Show session + weekly token spend' },
            { cmd: 'pm2 status',    desc: 'Backend process status' },
            { cmd: 'pm2 restart all', desc: 'Restart all PM2 processes' },
            { cmd: 'ls .claude/state/', desc: 'Show state files' },
        ]
    }
];

let lineId = 0;

export default function OracleTerminal() {
    const [lines, setLines]     = useState<TermLine[]>([
        { id: lineId++, text: 'NUDIMMUD terminal — type "help" for cheatsheet', type: 'info' },
        { id: lineId++, text: 'WS bridge: ws://localhost:3004/ws/shell', type: 'info' },
    ]);
    const [input, setInput]     = useState('');
    const [history, setHistory] = useState<string[]>([]);
    const [histIdx, setHistIdx] = useState(-1);
    const [showSheet, setShowSheet] = useState(true);
    const bottomRef = useRef<HTMLDivElement>(null);
    const wsRef     = useRef<WebSocket | null>(null);

    // Connect WebSocket shell
    useEffect(() => {
        try {
            const ws = new WebSocket('ws://localhost:3004/ws/shell');
            ws.onmessage = (e) => {
                try {
                    const { type, data } = JSON.parse(e.data);
                    setLines(prev => [...prev, { id: lineId++, text: String(data || ''), type: type === 'stderr' ? 'err' : 'out' }]);
                } catch {
                    setLines(prev => [...prev, { id: lineId++, text: String(e.data), type: 'out' }]);
                }
            };
            ws.onerror = () => setLines(prev => [...prev, { id: lineId++, text: 'WS: connection failed — shell integration unavailable', type: 'err' }]);
            wsRef.current = ws;
            return () => ws.close();
        } catch {
            setLines(prev => [...prev, { id: lineId++, text: 'WS: not available', type: 'info' }]);
        }
    }, []);

    useEffect(() => { bottomRef.current?.scrollIntoView({ behavior: 'smooth' }); }, [lines]);

    const submit = useCallback(() => {
        const cmd = input.trim();
        if (!cmd) return;
        setLines(prev => [...prev, { id: lineId++, text: `$ ${cmd}`, type: 'cmd' }]);
        setHistory(prev => [cmd, ...prev.slice(0, 49)]);
        setHistIdx(-1);
        setInput('');

        if (cmd === 'help') {
            setShowSheet(true);
            return;
        }
        if (cmd === 'clear') {
            setLines([{ id: lineId++, text: 'Terminal cleared.', type: 'info' }]);
            return;
        }

        if (wsRef.current?.readyState === WebSocket.OPEN) {
            wsRef.current.send(JSON.stringify({ command: cmd }));
        } else {
            // Fallback: fetch via API execute endpoint
            fetch('/api/execute', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ command: cmd, cwd: '/Users/marcelspatz/NUDIMMUD' })
            })
            .then(r => r.json())
            .then(d => {
                const out = d.stdout || d.output || d.result || '';
                const err = d.stderr || d.error || '';
                if (out) setLines(prev => [...prev, { id: lineId++, text: String(out), type: 'out' }]);
                if (err) setLines(prev => [...prev, { id: lineId++, text: String(err), type: 'err' }]);
            })
            .catch(e => setLines(prev => [...prev, { id: lineId++, text: `Error: ${e.message}`, type: 'err' }]));
        }
    }, [input]);

    const onKeyDown = useCallback((e: React.KeyboardEvent) => {
        if (e.key === 'Enter') { submit(); return; }
        if (e.key === 'ArrowUp') {
            const idx = Math.min(histIdx + 1, history.length - 1);
            setHistIdx(idx);
            setInput(history[idx] || '');
        }
        if (e.key === 'ArrowDown') {
            const idx = Math.max(histIdx - 1, -1);
            setHistIdx(idx);
            setInput(idx < 0 ? '' : history[idx] || '');
        }
    }, [submit, history, histIdx]);

    return (
        <div style={{ display: 'flex', height: '100%', fontFamily: 'JetBrains Mono, monospace', fontSize: 12 }}>
            {/* Output pane */}
            <div style={{ flex: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
                <div style={{ flex: 1, overflowY: 'auto', padding: '8px 12px' }}>
                    {lines.map(l => (
                        <div key={l.id} style={{ lineHeight: 1.6, color: LINE_COLOR[l.type], whiteSpace: 'pre-wrap', wordBreak: 'break-all' }}>
                            {l.text}
                        </div>
                    ))}
                    <div ref={bottomRef}/>
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '6px 12px', borderTop: '1px solid rgba(159,232,115,0.1)' }}>
                    <span style={{ color: 'var(--cyan-glow)', userSelect: 'none' }}>$</span>
                    <input
                        value={input}
                        onChange={e => setInput(e.target.value)}
                        onKeyDown={onKeyDown}
                        style={{
                            flex: 1, background: 'none', border: 'none', outline: 'none',
                            color: 'var(--silver-albedo)', fontFamily: 'inherit', fontSize: 12
                        }}
                        placeholder="command..."
                        autoFocus
                    />
                </div>
            </div>

            {/* Cheatsheet sidebar */}
            {showSheet && (
                <div style={{ width: 260, borderLeft: '1px solid rgba(159,232,115,0.1)', overflowY: 'auto', padding: '8px 12px' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
                        <span style={{ fontSize: 9, letterSpacing: '0.12em', color: 'var(--gold-solar)', textTransform: 'uppercase' }}>Cheatsheet</span>
                        <button onClick={() => setShowSheet(false)} style={{ background: 'none', border: 'none', color: 'var(--text-dim)', cursor: 'pointer', fontSize: 10 }}>×</button>
                    </div>
                    {CHEATSHEET.map(section => (
                        <div key={section.category} style={{ marginBottom: 12 }}>
                            <div style={{ fontSize: 9, color: 'var(--cyan-glow)', letterSpacing: '0.1em', marginBottom: 4, textTransform: 'uppercase', opacity: 0.7 }}>
                                {section.category}
                            </div>
                            {section.commands.map(c => (
                                <div key={c.cmd} style={{ marginBottom: 4, cursor: 'pointer' }}
                                    onClick={() => setInput(c.cmd.replace(/<[^>]+>/g, ''))}>
                                    <div style={{ color: 'var(--gold-solar)', fontSize: 10 }}>{c.cmd}</div>
                                    <div style={{ color: 'rgba(247,247,247,0.4)', fontSize: 10 }}>{c.desc}</div>
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            )}
        </div>
    );
}

const LINE_COLOR: Record<TermLine['type'], string> = {
    cmd:  'var(--cyan-glow)',
    out:  'rgba(247,247,247,0.8)',
    err:  'var(--red-fusion)',
    info: 'rgba(247,247,247,0.35)'
};
