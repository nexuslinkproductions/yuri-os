#!/usr/bin/env node
const fs = require('fs');

const STATE_DIR = '/Users/marcelspatz/NUDIMMUD/.claude/state';
const SESSION_FILE = `${STATE_DIR}/token-session.json`;

try {
  const input = fs.readFileSync(0, 'utf-8').trim();
  if (!input) {
    console.log("Token Monitor Offline");
    process.exit(0);
  }

  const data = JSON.parse(input);

  const model = data?.model?.display_name || data?.model?.name || 'Claude';
  const context = data?.context_window?.used_percentage || 0;
  const inputTokens = data?.usage?.input_tokens || data?.prompt_tokens || data?.tokens_in || data?.message_tokens || 0;
  const outputTokens = data?.usage?.output_tokens || data?.completion_tokens || data?.tokens_out || 0;
  const totalTokens = data?.usage?.total_tokens || data?.total_tokens || data?.tokens || (inputTokens + outputTokens) || 0;
  const cost = data?.cost || data?.session_cost || 0;

  // Persist session state for HUD polling
  try {
    const existing = fs.existsSync(SESSION_FILE) ? JSON.parse(fs.readFileSync(SESSION_FILE, 'utf-8')) : {};
    fs.writeFileSync(SESSION_FILE, JSON.stringify({
      model,
      context,
      inputTokens: (existing.inputTokens || 0) + inputTokens,
      outputTokens: (existing.outputTokens || 0) + outputTokens,
      totalTokens: (existing.totalTokens || 0) + totalTokens,
      cost: parseFloat(((existing.cost || 0) + cost).toFixed(6)),
      updatedAt: new Date().toISOString()
    }, null, 2));
  } catch (_) {}

  const parts = [];
  parts.push(`🧠 ${model}`);
  let contextIcon = context < 50 ? '🟢' : (context < 85 ? '🟡' : '🔴');
  parts.push(`${contextIcon} Context: ${context}%`);
  if (totalTokens > 0) parts.push(`🔄 Total: ${totalTokens.toLocaleString()}`);
  if (inputTokens > 0 || outputTokens > 0) parts.push(`↑${inputTokens.toLocaleString()} ↓${outputTokens.toLocaleString()}`);
  if (cost > 0) parts.push(`$${parseFloat(cost).toFixed(4)}`);

  console.log(parts.join('  |  '));
} catch (e) {
  console.log(`Status Error: ${e.message}`);
}
