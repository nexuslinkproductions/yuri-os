<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NUDIMMUD // COMMAND CENTER</title>
    <link rel="stylesheet" href="index.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <meta name="theme-color" content="#0d0a09">
    <meta name="color-scheme" content="dark">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <a href="#module-content" class="skip-link">Skip to main content</a>

    <!-- LAYER 0: BACKGROUND ENGINE (behind everything) -->
    <canvas id="qi-flow-canvas"></canvas>
    <div class="vignette"></div>
    <div class="global-scanline"></div>

    <!-- LAYER 1: APP SHELL -->
    <div class="app-shell">

        <!-- ROW 1: HEADER -->
        <header class="shell-header">
            <div class="logo">
                <div id="enki-orb" class="status-orb"></div>
                <div class="brand-lockup" style="display:flex;align-items:center;gap:10px;">
                    <img src="/src/assets/nudimmud-logo.svg" alt="NUDIMMUD" width="40" height="40" style="image-rendering:pixelated;flex-shrink:0;" title="NUDIMMUD // Operator System"/>
                    <div style="display:flex;flex-direction:column;">
                        <span class="brand-kicker" translate="no">OPERATOR SYSTEM</span>
                        <span class="brand-wordmark" translate="no">NUDIMMUD</span>
                    </div>
                </div>
            </div>
            <div class="shell-route-column">
                <div class="route-directive" translate="no">Route command rail</div>
                <div class="cortex-command-shell">
                    <div class="command-row">
                        <span class="command-prefix">>></span>
                        <input
                            type="text"
                            id="global-command-input"
                            name="global-command"
                            aria-label="Global operator command"
                            placeholder="Route a directive, module, or task…"
                            autocomplete="off"
                            spellcheck="false"
                        >
                    </div>
                    <div class="command-helper" translate="no">Try /setup /polish /audit /critique /status /result or type btw to enter offload mode.</div>
                </div>
                <nav id="sidebar-nav" class="top-nav-rail" aria-label="Primary navigation">
                    <div class="nav-node active" data-module="NEXUSLINK"><span class="nav-label">NexusLink</span></div>
                    <div class="nav-node" data-module="RESEARCH"><span class="nav-label">Research</span></div>
                    <div class="nav-node" data-module="CHRONOS"><span class="nav-label">Chronos</span></div>
                    <div class="nav-node" data-module="INDRA"><span class="nav-label">Indra</span></div>
                    <div class="nav-node" data-module="ABZU"><span class="nav-label">Abzu</span></div>
                    <div class="nav-node" data-module="LOGOS"><span class="nav-label">Logos</span></div>
                    <div class="nav-node" data-module="DIRECTIVE"><span class="nav-label">Directive</span></div>
                    <div class="nav-node" data-module="ORACLE" style="border-left-color:var(--gold-solar);"><span class="nav-label" style="color:var(--gold-solar);">Oracle</span></div>
                    <div class="nav-node" data-module="PHYSIS"><span class="nav-label">Physis</span></div>
                    <div class="nav-node" data-module="TICKETS"><span class="nav-label">Tickets</span></div>
                </nav>
            </div>
            <div class="system-status">
                <div class="status-pill">
                    <span class="status-pill-label">Heartbeat</span>
                    <span id="shell-heartbeat">NOMINAL</span>
                </div>
                <div class="status-pill">
                    <span class="status-pill-label">Risk</span>
                    <span id="shell-risk">LOW</span>
                </div>
                <div class="status-pill">
                    <span class="status-pill-label">Clock</span>
                    <span id="clock">00:00:00</span>
                </div>
            </div>
        </header>

        <!-- ROW 2 COL 2: MAIN CONTENT STAGE -->
        <section id="module-content">
            <div style="padding:100px;text-align:center;opacity:0.42;font-family:var(--font-mono);letter-spacing:0.32em;">
                Loading command surface...
            </div>
        </section>

        <!-- ROW 2 COL 3: CONTEXT PANEL (Dynamic Reflow) -->
        <aside id="context-panel"></aside>




        <!-- ROW 3: FOOTER (spans all 3 columns) -->
        <footer>
            <div style="display:flex;gap:30px;align-items:center;">
                <div>Internal drive: <span style="color:var(--cyan-glow);font-family:var(--font-mono);">Active</span></div>
                <div>Nodes: <span style="color:var(--cyan-glow);font-family:var(--font-mono);" id="footer-node-count">--</span></div>
                <div style="display:flex; align-items:center; gap:10px; border-left:1px solid rgba(255,255,255,0.1); padding-left:20px;">
                    <span class="text-mono" style="font-size:0.6rem; opacity:0.4;">Swarm sync</span>
                    <div class="telemetry-bar-bg" style="width:100px; height:4px;"><div id="bar-sync" class="telemetry-bar-fill" style="width:0%; background:var(--gold-solar);"></div></div>
                    <span class="text-mono" style="font-size:0.6rem; color:var(--gold-solar);" id="bar-sync-text">--%</span>
                </div>
                <div style="display:flex; align-items:center; gap:10px; border-left:1px solid rgba(255,255,255,0.1); padding-left:20px;">
                    <span class="text-mono" style="font-size:0.6rem; opacity:0.4;">Cognitive load</span>
                    <span class="text-mono" style="font-size:0.6rem; color:var(--cyan-glow);" id="load-percentage">--%</span>
                </div>
            </div>
            <div style="margin-left:auto; display:flex; gap:30px; align-items:center;">
                <div class="footer-signal-rail">
                    <div class="footer-signal">
                        <span class="footer-signal-label">Confidence</span>
                        <span id="footer-confidence">MEDIUM</span>
                    </div>
                    <div class="footer-signal">
                        <span class="footer-signal-label">Disagreement</span>
                        <span id="footer-disagreement">CLEAR</span>
                    </div>
                    <div class="footer-signal">
                        <span class="footer-signal-label">Heartbeat</span>
                        <span id="footer-heartbeat">NOMINAL</span>
                    </div>
                </div>
                <div id="react-token-status-bar" style="height:36px;display:flex;align-items:center;"></div>
                <div id="oracle-wake-status" class="text-mono" style="font-size:0.55rem; color:var(--gold-solar); background:rgba(255,184,0,0.05); padding:4px 10px; border:1px solid rgba(255,184,0,0.2);">Oracle listening...</div>
                <div style="font-family:var(--font-mono); font-size:0.65rem; opacity:0.5;">
                    Stability: <span style="color:var(--cyan-glow);">99.8%</span> // 432Hz
                </div>
            </div>
        </footer>

    </div>

    <div id="mission-sidebar" class="neural-glass" style="position: fixed; top: 0; right: 0; width: 450px; height: 100vh; background: rgba(10,13,26,0.98); z-index: 10000; border-left: 1px solid var(--cyan-glow); box-shadow: -10px 0 30px rgba(0,0,0,0.8); transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column;">
        <div style="padding: 24px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div class="text-mono" style="font-size:0.6rem; color:var(--cyan-glow); letter-spacing:0.1em; margin-bottom:4px;">ExeoFlow // documentation link</div>
                <h3 id="mission-sidebar-title" style="font-size:1.1rem; margin:0;">Mission name</h3>
            </div>
            <button id="mission-sidebar-close" style="background:transparent; border:none; color:white; cursor:pointer; font-size:1.5rem; opacity:0.5;">&times;</button>
        </div>
        <div style="padding: 24px; flex-grow: 1; overflow-y: auto;">
            <div class="text-mono" style="font-size:0.65rem; color:var(--text-dim); margin-bottom:20px;" id="mission-sidebar-meta"></div>
            
            <h4 class="text-mono" style="font-size:0.7rem; color:var(--gold-solar); margin-bottom:8px;">Execution notes</h4>
            <textarea id="mission-sidebar-notes" class="neural-glass" style="width:100%; height:150px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); color:white; padding:12px; font-family:var(--font-mono); font-size:0.75rem; resize:none; margin-bottom:24px;" placeholder="Document time spent, blockers resolved, and systems affected..."></textarea>
            
            <h4 class="text-mono" style="font-size:0.7rem; color:var(--cyan-glow); margin-bottom:8px;">Time tracking</h4>
            <input type="text" id="mission-sidebar-time" class="neural-glass" style="width:100%; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); color:white; padding:12px; font-family:var(--font-mono); font-size:0.75rem; margin-bottom:24px;" placeholder="e.g. 1h 30m">

            <button id="mission-sidebar-submit" class="text-mono" style="width:100%; background:rgba(0,242,255,0.1); border:1px solid var(--cyan-glow); color:var(--cyan-glow); padding:16px; cursor:pointer; letter-spacing:0.1em; font-size:0.8rem; transition: background 0.2s;">Transmit to ExeoFlow</button>
            <button id="mission-sidebar-reinstate" class="text-mono" style="width:100%; background:rgba(255,184,0,0.05); border:1px solid var(--gold-solar); color:var(--gold-solar); padding:12px; cursor:pointer; letter-spacing:0.1em; font-size:0.7rem; margin-top:12px; transition: background 0.2s; display:none;">Reinstate mission</button>
            <div id="mission-sidebar-status" class="text-mono" style="font-size:0.6rem; text-align:center; margin-top:12px; opacity:0;"></div>
        </div>
    </div>

    <div id="hover-tooltip"></div>
    <div id="three-bg" style="position:fixed; top:0; left:0; width:100%; height:100%; z-index:-1; pointer-events:none; opacity:0.6;"></div>
    <script type="module" src="/src/main.ts"></script>
</body>
</html>
