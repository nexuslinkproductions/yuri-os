{
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/.local/bin:${env:PATH}",
    "NUDIMMUD_STARTUP_SEED": "${workspaceFolder}/.claude/nisaba/learning/global.md",
    "NUDIMMUD_CAVEMAN": "1",
    "NUDIMMUD_OFFLOAD": "1",
    "NUDIMMUD_PRIMARY_IDE": "vscode",
    "NUDIMMUD_STATE_DIR": "${workspaceFolder}/.claude/state",
    "ORACLE_ENDPOINT": "http://localhost:3004/api/oracle",
    "BACKEND_PORT": "3004",
    "FRONTEND_PORT": "5173"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "emmet.includeLanguages": { "typescript": "html" },
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 13,
  "workbench.colorTheme": "Default Dark+",
  "claude.primaryIDE": "vscode",
  "claude.offloadLanes": ["deepseek", "qwen", "kimi", "swarm"],
  "claude.tokenEconomy": true
}
