import fs from 'fs';
import path from 'path';
import { JSDOM } from 'jsdom';
import { Readability } from '@mozilla/readability';
import { neuralForge } from './neuralForgeService';
import { notebookTranscribe } from './notebookTranscribeService';
import { NotebookService } from './notebookService';
import { SystemConfig } from '../config/SystemConfig';

const AUDIO_EXTS = new Set(['.mp3', '.mp4', '.m4a', '.wav', '.ogg', '.flac', '.webm']);

export interface IngestResult {
    sourceId: number;
    chunkCount: number;
    wordCount: number;
}

export class NotebookIngestService {
    private notebookService: NotebookService;

    constructor(notebookService: NotebookService) {
        this.notebookService = notebookService;
    }

    async ingestFile(notebookId: number, filePath: string, mimeType: string, originalName: string): Promise<IngestResult> {
        const ext = path.extname(originalName).toLowerCase();
        const stats = fs.statSync(filePath);

        let text = '';
        let sourceType: 'pdf' | 'docx' | 'audio' | 'video' | 'url' | 'obsidian' = 'pdf';
        let metadata: Record<string, unknown> = {};

        if (ext === '.pdf' || mimeType === 'application/pdf') {
            sourceType = 'pdf';
            text = await this.extractPdf(filePath);
        } else if (ext === '.docx' || mimeType.includes('wordprocessingml')) {
            sourceType = 'docx';
            text = await this.extractDocx(filePath);
        } else if (AUDIO_EXTS.has(ext) || mimeType.startsWith('audio/') || mimeType.startsWith('video/')) {
            sourceType = ext === '.mp4' || mimeType.startsWith('video/') ? 'video' : 'audio';
            const transcript = await notebookTranscribe.transcribe(filePath);
            text = transcript.text;
            metadata = { provider: transcript.provider, durationSeconds: transcript.durationSeconds };
        } else {
            throw new Error(`Unsupported file type: ${ext}`);
        }

        const source = this.notebookService.createSource(notebookId, sourceType, originalName, {
            originPath: filePath,
            fileSizeBytes: stats.size,
            mimeType,
            metadata
        });

        return this.processTextIntoChunks(source.id, text);
    }

    async ingestUrl(notebookId: number, url: string): Promise<IngestResult> {
        const source = this.notebookService.createSource(notebookId, 'url', url, {
            originPath: url
        });

        try {
            this.notebookService.updateSourceStatus(source.id, 'processing');
            const text = await this.fetchAndExtractUrl(url);
            return await this.processTextIntoChunks(source.id, text);
        } catch (e: any) {
            this.notebookService.updateSourceStatus(source.id, 'error', e.message);
            throw e;
        }
    }

    async ingestObsidianNote(notebookId: number, vaultRelativePath: string): Promise<IngestResult> {
        const fullPath = SystemConfig.resolve(vaultRelativePath);
        if (!fs.existsSync(fullPath)) throw new Error(`Vault note not found: ${vaultRelativePath}`);

        const raw = fs.readFileSync(fullPath, 'utf-8');
        // Strip YAML frontmatter
        const text = raw.replace(/^---[\s\S]*?---\n?/, '').trim();
        const title = path.basename(vaultRelativePath, '.md');

        const source = this.notebookService.createSource(notebookId, 'obsidian', title, {
            obsidianPath: vaultRelativePath,
            fileSizeBytes: Buffer.byteLength(raw, 'utf-8')
        });

        return this.processTextIntoChunks(source.id, text);
    }

    private async extractPdf(filePath: string): Promise<string> {
        const pdfParse = (await import('pdf-parse')).default;
        const buffer = fs.readFileSync(filePath);
        const result = await (pdfParse as any)(buffer);
        return result.text;
    }

    private async extractDocx(filePath: string): Promise<string> {
        const mammoth = await import('mammoth');
        const result = await mammoth.extractRawText({ path: filePath });
        return result.value;
    }

    private async fetchAndExtractUrl(url: string): Promise<string> {
        const resp = await fetch(url, {
            headers: { 'User-Agent': 'Mozilla/5.0 (compatible; NUDIMMUD/1.0)' },
            signal: AbortSignal.timeout(15000)
        });
        if (!resp.ok) throw new Error(`HTTP ${resp.status} fetching ${url}`);
        const html = await resp.text();

        const dom = new JSDOM(html, { url });
        const reader = new Readability(dom.window.document);
        const article = reader.parse();
        return article?.textContent?.trim() || dom.window.document.body?.textContent?.trim() || '';
    }

    private async processTextIntoChunks(sourceId: number, text: string): Promise<IngestResult> {
        try {
            this.notebookService.updateSourceStatus(sourceId, 'processing');

            const words = text.split(/\s+/).filter(Boolean);
            const wordCount = words.length;
            const rawChunks = this.chunkText(words);

            this.notebookService.saveChunks(sourceId, rawChunks);
            this.notebookService.updateSourceStatus(sourceId, 'processing', undefined, wordCount);

            // Embed asynchronously (don't block the response)
            this.embedAllChunks(sourceId, rawChunks.length).catch(e =>
                console.error(`⬡ NOTEBOOK_EMBED_ERROR :: source=${sourceId} :: ${e.message}`)
            );

            // Set status to ready immediately — embeddings fill in async
            this.notebookService.updateSourceStatus(sourceId, 'ready', undefined, wordCount);

            return { sourceId, chunkCount: rawChunks.length, wordCount };
        } catch (e: any) {
            this.notebookService.updateSourceStatus(sourceId, 'error', e.message);
            throw e;
        }
    }

    private chunkText(words: string[], windowTokens = 512, overlapTokens = 64): Array<{ content: string; tokenCount: number }> {
        const wordsPerWindow = Math.floor(windowTokens / 1.35);
        const wordsPerOverlap = Math.floor(overlapTokens / 1.35);
        const minWords = Math.floor(50 / 1.35);
        const chunks: Array<{ content: string; tokenCount: number }> = [];

        let start = 0;
        while (start < words.length) {
            const end = Math.min(start + wordsPerWindow, words.length);
            const slice = words.slice(start, end);
            if (slice.length >= minWords) {
                const content = slice.join(' ');
                chunks.push({ content, tokenCount: Math.ceil(slice.length * 1.35) });
            }
            if (end >= words.length) break;
            start += (wordsPerWindow - wordsPerOverlap);
        }
        return chunks;
    }

    private async embedAllChunks(sourceId: number, expectedCount: number): Promise<void> {
        const chunks = this.notebookService.getChunksForSource(sourceId);
        for (const chunk of chunks) {
            const embedding = await neuralForge.getEmbedding(chunk.content);
            if (embedding) {
                this.notebookService.updateChunkEmbedding(chunk.id, embedding);
            }
        }
        console.log(`⬡ NOTEBOOK_EMBED_DONE :: source=${sourceId} :: ${chunks.length}/${expectedCount} chunks embedded`);
    }
}
