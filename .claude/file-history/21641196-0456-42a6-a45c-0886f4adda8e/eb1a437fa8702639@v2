import { apiFetch, API_ORIGINS } from './runtime';

export interface Notebook {
    id: number;
    title: string;
    description: string | null;
    model_id: string;
    created_at: string;
    updated_at: string;
    sources?: NotebookSource[];
    docs?: NotebookDoc[];
}

export interface NotebookSource {
    id: number;
    notebook_id: number;
    title: string;
    source_type: 'pdf' | 'docx' | 'audio' | 'video' | 'url' | 'obsidian';
    origin_path: string | null;
    status: 'pending' | 'processing' | 'ready' | 'error';
    error_msg: string | null;
    word_count: number;
    created_at: string;
}

export interface NotebookDoc {
    id: number;
    notebook_id: number;
    doc_type: 'summary' | 'study_guide' | 'faq' | 'timeline' | 'briefing';
    title: string;
    content: string;
    pdf_path: string | null;
    obsidian_path: string | null;
    model_id: string | null;
    created_at: string;
}

export interface NotebookMessage {
    id: number;
    role: 'user' | 'assistant';
    content: string;
    sources_used: string | null;
    created_at: string;
}

export interface RagCitation {
    chunk_id: number;
    source_title: string;
    excerpt: string;
}

export type DocType = 'summary' | 'study_guide' | 'faq' | 'timeline' | 'briefing';

// ─── Notebooks ──────────────────────────────────────────────────────────────

export async function createNotebook(title: string): Promise<Notebook> {
    const r = await apiFetch('/api/notebook/notebooks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title })
    });
    return r.json();
}

export async function listNotebooks(): Promise<Notebook[]> {
    const r = await apiFetch('/api/notebook/notebooks');
    return r.json();
}

export async function getNotebook(id: number): Promise<Notebook> {
    const r = await apiFetch(`/api/notebook/notebooks/${id}`);
    return r.json();
}

export async function updateNotebook(id: number, patch: { title?: string; description?: string }): Promise<void> {
    await apiFetch(`/api/notebook/notebooks/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(patch)
    });
}

export async function deleteNotebook(id: number): Promise<void> {
    await apiFetch(`/api/notebook/notebooks/${id}`, { method: 'DELETE' });
}

// ─── Sources ────────────────────────────────────────────────────────────────

export async function uploadSources(notebookId: number, files: File[]): Promise<any[]> {
    const form = new FormData();
    files.forEach(f => form.append('files', f));
    const r = await apiFetch(`/api/notebook/notebooks/${notebookId}/sources/upload`, {
        method: 'POST',
        body: form
    });
    return r.json();
}

export async function addUrlSource(notebookId: number, url: string): Promise<any> {
    const r = await apiFetch(`/api/notebook/notebooks/${notebookId}/sources/url`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
    });
    return r.json();
}

