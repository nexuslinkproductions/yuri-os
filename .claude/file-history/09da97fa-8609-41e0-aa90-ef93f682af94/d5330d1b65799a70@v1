import React, { useCallback, useEffect, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    submitOracleCommandStream,
    submitOracleCommand,
    subscribeOracleCommandState,
    type OracleCommandState
} from '../../lib/oracleCommandBridge';
import { apiFetch } from '../../lib/runtime';
import VisualSynthesisLane from './VisualSynthesisLane';
import OracleToolOrbs from './OracleToolOrbs';
import OracleTerminal from './OracleTerminal';
import NotebookTab from './NotebookTab/NotebookTab';

interface ChatMessage {
    id: string;
    role: 'user' | 'nexus';
    content: string;
    streaming?: boolean;
    timestamp: string;
    files?: UploadedFile[];
}

interface UploadedFile {
    name: string;
    type: string;
    dataUrl: string;
    size: number;
}

interface ImageModel {
    id: string;
    label: string;
    provider: string;
}

type TabId = 'context' | 'research' | 'code' | 'visual' | 'ops' | 'notebook';

const TABS: { id: TabId; label: string; icon: string }[] = [
    { id: 'context',  label: 'Context',  icon: '◈' },
    { id: 'research', label: 'Research', icon: '◎' },
    { id: 'code',     label: 'Code',     icon: '⬡' },
    { id: 'visual',   label: 'Visual',   icon: '◆' },
    { id: 'ops',      label: 'Ops',      icon: '◉' },
    { id: 'notebook', label: 'Notebook', icon: '◧' }
];

const REASONING_LEVELS = ['low', 'medium', 'high', 'council'] as const;
type ReasoningLevel = typeof REASONING_LEVELS[number];

const REASONING_COLORS: Record<ReasoningLevel, string> = {
    low:     'var(--text-dim)',
    medium:  'var(--cyan-glow)',
    high:    'var(--gold-solar)',
    council: 'var(--red-fusion)'
};

export default function OraclePage() {
    const [messages, setMessages] = useState<ChatMessage[]>([{
        id: 'boot',
        role: 'nexus',
        content: 'ORACLE — Substrate active. Awaiting directive, NEXUS.',
        timestamp: new Date().toISOString()
    }]);
    const [input, setInput]           = useState('');
    const [activeTab, setActiveTab]   = useState<TabId>('context');
    const [reasoning, setReasoning]   = useState<ReasoningLevel>('medium');
    const [terminalOpen, setTerminalOpen] = useState(false);
    const [dragOver, setDragOver]     = useState(false);
    const [pendingFiles, setPendingFiles] = useState<UploadedFile[]>([]);
    const [isListening, setIsListening] = useState(false);
    const [voiceEnabled, setVoiceEnabled] = useState(false);
    const [imageModels, setImageModels] = useState<{ kie: ImageModel[]; remote: ImageModel[] }>({ kie: [], remote: [] });
    const [oracleState, setOracleState] = useState<OracleCommandState | null>(null);
    const [models, setModels]          = useState<any[]>([]);
    const [selectedModel, setSelectedModel] = useState<string>('qwen-liberated:latest');

    const chatEndRef        = useRef<HTMLDivElement>(null);
    const fileInputRef      = useRef<HTMLInputElement>(null);
    const recognitionRef    = useRef<any>(null);
    const voiceEnabledRef   = useRef(false);
    const oracleVoiceRef    = useRef<SpeechSynthesisVoice | null>(null);
    const activeUtterRef    = useRef<SpeechSynthesisUtterance | null>(null);
    const sentenceBufferRef = useRef('');

    // Subscribe to oracle state
    useEffect(() => {
        return subscribeOracleCommandState(setOracleState);
    }, []);

    // Auto-scroll chat
    useEffect(() => {
        chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, [messages]);

    // Load models + image model catalog
    useEffect(() => {
        apiFetch('/api/neural/models').then(r => r.json()).then(d => { if (Array.isArray(d)) setModels(d); }).catch(() => {});
        apiFetch('/api/neural/images/models').then(r => r.json()).then(d => { if (d && Array.isArray(d.kie) && Array.isArray(d.remote)) setImageModels(d); }).catch(() => {});
    }, []);

    // Sync voiceEnabled → ref so callbacks don't capture stale state
    useEffect(() => { voiceEnabledRef.current = voiceEnabled; }, [voiceEnabled]);

    // Oracle voice selection — mirrors main.ts:initVoice
    useEffect(() => {
        const pick = () => {
            const voices = window.speechSynthesis?.getVoices() ?? [];
            oracleVoiceRef.current =
                voices.find(v => v.name.includes('Samantha') || v.name.includes('Victoria') ||
                                 v.name.includes('Google UK English Female') || v.name.includes('Premium')) ??
                voices.find(v => v.name.includes('Female') && v.lang.startsWith('en')) ??
                voices.find(v => v.lang.startsWith('en')) ??
                null;
            if (oracleVoiceRef.current) console.log('⬡ Oracle voice engaged ::', oracleVoiceRef.current.name);
        };
        pick();
        window.speechSynthesis?.addEventListener('voiceschanged', pick);
        return () => window.speechSynthesis?.removeEventListener('voiceschanged', pick);
    }, []);

    const speakText = useCallback((text: string) => {
        if (!voiceEnabledRef.current || !window.speechSynthesis) return;
        const cleaned = text.replace(/[*_`#>]/g, '').trim();
        if (!cleaned) return;
        const utter = new SpeechSynthesisUtterance(cleaned);
        if (oracleVoiceRef.current) utter.voice = oracleVoiceRef.current;
        utter.rate = 0.85;
        utter.pitch = 1.0;
        utter.volume = 1.0;
        activeUtterRef.current = utter;
        utter.onend = () => { activeUtterRef.current = null; };
        // Enqueue — do NOT cancel; sentences queue naturally via Web Speech API
        window.speechSynthesis.speak(utter);
    }, []);

    const flushSentences = useCallback((token: string, flush = false) => {
        if (!voiceEnabledRef.current) return;
        sentenceBufferRef.current += token;
        const re = /[^.!?\n]+[.!?]\s+|[^.!?\n]+\n/g;
        let match: RegExpExecArray | null;
        let lastIdx = 0;
        while ((match = re.exec(sentenceBufferRef.current)) !== null) {
            speakText(match[0]);
            lastIdx = match.index + match[0].length;
        }
        sentenceBufferRef.current = sentenceBufferRef.current.slice(lastIdx);
        if (flush && sentenceBufferRef.current.trim()) {
            speakText(sentenceBufferRef.current);
            sentenceBufferRef.current = '';
        }
    }, [speakText]);

    const addMessage = useCallback((msg: ChatMessage) => {
        setMessages(prev => [...prev, msg]);
    }, []);

    const updateLastNexus = useCallback((patch: Partial<ChatMessage>) => {
        setMessages(prev => {
            const idx = [...prev].reverse().findIndex(m => m.role === 'nexus');
            if (idx === -1) return prev;
            const realIdx = prev.length - 1 - idx;
            return prev.map((m, i) => i === realIdx ? { ...m, ...patch } : m);
        });
    }, []);

    const handleSubmit = useCallback(async (cmdOverride?: string) => {
        const cmd = (cmdOverride !== undefined ? cmdOverride : input).trim();
        if (!cmd && pendingFiles.length === 0) return;
        if (cmdOverride === undefined) setInput('');
        window.speechSynthesis?.cancel();
        sentenceBufferRef.current = '';
        // pre-flight neural pulse on new directive
        if (voiceEnabledRef.current) {
            try {
                const ac = new AudioContext();
                const osc = ac.createOscillator();
                const gain = ac.createGain();
                osc.connect(gain); gain.connect(ac.destination);
                osc.frequency.value = 440;
                gain.gain.value = 0.04;
                osc.start(); osc.stop(ac.currentTime + 0.05);
            } catch (_) {}
        }

        const userMsg: ChatMessage = {
            id: `u-${Date.now()}`,
            role: 'user',
            content: cmd || '[file upload]',
            timestamp: new Date().toISOString(),
            files: pendingFiles.length > 0 ? [...pendingFiles] : undefined
        };
        addMessage(userMsg);
        setPendingFiles([]);

        const nexusId = `n-${Date.now()}`;
        addMessage({ id: nexusId, role: 'nexus', content: '', streaming: true, timestamp: new Date().toISOString() });

        const useCouncil = reasoning === 'council';

        if (!useCouncil) {
            // Streaming path — near-realtime
            try {
                await submitOracleCommandStream({
                    command: cmd || 'describe uploaded files',
                    source: 'typed',
                    modelId: selectedModel,
                    onChunk: (chunk) => {
                        if (chunk.type === 'token') {
                            setMessages(prev => prev.map(m =>
                                m.id === nexusId
                                    ? { ...m, content: m.content + (chunk.token || ''), streaming: true }
                                    : m
                            ));
                            flushSentences(chunk.token || '');
                        } else if (chunk.type === 'done') {
                            setMessages(prev => prev.map(m =>
                                m.id === nexusId
                                    ? { ...m, content: chunk.content || m.content, streaming: false }
                                    : m
                            ));
                            flushSentences('', true);
                        } else if (chunk.type === 'error') {
                            setMessages(prev => prev.map(m =>
                                m.id === nexusId
                                    ? { ...m, content: `[Oracle error: ${chunk.error}]`, streaming: false }
                                    : m
                            ));
                            window.speechSynthesis?.cancel();
                        }
                    }
                });
            } catch (err: any) {
                updateLastNexus({ content: `[Stream failed: ${err.message}]`, streaming: false });
            }
        } else {
            // Council mode — blocking with phase display
            try {
                const result = await submitOracleCommand({
                    command: cmd,
                    source: 'typed',
                    useCouncil: true
                });
                const content = result?.response || result?.content || JSON.stringify(result);
                updateLastNexus({ content: String(content), streaming: false });
            } catch (err: any) {
                updateLastNexus({ content: `[Council error: ${err.message}]`, streaming: false });
            }
        }
    }, [input, pendingFiles, reasoning, selectedModel, addMessage, updateLastNexus, flushSentences]);

    const handleKeyDown = useCallback((e: React.KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSubmit(); }
    }, [handleSubmit]);

    const handleFileDrop = useCallback((files: FileList | null) => {
        if (!files) return;
        const allowed = ['application/pdf', 'image/png', 'image/jpeg', 'image/gif', 'image/webp',
            'text/markdown', 'text/plain', 'application/x-python', 'text/x-python'];
        Array.from(files).forEach(file => {
            if (!allowed.some(t => file.type === t || file.name.endsWith('.md') || file.name.endsWith('.py') || file.name.endsWith('.ts'))) return;
            const reader = new FileReader();
            reader.onload = () => {
                setPendingFiles(prev => [...prev, {
                    name: file.name,
                    type: file.type,
                    dataUrl: reader.result as string,
                    size: file.size
                }]);
            };
            reader.readAsDataURL(file);
        });
    }, []);

    const toggleVoice = useCallback(() => {
        const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
        if (!SR) return;
        if (isListening) {
            recognitionRef.current?.stop();
            setIsListening(false);
            (window as any).__resumeWakeWord?.();
            return;
        }
        window.speechSynthesis?.cancel();
        const rec = new SR();
        rec.lang = 'en-US';
        rec.continuous = false;
        rec.interimResults = false;
        rec.onresult = (e: any) => {
            const text: string = e.results[0]?.[0]?.transcript || '';
            setIsListening(false);
            if (text.trim()) handleSubmit(text.trim());
        };
        rec.onerror = () => { setIsListening(false); (window as any).__resumeWakeWord?.(); };
        rec.onend   = () => { setIsListening(false); (window as any).__resumeWakeWord?.(); };
        rec.start();
        recognitionRef.current = rec as any;
        setIsListening(true);
    }, [isListening, handleSubmit]);

    const cycleReasoning = useCallback(() => {
        setReasoning(prev => {
            const idx = REASONING_LEVELS.indexOf(prev);
            return REASONING_LEVELS[(idx + 1) % REASONING_LEVELS.length];
        });
    }, []);

    const isBusy = ['submitted', 'deliberating', 'stale'].includes(oracleState?.phase ?? '');

    return (
        <div className="oracle-page" onDragOver={e => { e.preventDefault(); setDragOver(true); }}
            onDragLeave={() => setDragOver(false)}
            onDrop={e => { e.preventDefault(); setDragOver(false); handleFileDrop(e.dataTransfer.files); }}
        >
            {/* Drop overlay */}
            <AnimatePresence>
                {dragOver && (
                    <motion.div className="oracle-drop-overlay"
                        initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                        <span>Drop files into NEXUS</span>
                    </motion.div>
                )}
            </AnimatePresence>

            {/* Main layout */}
            <div className="oracle-layout">

                {/* LEFT — Category tabs */}
                <div className="oracle-tabs">
                    {TABS.map(tab => (
                        <button key={tab.id} className={`oracle-tab ${activeTab === tab.id ? 'active' : ''}`}
                            onClick={() => setActiveTab(tab.id)}>
                            <span className="tab-icon">{tab.icon}</span>
                            <span className="tab-label">{tab.label}</span>
                            {tab.id === 'visual' && (imageModels.kie.length > 0 || imageModels.remote.length > 0) && (
                                <span className="tab-ready-dot" title="Image models loaded"/>
                            )}
                        </button>
                    ))}
                    <div className="oracle-tab-spacer"/>
                    <button className="oracle-tab terminal-toggle" onClick={() => setTerminalOpen(p => !p)}>
                        <span className="tab-icon">_</span>
                        <span className="tab-label">Terminal</span>
                    </button>
                </div>

                {/* CENTER — Chat + orbs */}
                <div className="oracle-center">

                    {/* Tool orbs or tab content */}
                    <div className="oracle-content-area">
                        {activeTab === 'visual' ? (
                            <VisualSynthesisLane models={imageModels} />
                        ) : activeTab === 'notebook' ? (
                            <NotebookTab />
                        ) : (
                            <OracleToolOrbs activeTab={activeTab as Exclude<TabId, 'notebook' | 'visual'>} />
                        )}
                    </div>

                    {/* Chat thread */}
                    <div className="oracle-chat">
                        <div className="oracle-messages">
                            {messages.map(msg => (
                                <motion.div key={msg.id} className={`oracle-msg oracle-msg--${msg.role}`}
                                    initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }}
                                    transition={{ duration: 0.2 }}>
                                    <span className="msg-label">
                                        {msg.role === 'user' ? 'NEXUS' : 'ORACLE'}
                                    </span>
                                    <div className="msg-body">
                                        {msg.content}
                                        {msg.streaming && <span className="cursor-blink">▋</span>}
                                    </div>
                                    {msg.files && msg.files.length > 0 && (
                                        <div className="msg-files">
                                            {msg.files.map((f, i) => (
                                                <span key={i} className="msg-file-pill">{f.name}</span>
                                            ))}
                                        </div>
                                    )}
                                </motion.div>
                            ))}
                            {isBusy && (
                                <div className="oracle-phase-indicator">
                                    <span className="phase-dot"/>
                                    {oracleState?.phase} · {oracleState?.elapsedMs ? Math.floor(oracleState.elapsedMs / 1000) + 's' : '...'}
                                </div>
                            )}
                            <div ref={chatEndRef}/>
                        </div>

                        {/* Pending file pills */}
                        {pendingFiles.length > 0 && (
                            <div className="oracle-pending-files">
                                {pendingFiles.map((f, i) => (
                                    <span key={i} className="pending-file-pill">
                                        {f.name}
                                        <button onClick={() => setPendingFiles(p => p.filter((_, j) => j !== i))}>×</button>
                                    </span>
                                ))}
                            </div>
                        )}

                        {/* Input bar */}
                        <div className="oracle-input-bar">
                            {/* Plus — file picker */}
                            <button className="input-action input-plus" onClick={() => fileInputRef.current?.click()} title="Attach file">
                                +
                            </button>
                            <input ref={fileInputRef} type="file" multiple hidden
                                accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.md,.py,.ts,.txt"
                                onChange={e => handleFileDrop(e.target.files)}/>

                            <textarea
                                className="oracle-textarea"
                                value={input}
                                onChange={e => setInput(e.target.value)}
                                onKeyDown={handleKeyDown}
                                placeholder="Ask NEXUS..."
                                rows={1}
                            />

                            {/* Model selector */}
                            <select className="oracle-model-select" value={selectedModel}
                                onChange={e => setSelectedModel(e.target.value)}>
                                {models.length > 0
                                    ? models.map((m: any) => <option key={m.id} value={m.id}>{m.name || m.id}</option>)
                                    : <option value="qwen-liberated:latest">Qwen Local</option>}
                            </select>

                            {/* Reasoning level */}
                            <button className="input-action reasoning-level"
                                style={{ color: REASONING_COLORS[reasoning] }}
                                onClick={cycleReasoning}
                                title={`Reasoning: ${reasoning}`}>
                                {reasoning.slice(0, 3).toUpperCase()}
                            </button>

                            {/* Mic */}
                            <button id="oracle-mic-toggle" className={`input-action input-mic ${isListening ? 'active' : ''}`}
                                onClick={toggleVoice} title="Voice input">
                                {isListening ? '◉' : '🎤'}
                            </button>

                            {/* Voice output toggle */}
                            <button
                                className={`input-action input-voice-out ${voiceEnabled ? 'active' : ''}`}
                                onClick={() => {
                                    const v = !voiceEnabled;
                                    voiceEnabledRef.current = v;
                                    setVoiceEnabled(v);
                                    if (!v) window.speechSynthesis?.cancel();
                                }}
                                title={voiceEnabled ? 'Voice output: ON' : 'Voice output: OFF'}>
                                {voiceEnabled ? '◈' : '◇'}
                            </button>

                            {/* Send */}
                            <button className="input-action input-send" onClick={() => handleSubmit()} disabled={isBusy}>
                                {isBusy ? '⟳' : '↑'}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {/* Terminal pane (collapsible) */}
            <AnimatePresence>
                {terminalOpen && (
                    <motion.div className="oracle-terminal-pane"
                        initial={{ height: 0 }} animate={{ height: 320 }} exit={{ height: 0 }}
                        transition={{ duration: 0.25 }}>
                        <OracleTerminal />
                    </motion.div>
                )}
            </AnimatePresence>

            <style>{ORACLE_STYLES}</style>
        </div>
    );
}

