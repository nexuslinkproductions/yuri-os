}
.oracle-textarea:focus { border-color: rgba(159,232,115,0.4); }
.oracle-textarea::placeholder { color: var(--text-dim); opacity: 0.5; }

.oracle-model-select {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(159,232,115,0.12);
  color: var(--text-dim);
  font-family: inherit;
  font-size: 10px;
  padding: 4px 6px;
  outline: none;
  max-width: 120px;
  cursor: pointer;
}

.input-action {
  background: none;
  border: 1px solid rgba(159,232,115,0.15);
  color: var(--text-dim);
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 2px;
  transition: all 0.15s;
  flex-shrink: 0;
}
.input-action:hover { border-color: var(--cyan-glow); color: var(--cyan-glow); }
.input-plus  { font-size: 18px; color: var(--text-dim); }
.input-send  { color: var(--cyan-glow); border-color: rgba(159,232,115,0.3); }
.input-send:hover  { background: rgba(159,232,115,0.1); }
.input-send:disabled { opacity: 0.4; cursor: not-allowed; }
.input-mic   { color: var(--text-dim); }
.input-mic.active { color: var(--red-fusion); border-color: var(--red-fusion); animation: micPulse 1s ease-in-out infinite; }
@keyframes micPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(217,112,72,0.4); } 50% { box-shadow: 0 0 0 6px rgba(217,112,72,0); } }
.input-voice-out { color: var(--text-dim); font-size: 13px; }
.input-voice-out.active { color: var(--gold-solar); border-color: var(--gold-solar); box-shadow: 0 0 6px rgba(255,193,7,0.3); }

.reasoning-level {
  font-size: 9px;
  letter-spacing: 0.1em;
  font-weight: bold;
  width: 40px;
}

/* TERMINAL PANE */
.oracle-terminal-pane {
  border-top: 1px solid rgba(159,232,115,0.2);
  overflow: hidden;
  background: #0a0a0a;
}
`;
