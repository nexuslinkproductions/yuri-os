import React, { useEffect, useRef } from 'react';

interface TopicNode { id: string; label: string; weight: number; }
interface TopicEdge { source: string; target: string; weight: number; }

interface NodeSim extends TopicNode {
    x: number; y: number;
    vx: number; vy: number;
}

export function NetworkGraph({ nodes, edges }: { nodes: TopicNode[]; edges: TopicEdge[] }) {
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const rafRef = useRef<number>(0);

    useEffect(() => {
        const canvas = canvasRef.current;
        if (!canvas || !nodes.length) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const dpr = window.devicePixelRatio || 1;
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.scale(dpr, dpr);

        // Initialize positions randomly
        const sims: NodeSim[] = nodes.map(n => ({
            ...n,
            x: w * 0.1 + Math.random() * w * 0.8,
            y: h * 0.1 + Math.random() * h * 0.8,
            vx: 0, vy: 0
        }));

        const idMap = new Map(sims.map(n => [n.id, n]));
        let frame = 0;

        function tick() {
            // Repulsion between nodes
            for (let i = 0; i < sims.length; i++) {
                for (let j = i + 1; j < sims.length; j++) {
                    const dx = sims[j].x - sims[i].x;
                    const dy = sims[j].y - sims[i].y;
                    const dist = Math.sqrt(dx * dx + dy * dy) || 1;
                    const force = 2000 / (dist * dist);
                    sims[i].vx -= (dx / dist) * force;
                    sims[i].vy -= (dy / dist) * force;
                    sims[j].vx += (dx / dist) * force;
                    sims[j].vy += (dy / dist) * force;
                }
            }

            // Attraction along edges
            for (const edge of edges) {
                const src = idMap.get(edge.source);
                const tgt = idMap.get(edge.target);
                if (!src || !tgt) continue;
                const dx = tgt.x - src.x;
                const dy = tgt.y - src.y;
                const dist = Math.sqrt(dx * dx + dy * dy) || 1;
                const target = 120;
                const force = (dist - target) * 0.02 * (edge.weight || 0.5);
                src.vx += (dx / dist) * force;
                src.vy += (dy / dist) * force;
                tgt.vx -= (dx / dist) * force;
                tgt.vy -= (dy / dist) * force;
            }

            // Center gravity
            const cx = w / 2, cy = h / 2;
            for (const n of sims) {
                n.vx += (cx - n.x) * 0.003;
                n.vy += (cy - n.y) * 0.003;
                n.vx *= 0.85;
                n.vy *= 0.85;
                n.x += n.vx;
                n.y += n.vy;
                n.x = Math.max(30, Math.min(w - 30, n.x));
                n.y = Math.max(20, Math.min(h - 20, n.y));
            }
        }

        function draw() {
            ctx.clearRect(0, 0, w, h);

            // Edges
            for (const edge of edges) {
                const src = idMap.get(edge.source);
                const tgt = idMap.get(edge.target);
                if (!src || !tgt) continue;
                ctx.beginPath();
                ctx.moveTo(src.x, src.y);
                ctx.lineTo(tgt.x, tgt.y);
                ctx.strokeStyle = `rgba(0,229,255,${(edge.weight || 0.5) * 0.4})`;
                ctx.lineWidth = 1;
                ctx.stroke();
            }

            // Nodes
            for (const n of sims) {
                const r = 6 + (n.weight || 0.5) * 12;
                ctx.beginPath();
                ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(0,229,255,0.15)';
                ctx.fill();
                ctx.strokeStyle = '#00e5ff';
                ctx.lineWidth = 1.5;
                ctx.stroke();

                ctx.fillStyle = '#e8e8f0';
                ctx.font = '10px JetBrains Mono, monospace';
                ctx.textAlign = 'center';
                ctx.fillText(n.label.slice(0, 16), n.x, n.y + r + 12);
            }
        }

        function loop() {
            if (frame < 200) tick();
            draw();
            frame++;
            if (frame < 400) rafRef.current = requestAnimationFrame(loop);
        }

        rafRef.current = requestAnimationFrame(loop);
        return () => cancelAnimationFrame(rafRef.current);
    }, [nodes, edges]);

    return (
        <canvas
            ref={canvasRef}
            style={{ width: '100%', height: '100%', display: 'block' }}
        />
    );
}
