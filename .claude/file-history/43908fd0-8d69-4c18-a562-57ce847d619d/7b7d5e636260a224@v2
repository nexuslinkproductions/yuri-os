import React, { useCallback, useEffect, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { apiFetch, apiUrl } from '../../../lib/runtime';

// ── Types ──────────────────────────────────────────────────────────────────────

interface Notebook {
    id: number;
    title: string;
    description: string | null;
    model_id: string;
    created_at: string;
}

interface Source {
    id: number;
    notebook_id: number;
    title: string;
    source_type: string;
    status: 'pending' | 'processing' | 'ready' | 'error';
    error_msg: string | null;
    word_count: number;
    created_at: string;
}

interface Doc {
    id: number;
    notebook_id: number;
    doc_type: string;
    title: string;
    content: string;
    pdf_path: string | null;
    obsidian_path: string | null;
    created_at: string;
}

interface Message {
    id: number;
    role: 'user' | 'assistant';
    content: string;
    created_at: string;
}

interface EntityFreq { entity: string; count: number; type: string; }
interface TemporalPoint { date: string; eventTitle: string; count: number; }
interface TopicNode { id: string; label: string; weight: number; }
interface TopicEdge { source: string; target: string; weight: number; }
interface SentimentResult { positive: number; neutral: number; negative: number; compound: number; }

type SubTab = 'sources' | 'chat' | 'docs' | 'viz';
type DocType = 'summary' | 'study_guide' | 'faq' | 'timeline' | 'briefing';
type VizType = 'entities' | 'temporal' | 'topics' | 'sentiment';

const DOC_LABELS: Record<DocType, string> = {
    summary: 'Summary',
    study_guide: 'Study Guide',
    faq: 'FAQ',
    timeline: 'Timeline',
    briefing: 'Briefing',
};

const VIZ_LABELS: Record<VizType, string> = {
    entities: 'Entities',
    temporal: 'Timeline',
    topics: 'Topics',
    sentiment: 'Sentiment',
};

// ── Component ──────────────────────────────────────────────────────────────────

export default function NotebookTab() {
    const [notebooks, setNotebooks]               = useState<Notebook[]>([]);
    const [activeId, setActiveId]                 = useState<number | null>(null);
    const [sources, setSources]                   = useState<Source[]>([]);
    const [docs, setDocs]                         = useState<Doc[]>([]);
    const [messages, setMessages]                 = useState<Message[]>([]);
    const [subTab, setSubTab]                     = useState<SubTab>('sources');
    const [chatInput, setChatInput]               = useState('');
    const [streaming, setStreaming]               = useState('');
    const [isStreaming, setIsStreaming]           = useState(false);
    const [genDocType, setGenDocType]             = useState<DocType>('summary');
    const [isGenerating, setIsGenerating]         = useState(false);
    const [genStream, setGenStream]               = useState('');
    const [selectedModel]                         = useState('qwen-liberated:latest');
    const [urlInput, setUrlInput]                 = useState('');
    const [obsidianInput, setObsidianInput]       = useState('');
    const [showNewForm, setShowNewForm]           = useState(false);
    const [newTitle, setNewTitle]                 = useState('');
    const [activeViz, setActiveViz]               = useState<VizType>('entities');
    const [vizData, setVizData]                   = useState<any>(null);
    const [vizLoading, setVizLoading]             = useState(false);
    const [activeDoc, setActiveDoc]               = useState<Doc | null>(null);
    const [uploadBusy, setUploadBusy]             = useState(false);
    const [statusMsg, setStatusMsg]               = useState('');

    const chatEndRef  = useRef<HTMLDivElement>(null);
    const fileRef     = useRef<HTMLInputElement>(null);
    const streamAbort = useRef<AbortController | null>(null);

    // ── Data loaders ─────────────────────────────────────────────────────────

    const loadNotebooks = useCallback(async () => {
        try {
            const r = await apiFetch('/api/notebook/notebooks');
            const data = await r.json();
            if (Array.isArray(data)) setNotebooks(data);
        } catch { /* offline */ }
    }, []);

    const loadSources = useCallback(async (id: number) => {
        try {
            const r = await apiFetch(`/api/notebook/notebooks/${id}`);
            const data = await r.json();
            if (Array.isArray(data.sources)) setSources(data.sources);
        } catch { /* offline */ }
    }, []);

    const loadDocs = useCallback(async (id: number) => {
        try {
            const r = await apiFetch(`/api/notebook/notebooks/${id}`);
            const data = await r.json();
            if (Array.isArray(data.docs)) setDocs(data.docs);
        } catch { /* offline */ }
    }, []);

    const loadMessages = useCallback(async (id: number) => {
        try {
            const r = await apiFetch(`/api/notebook/notebooks/${id}/messages`);
            const data = await r.json();
            if (Array.isArray(data)) setMessages(data);
        } catch { /* offline */ }
    }, []);

    const loadAll = useCallback(async (id: number) => {
        try {
            const r = await apiFetch(`/api/notebook/notebooks/${id}`);
            const data = await r.json();
            if (Array.isArray(data.sources)) setSources(data.sources);
            if (Array.isArray(data.docs)) setDocs(data.docs);
        } catch { /* offline */ }
        await loadMessages(id);
    }, [loadMessages]);

    useEffect(() => { loadNotebooks(); }, [loadNotebooks]);

    useEffect(() => {
        if (activeId != null) {
            loadAll(activeId);
            setActiveDoc(null);
            setGenStream('');
            setStreaming('');
        }
    }, [activeId, loadAll]);

    useEffect(() => {
        chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, [messages, streaming]);

    // ── Notebook CRUD ─────────────────────────────────────────────────────────

    const createNotebook = useCallback(async () => {
        const title = newTitle.trim() || 'Untitled Notebook';
        try {
            const r = await apiFetch('/api/notebook/notebooks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title }),
            });
            const nb = await r.json();
            if (nb?.id) {
                setNotebooks(prev => [nb, ...prev]);
                setActiveId(nb.id);
                setShowNewForm(false);
                setNewTitle('');
            }
        } catch { setStatusMsg('Failed to create notebook'); }
    }, [newTitle]);

    // ── Source ingest ─────────────────────────────────────────────────────────

    const uploadFiles = useCallback(async (files: FileList | null) => {
        if (!files || !activeId) return;
        setUploadBusy(true);
        setStatusMsg('Ingesting files...');
        const form = new FormData();
        Array.from(files).forEach(f => form.append('files', f));
        try {
            await apiFetch(`/api/notebook/notebooks/${activeId}/sources/upload`, {
                method: 'POST',
                body: form,
            });
            setStatusMsg('Files ingested');
            await loadSources(activeId);
        } catch { setStatusMsg('Upload failed'); }
        setUploadBusy(false);
    }, [activeId, loadSources]);

    const ingestUrl = useCallback(async () => {
        const url = urlInput.trim();
        if (!url || !activeId) return;
        setStatusMsg('Ingesting URL...');
        try {
            await apiFetch(`/api/notebook/notebooks/${activeId}/sources/url`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url }),
            });
            setUrlInput('');
            setStatusMsg('URL ingested');
            await loadSources(activeId);
        } catch { setStatusMsg('URL ingest failed'); }
    }, [activeId, urlInput, loadSources]);

    const ingestObsidian = useCallback(async () => {
        const path = obsidianInput.trim();
        if (!path || !activeId) return;
        setStatusMsg('Ingesting vault note...');
        try {
            await apiFetch(`/api/notebook/notebooks/${activeId}/sources/obsidian`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vault_path: path }),
            });
            setObsidianInput('');
            setStatusMsg('Note ingested');
            await loadSources(activeId);
        } catch { setStatusMsg('Vault ingest failed'); }
    }, [activeId, obsidianInput, loadSources]);

    const deleteSource = useCallback(async (sourceId: number) => {
        try {
            await apiFetch(`/api/notebook/sources/${sourceId}`, { method: 'DELETE' });
            setSources(prev => prev.filter(s => s.id !== sourceId));
        } catch { setStatusMsg('Delete failed'); }
    }, []);

    // ── RAG chat (SSE via EventSource) ───────────────────────────────────────

    const sendChat = useCallback(() => {
        const query = chatInput.trim();
        if (!query || !activeId || isStreaming) return;
        setChatInput('');
        setStreaming('');
        setIsStreaming(true);
        setMessages(prev => [...prev, { id: Date.now(), role: 'user', content: query, created_at: new Date().toISOString() }]);

        const url = apiUrl(`/api/notebook/notebooks/${activeId}/stream?command=${encodeURIComponent(query)}&model=${encodeURIComponent(selectedModel)}`);
        const es = new EventSource(url);
        let full = '';

        es.addEventListener('token', (e: MessageEvent) => {
            try { const d = JSON.parse(e.data); if (d.token) { full += d.token; setStreaming(full); } } catch { /* skip */ }
        });

        es.addEventListener('done', (e: MessageEvent) => {
            try { const d = JSON.parse(e.data); if (d.content) full = d.content; } catch { /* skip */ }
            setMessages(prev => [...prev, { id: Date.now() + 1, role: 'assistant', content: full, created_at: new Date().toISOString() }]);
            setStreaming('');
            setIsStreaming(false);
            es.close();
        });

        es.addEventListener('error', () => {
            if (full) {
                setMessages(prev => [...prev, { id: Date.now() + 1, role: 'assistant', content: full, created_at: new Date().toISOString() }]);
            }
            setStreaming('');
            setIsStreaming(false);
            es.close();
        });

        streamAbort.current = { abort: () => es.close() } as any;
    }, [chatInput, activeId, isStreaming, selectedModel]);

    // ── Doc generation (SSE via POST+fetch stream) ────────────────────────────

    const generateDoc = useCallback(async () => {
        if (!activeId || isGenerating) return;
        setIsGenerating(true);
        setGenStream('');
        setActiveDoc(null);

        try {
            const res = await apiFetch(`/api/notebook/notebooks/${activeId}/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ doc_type: genDocType, model_id: selectedModel }),
            });
            if (!res.body) throw new Error('no body');

            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let buf = '';
            let full = '';
            let lastEvent = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                buf += decoder.decode(value, { stream: true });
                const lines = buf.split('\n');
                buf = lines.pop() || '';
                for (const line of lines) {
                    if (line.startsWith('event:')) {
                        lastEvent = line.slice(6).trim();
                    } else if (line.startsWith('data:')) {
                        try {
                            const payload = JSON.parse(line.slice(5).trim());
                            if (lastEvent === 'token' && payload.token) {
                                full += payload.token;
                                setGenStream(full);
                            }
                            if (lastEvent === 'done' && payload.docId) {
                                await loadDocs(activeId);
                                setIsGenerating(false);
                            }
                            if (lastEvent === 'error') {
                                setStatusMsg('Gen error: ' + (payload.message || 'unknown'));
                                setIsGenerating(false);
                            }
                        } catch { /* skip */ }
                    }
                }
            }
            if (isGenerating) await loadDocs(activeId);
        } catch (e: any) {
            setStatusMsg('Doc gen failed: ' + e.message);
        }
        setIsGenerating(false);
    }, [activeId, genDocType, isGenerating, selectedModel, loadDocs]);

    const downloadPdf = useCallback(async (docId: number) => {
        const url = apiUrl(`/api/notebook/docs/${docId}/pdf`);
        window.open(url, '_blank');
    }, []);

    const syncObsidian = useCallback(async (docId: number) => {
        try {
            const r = await apiFetch(`/api/notebook/docs/${docId}/obsidian-sync`, { method: 'POST' });
            const data = await r.json();
            setStatusMsg(`Synced → ${data.obsidian_path || 'vault'}`);
        } catch { setStatusMsg('Obsidian sync failed'); }
    }, []);

    const deleteDoc = useCallback(async (docId: number) => {
        try {
            await apiFetch(`/api/notebook/docs/${docId}`, { method: 'DELETE' });
            setDocs(prev => prev.filter(d => d.id !== docId));
            if (activeDoc?.id === docId) setActiveDoc(null);
        } catch { setStatusMsg('Delete failed'); }
    }, [activeDoc]);

    // ── Visualizations ────────────────────────────────────────────────────────

    const loadViz = useCallback(async (type: VizType) => {
        if (!activeId) return;
        setVizLoading(true);
        setVizData(null);
        try {
            const r = await apiFetch(`/api/notebook/notebooks/${activeId}/viz/${type}`);
            const data = await r.json();
            setVizData(data);
        } catch { setStatusMsg('Viz failed'); }
        setVizLoading(false);
    }, [activeId]);

    useEffect(() => {
        if (subTab === 'viz' && activeId != null) loadViz(activeViz);
    }, [subTab, activeViz, activeId, loadViz]);

    // ── Render helpers ────────────────────────────────────────────────────────

    const activeNotebook = notebooks.find(n => n.id === activeId) ?? null;

    return (
        <div style={S.root}>
            {/* Notebook list sidebar */}
            <div style={S.sidebar}>
                <div style={S.sidebarHeader}>
                    <span style={S.sidebarTitle}>NOTEBOOKS</span>
                    <button style={S.iconBtn} onClick={() => setShowNewForm(p => !p)} title="New notebook">+</button>
                </div>

                <AnimatePresence>
                    {showNewForm && (
                        <motion.div initial={{ height: 0, opacity: 0 }} animate={{ height: 'auto', opacity: 1 }} exit={{ height: 0, opacity: 0 }} style={{ overflow: 'hidden' }}>
                            <div style={S.newForm}>
                                <input
                                    style={S.input}
                                    value={newTitle}
                                    onChange={e => setNewTitle(e.target.value)}
                                    onKeyDown={e => e.key === 'Enter' && createNotebook()}
                                    placeholder="Notebook title..."
                                    autoFocus
                                />
                                <button style={S.smallBtn} onClick={createNotebook}>Create</button>
                            </div>
                        </motion.div>
                    )}
                </AnimatePresence>

                <div style={S.notebookList}>
                    {notebooks.length === 0 && (
                        <div style={S.emptyHint}>No notebooks yet</div>
                    )}
                    {notebooks.map(nb => (
                        <button
                            key={nb.id}
                            style={{ ...S.notebookItem, ...(nb.id === activeId ? S.notebookItemActive : {}) }}
                            onClick={() => setActiveId(nb.id)}
                        >
                            <span style={S.notebookIcon}>◧</span>
                            <span style={S.notebookTitle}>{nb.title}</span>
                        </button>
                    ))}
                </div>

                {statusMsg && (
                    <div style={S.statusMsg} onClick={() => setStatusMsg('')}>{statusMsg}</div>
                )}
            </div>

            {/* Main area */}
            <div style={S.main}>
                {!activeNotebook ? (
                    <div style={S.emptyState}>
                        <span style={S.emptyIcon}>◧</span>
                        <span style={S.emptyText}>Select or create a notebook</span>
                    </div>
                ) : (
                    <>
                        {/* Sub-tabs */}
                        <div style={S.subTabs}>
                            {(['sources', 'chat', 'docs', 'viz'] as SubTab[]).map(tab => (
                                <button
                                    key={tab}
                                    style={{ ...S.subTab, ...(subTab === tab ? S.subTabActive : {}) }}
                                    onClick={() => setSubTab(tab)}
                                >
                                    {tab.toUpperCase()}
                                </button>
                            ))}
                            <span style={S.notebookBadge}>{activeNotebook.title}</span>
                        </div>

                        {/* Tab content */}
                        <div style={S.content}>
                            {subTab === 'sources' && (
                                <SourcesPanel
                                    sources={sources}
                                    uploadBusy={uploadBusy}
                                    urlInput={urlInput}
                                    obsidianInput={obsidianInput}
                                    fileRef={fileRef}
                                    onUpload={uploadFiles}
                                    onUrlChange={setUrlInput}
                                    onUrlSubmit={ingestUrl}
                                    onObsidianChange={setObsidianInput}
                                    onObsidianSubmit={ingestObsidian}
                                    onDeleteSource={deleteSource}
                                />
                            )}

                            {subTab === 'chat' && (
                                <ChatPanel
                                    messages={messages}
                                    streaming={streaming}
                                    isStreaming={isStreaming}
                                    chatInput={chatInput}
                                    chatEndRef={chatEndRef}
                                    onInputChange={setChatInput}
                                    onSend={sendChat}
                                />
                            )}

                            {subTab === 'docs' && (
                                <DocsPanel
                                    docs={docs}
                                    activeDoc={activeDoc}
                                    genDocType={genDocType}
                                    isGenerating={isGenerating}
                                    genStream={genStream}
                                    onDocTypeChange={setGenDocType}
                                    onGenerate={generateDoc}
                                    onSelectDoc={setActiveDoc}
                                    onDownloadPdf={downloadPdf}
                                    onSyncObsidian={syncObsidian}
                                    onDeleteDoc={deleteDoc}
                                />
                            )}

                            {subTab === 'viz' && (
                                <VizPanel
                                    activeViz={activeViz}
                                    vizData={vizData}
                                    vizLoading={vizLoading}
                                    onVizChange={setActiveViz}
                                />
                            )}
                        </div>
                    </>
                )}
            </div>

            {/* Hidden file input */}
            <input
                ref={fileRef}
                type="file"
                multiple
                hidden
                accept=".pdf,.docx,.txt,.md,.mp3,.mp4,.m4a,.wav,.ogg,.webm"
                onChange={e => uploadFiles(e.target.files)}
            />
        </div>
    );
}

// ── Sub-panels ─────────────────────────────────────────────────────────────────

interface SourcesPanelProps {
    sources: Source[];
    uploadBusy: boolean;
    urlInput: string;
    obsidianInput: string;
    fileRef: React.RefObject<HTMLInputElement | null>;
    onUpload: (files: FileList | null) => void;
    onUrlChange: (v: string) => void;
    onUrlSubmit: () => void;
    onObsidianChange: (v: string) => void;
    onObsidianSubmit: () => void;
    onDeleteSource: (id: number) => void;
}

function SourcesPanel({ sources, uploadBusy, urlInput, obsidianInput, fileRef, onUpload, onUrlChange, onUrlSubmit, onObsidianChange, onObsidianSubmit, onDeleteSource }: SourcesPanelProps) {
    return (
        <div style={S.panel}>
            {/* Upload row */}
            <div style={S.ingestRow}>
                <button
                    style={{ ...S.smallBtn, ...(uploadBusy ? S.btnBusy : {}) }}
                    onClick={() => fileRef.current?.click()}
                    disabled={uploadBusy}
                >
                    {uploadBusy ? '⟳ Ingesting...' : '↑ Upload Files'}
                </button>
                <input
                    style={{ ...S.input, flex: 1 }}
                    value={urlInput}
                    onChange={e => onUrlChange(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && onUrlSubmit()}
                    placeholder="URL to ingest..."
                />
                <button style={S.smallBtn} onClick={onUrlSubmit} disabled={!urlInput.trim()}>URL</button>
            </div>
            <div style={S.ingestRow}>
                <input
                    style={{ ...S.input, flex: 1 }}
                    value={obsidianInput}
                    onChange={e => onObsidianChange(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && onObsidianSubmit()}
                    placeholder="Vault path (e.g. 06_KNOWLEDGE-BASE/note.md)"
                />
                <button style={S.smallBtn} onClick={onObsidianSubmit} disabled={!obsidianInput.trim()}>◎ Vault</button>
            </div>

            {/* Source list */}
            <div style={S.sourceList}>
                {sources.length === 0 && <div style={S.emptyHint}>No sources yet — upload files, paste a URL, or link a vault note.</div>}
                {sources.map(src => (
                    <div key={src.id} style={S.sourceRow}>
                        <span style={{ ...S.sourceStatus, color: src.status === 'ready' ? 'var(--cyan-glow)' : src.status === 'error' ? 'var(--red-fusion)' : 'var(--gold-solar)' }}>
                            {src.status === 'ready' ? '◈' : src.status === 'error' ? '✕' : '⟳'}
                        </span>
                        <span style={S.sourceTitle}>{src.title}</span>
                        <span style={S.sourceMeta}>{src.source_type} · {src.word_count}w</span>
                        <button style={S.deleteBtn} onClick={() => onDeleteSource(src.id)} title="Remove">×</button>
                    </div>
                ))}
            </div>
        </div>
    );
}

interface ChatPanelProps {
    messages: Message[];
    streaming: string;
    isStreaming: boolean;
    chatInput: string;
    chatEndRef: React.RefObject<HTMLDivElement | null>;
    onInputChange: (v: string) => void;
    onSend: () => void;
}

function ChatPanel({ messages, streaming, isStreaming, chatInput, chatEndRef, onInputChange, onSend }: ChatPanelProps) {
    return (
        <div style={S.panel}>
            <div style={S.chatMessages}>
                {messages.length === 0 && <div style={S.emptyHint}>Ask a question about your sources.</div>}
                {messages.map(msg => (
                    <div key={msg.id} style={{ ...S.chatMsg, ...(msg.role === 'user' ? S.chatMsgUser : S.chatMsgAssistant) }}>
                        <span style={S.chatRole}>{msg.role === 'user' ? 'YOU' : 'NEXUS'}</span>
                        <div style={S.chatBody}>{msg.content}</div>
                    </div>
                ))}
                {streaming && (
                    <div style={{ ...S.chatMsg, ...S.chatMsgAssistant }}>
                        <span style={S.chatRole}>NEXUS</span>
                        <div style={S.chatBody}>
                            {streaming}
                            <span style={{ color: 'var(--cyan-glow)', animation: 'blink 0.8s step-end infinite' }}>▋</span>
                        </div>
                    </div>
                )}
                <div ref={chatEndRef}/>
            </div>
            <div style={S.chatInputRow}>
                <input
                    style={{ ...S.input, flex: 1 }}
                    value={chatInput}
                    onChange={e => onInputChange(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && !e.shiftKey && onSend()}
                    placeholder="Ask about sources..."
                    disabled={isStreaming}
                />
                <button style={S.smallBtn} onClick={onSend} disabled={isStreaming || !chatInput.trim()}>
                    {isStreaming ? '⟳' : '↑'}
                </button>
            </div>
        </div>
    );
}

interface DocsPanelProps {
    docs: Doc[];
    activeDoc: Doc | null;
    genDocType: DocType;
    isGenerating: boolean;
    genStream: string;
    onDocTypeChange: (t: DocType) => void;
    onGenerate: () => void;
    onSelectDoc: (d: Doc) => void;
    onDownloadPdf: (id: number) => void;
    onSyncObsidian: (id: number) => void;
    onDeleteDoc: (id: number) => void;
}

function DocsPanel({ docs, activeDoc, genDocType, isGenerating, genStream, onDocTypeChange, onGenerate, onSelectDoc, onDownloadPdf, onSyncObsidian, onDeleteDoc }: DocsPanelProps) {
    return (
        <div style={S.panel}>
            {/* Generator controls */}
            <div style={S.genRow}>
                <select style={S.select} value={genDocType} onChange={e => onDocTypeChange(e.target.value as DocType)}>
                    {(Object.keys(DOC_LABELS) as DocType[]).map(t => (
                        <option key={t} value={t}>{DOC_LABELS[t]}</option>
                    ))}
                </select>
                <button style={{ ...S.smallBtn, ...(isGenerating ? S.btnBusy : {}) }} onClick={onGenerate} disabled={isGenerating}>
                    {isGenerating ? '⟳ Generating...' : '⬡ Generate'}
                </button>
            </div>

            {/* Streaming preview */}
            {(isGenerating && genStream) && (
                <div style={S.genPreview}>
                    {genStream}
                    <span style={{ color: 'var(--cyan-glow)' }}>▋</span>
                </div>
            )}

            {/* Doc list + viewer */}
            {!activeDoc ? (
                <div style={S.docList}>
                    {docs.length === 0 && <div style={S.emptyHint}>Generate a document from your sources.</div>}
                    {docs.map(doc => (
                        <div key={doc.id} style={S.docRow}>
                            <button style={S.docTitle} onClick={() => onSelectDoc(doc)}>
                                <span style={{ color: 'var(--gold-solar)', marginRight: 6 }}>▣</span>
                                {doc.title}
                                <span style={S.docType}>{DOC_LABELS[doc.doc_type as DocType] || doc.doc_type}</span>
                            </button>
                            <div style={S.docActions}>
                                <button style={S.iconBtn} onClick={() => onDownloadPdf(doc.id)} title="Download PDF">⬇</button>
                                <button style={S.iconBtn} onClick={() => onSyncObsidian(doc.id)} title="Sync to Obsidian">◎</button>
                                <button style={S.deleteBtn} onClick={() => onDeleteDoc(doc.id)} title="Delete">×</button>
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <div style={S.docViewer}>
                    <div style={S.docViewerHeader}>
                        <button style={S.iconBtn} onClick={() => onSelectDoc(null as any)}>← Back</button>
                        <span style={S.docViewerTitle}>{activeDoc.title}</span>
                        <button style={S.iconBtn} onClick={() => onDownloadPdf(activeDoc.id)} title="PDF">⬇</button>
                        <button style={S.iconBtn} onClick={() => onSyncObsidian(activeDoc.id)} title="Vault">◎</button>
                    </div>
                    <div style={S.docViewerBody}>{activeDoc.content}</div>
                </div>
            )}
        </div>
    );
}

interface VizPanelProps {
    activeViz: VizType;
    vizData: any;
    vizLoading: boolean;
    onVizChange: (t: VizType) => void;
}

function VizPanel({ activeViz, vizData, vizLoading, onVizChange }: VizPanelProps) {
    return (
        <div style={S.panel}>
            <div style={S.vizTabs}>
                {(Object.keys(VIZ_LABELS) as VizType[]).map(t => (
                    <button key={t} style={{ ...S.vizTab, ...(activeViz === t ? S.vizTabActive : {}) }} onClick={() => onVizChange(t)}>
                        {VIZ_LABELS[t]}
                    </button>
                ))}
            </div>

            <div style={S.vizContent}>
                {vizLoading && <div style={S.emptyHint}>⟳ Analyzing...</div>}
                {!vizLoading && !vizData && <div style={S.emptyHint}>No data — add sources first.</div>}
                {!vizLoading && vizData && (
                    <>
                        {activeViz === 'entities' && Array.isArray(vizData) && (
                            <div style={S.entityGrid}>
                                {vizData.slice(0, 16).map((e: EntityFreq, i: number) => (
                                    <div key={i} style={S.entityChip}>
                                        <span style={{ color: 'var(--cyan-glow)', marginRight: 4 }}>{e.entity}</span>
                                        <span style={{ color: 'var(--text-dim)', fontSize: 9 }}>{e.type} · {e.count}</span>
                                    </div>
                                ))}
                            </div>
                        )}
                        {activeViz === 'temporal' && Array.isArray(vizData) && (
                            <div style={S.timelineList}>
                                {vizData.map((p: TemporalPoint, i: number) => (
                                    <div key={i} style={S.timelineItem}>
                                        <span style={S.timelineDate}>{p.date}</span>
                                        <span style={S.timelineEvent}>{p.eventTitle}</span>
                                    </div>
                                ))}
                            </div>
                        )}
                        {activeViz === 'topics' && vizData?.nodes && (
                            <div style={S.topicGrid}>
                                {vizData.nodes.slice(0, 12).map((n: TopicNode) => (
                                    <div key={n.id} style={{ ...S.topicNode, opacity: 0.5 + n.weight * 0.5 }}>
                                        {n.label}
                                    </div>
                                ))}
                            </div>
                        )}
                        {activeViz === 'sentiment' && vizData?.positive !== undefined && (
                            <SentimentBar data={vizData as SentimentResult} />
                        )}
                    </>
                )}
            </div>
        </div>
    );
}

function SentimentBar({ data }: { data: SentimentResult }) {
    const total = data.positive + data.neutral + data.negative || 1;
    const bars = [
        { label: 'Positive', value: data.positive, color: 'var(--cyan-glow)' },
        { label: 'Neutral', value: data.neutral, color: 'var(--text-dim)' },
        { label: 'Negative', value: data.negative, color: 'var(--red-fusion)' },
    ];
    return (
        <div style={{ padding: '8px 0' }}>
            <div style={{ display: 'flex', height: 16, borderRadius: 2, overflow: 'hidden', marginBottom: 8 }}>
                {bars.map(b => (
                    <div key={b.label} style={{ width: `${(b.value / total) * 100}%`, background: b.color, transition: 'width 0.4s' }}/>
                ))}
            </div>
            {bars.map(b => (
                <div key={b.label} style={{ display: 'flex', justifyContent: 'space-between', fontSize: 10, marginBottom: 2, color: 'var(--silver-albedo)' }}>
                    <span style={{ color: b.color }}>{b.label}</span>
                    <span>{Math.round((b.value / total) * 100)}%</span>
                </div>
            ))}
            <div style={{ fontSize: 10, color: 'var(--text-dim)', marginTop: 6 }}>Compound: {data.compound?.toFixed(3) ?? '—'}</div>
        </div>
    );
}

