{
  "schema": "yuri.math.formula-bank.v0",
  "id": "information-theory",
  "version": "0.2.0",
  "promotionStatus": "verified-baseline",
  "advisoryOnly": false,
  "formulas": [
    {
      "id": "shannon-entropy",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "information-theory",
      "notation": "H(P) = -sum_i p_i log_b(p_i)",
      "purpose": "Measure uncertainty in a normalized probability distribution.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#entropy",
      "variables": [
        {
          "symbol": "p_i",
          "meaning": "probability mass for event i",
          "type": "number",
          "constraints": [
            "p_i >= 0",
            "sum_i p_i > 0"
          ]
        },
        {
          "symbol": "b",
          "meaning": "logarithm base",
          "type": "number",
          "constraints": [
            "b > 1"
          ]
        }
      ],
      "assumptions": [
        "input values can be normalized into a probability distribution"
      ],
      "invalidInputs": [
        "empty array",
        "negative values",
        "zero distribution sum",
        "invalid log base"
      ],
      "failureModes": [
        "Entropy measures uncertainty only; it does not identify which option is correct."
      ],
      "workedExamples": [
        {
          "name": "fair binary distribution",
          "input": {
            "probabilities": [
              0.5,
              0.5
            ],
            "base": 2
          },
          "expected": {
            "entropy": 1
          },
          "interpretation": "A fair two-way uncertainty has one bit of entropy."
        }
      ],
      "proofObligations": [
        "probabilities_non_negative",
        "positive_distribution_sum",
        "zero_terms_ignored"
      ],
      "plainLanguageUseCase": "Use when YURI needs to quantify uncertainty before ranking memories, routes, or evidence buckets.",
      "units": {
        "inputs": {
          "probabilities": "dimensionless probability weights; normalized internally",
          "base": "dimensionless logarithm base"
        },
        "output": "bits when base=2, nats when base=e, otherwise units of the selected log base",
        "parameterSlots": [
          "base"
        ]
      },
      "inputConstraints": [
        "probabilities must be finite non-negative numbers",
        "probability mass must have positive sum",
        "base must be greater than 1"
      ],
      "counterexamples": [
        {
          "name": "negative probability weight",
          "input": {
            "probabilities": [
              1,
              -1
            ],
            "base": 2
          },
          "expectedError": "non-negative"
        },
        {
          "name": "fractional log base flips entropy sign",
          "input": {
            "probabilities": [
              0.5,
              0.5
            ],
            "base": 0.5
          },
          "expectedError": "greater than 1",
          "interpretation": "A base in (0,1) silently negates entropy; the kernel rejects it as a permanent negative proof."
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "compare uncertainty before and after evidence",
          "detect whether a distribution is diffuse or concentrated"
        ],
        "avoidWhen": [
          "inputs are raw scores that cannot be interpreted as probability mass",
          "the question is directional drift rather than uncertainty"
        ],
        "yuriApplications": [
          "memory-ranking uncertainty",
          "context-router ambiguity",
          "release-gate evidence spread"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#entropy",
        "proofGateFormulaId": "shannon-entropy",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "fair binary distribution",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "negative probability weight",
          "expectedError": "non-negative"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs",
        "local:_SYSTEM/research-archive/yuri-math-engine-2026-05/12_research_sprint_2026_05_25.md"
      ]
    },
    {
      "id": "kl-divergence",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "information-theory",
      "notation": "D_KL(P || Q) = sum_i p_i log_b(p_i / q_i)",
      "purpose": "Measure directional distribution shift from reference Q to observed P.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#klDivergence",
      "variables": [
        {
          "symbol": "P",
          "meaning": "left distribution",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum"
          ]
        },
        {
          "symbol": "Q",
          "meaning": "reference distribution",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum",
            "q_i > 0 where p_i > 0"
          ]
        }
      ],
      "assumptions": [
        "P and Q describe the same ordered event space"
      ],
      "invalidInputs": [
        "unequal lengths",
        "negative values",
        "zero q_i where p_i is positive"
      ],
      "failureModes": [
        "KL divergence is directional; swapping P and Q changes the result."
      ],
      "workedExamples": [
        {
          "name": "binary shift",
          "input": {
            "p": [
              0.5,
              0.5
            ],
            "q": [
              0.25,
              0.75
            ],
            "base": 2
          },
          "expected": {
            "divergence": 0.207518749639422
          },
          "interpretation": "The observed distribution has measurable directional shift from the reference."
        }
      ],
      "proofObligations": [
        "equal_distribution_lengths",
        "q_i_positive_where_p_i_positive"
      ],
      "plainLanguageUseCase": "Use when YURI compares an observed distribution against a reference distribution and cares about directional drift.",
      "units": {
        "inputs": {
          "p": "dimensionless probability weights for observed/current distribution",
          "q": "dimensionless probability weights for reference distribution",
          "base": "dimensionless logarithm base"
        },
        "output": "bits when base=2, nats when base=e, otherwise units of selected log base",
        "parameterSlots": [
          "base"
        ]
      },
      "inputConstraints": [
        "p and q must be finite non-negative equal-length vectors",
        "both distributions must have positive mass",
        "q cannot be zero where p is positive"
      ],
      "counterexamples": [
        {
          "name": "reference zero where observed is positive",
          "input": {
            "p": [
              0.5,
              0.5
            ],
            "q": [
              1,
              0
            ],
            "base": 2
          },
          "expectedError": "zero where p is positive"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "detect RAG distribution shift",
          "compare current evidence mix to a trusted baseline"
        ],
        "avoidWhen": [
          "the comparison must be symmetric",
          "zero support in the reference means the case needs quarantine rather than a finite score"
        ],
        "yuriApplications": [
          "RAG conflict detection",
          "source mix drift",
          "retrieval policy regression checks"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#klDivergence",
        "proofGateFormulaId": "kl-divergence",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "binary shift",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "reference zero where observed is positive",
          "expectedError": "zero where p is positive"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs",
        "local:_SYSTEM/research-archive/yuri-math-engine-2026-05/09_general_math_operationalization.md"
      ]
    },
    {
      "id": "cross-entropy",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "information-theory",
      "notation": "H(P, Q) = -sum_i p_i log_b(q_i)",
      "purpose": "Measure mismatch between a target distribution and an encoded/predicted distribution.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#crossEntropy",
      "variables": [
        {
          "symbol": "P",
          "meaning": "target distribution",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum"
          ]
        },
        {
          "symbol": "Q",
          "meaning": "encoded or predicted distribution",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum",
            "q_i > 0 where p_i > 0"
          ]
        }
      ],
      "assumptions": [
        "P and Q describe the same ordered event space"
      ],
      "invalidInputs": [
        "unequal lengths",
        "negative values",
        "zero q_i where p_i is positive"
      ],
      "failureModes": [
        "Cross-entropy can rise because of mismatch, uncertainty, or both; inspect entropy and KL when interpreting."
      ],
      "workedExamples": [
        {
          "name": "binary mismatch",
          "input": {
            "p": [
              0.5,
              0.5
            ],
            "q": [
              0.25,
              0.75
            ],
            "base": 2
          },
          "expected": {
            "crossEntropy": 1.20751874963942
          },
          "interpretation": "The encoding is worse than the one-bit entropy baseline by the KL divergence amount."
        }
      ],
      "proofObligations": [
        "equal_distribution_lengths",
        "q_i_positive_where_p_i_positive"
      ],
      "plainLanguageUseCase": "Use when YURI measures how costly it is to encode or predict one distribution using another.",
      "units": {
        "inputs": {
          "p": "dimensionless target probability weights",
          "q": "dimensionless predicted/reference probability weights",
          "base": "dimensionless logarithm base"
        },
        "output": "bits when base=2, nats when base=e, otherwise units of selected log base",
        "parameterSlots": [
          "base"
        ]
      },
      "inputConstraints": [
        "p and q must be finite non-negative equal-length vectors",
        "both distributions must have positive mass",
        "q cannot be zero where p is positive"
      ],
      "counterexamples": [
        {
          "name": "predicted zero for possible target",
          "input": {
            "p": [
              0.5,
              0.5
            ],
            "q": [
              1,
              0
            ],
            "base": 2
          },
          "expectedError": "zero where p is positive"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "score predictive mismatch",
          "compare expected retrieval mix to actual retrieval mix"
        ],
        "avoidWhen": [
          "you only need uncertainty of one distribution",
          "you need a symmetric distance"
        ],
        "yuriApplications": [
          "RAG mismatch scoring",
          "routing distribution audit",
          "evidence-model calibration"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#crossEntropy",
        "proofGateFormulaId": "cross-entropy",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "binary mismatch",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "predicted zero for possible target",
          "expectedError": "zero where p is positive"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs",
        "local:_SYSTEM/research-archive/yuri-math-engine-2026-05/12_research_sprint_2026_05_25.md"
      ]
    },
    {
      "id": "information-gain",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "information-theory",
      "notation": "IG(before, after) = H(before) - H(after)",
      "purpose": "Measure how much uncertainty an update removed: the entropy drop from a prior distribution to a posterior distribution.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#informationGain",
      "variables": [
        {
          "symbol": "before",
          "meaning": "prior distribution before evidence",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum"
          ]
        },
        {
          "symbol": "after",
          "meaning": "posterior distribution after evidence",
          "type": "number[]",
          "constraints": [
            "non-negative",
            "positive sum"
          ]
        },
        {
          "symbol": "b",
          "meaning": "logarithm base",
          "type": "number",
          "constraints": [
            "b > 1"
          ]
        }
      ],
      "assumptions": [
        "before and after can each be normalized into probability distributions",
        "both distributions describe the same event space"
      ],
      "invalidInputs": [
        "empty array",
        "negative values",
        "zero distribution sum",
        "invalid log base"
      ],
      "failureModes": [
        "Information gain can be negative if the update increased uncertainty; it measures entropy change only, not correctness of the update."
      ],
      "workedExamples": [
        {
          "name": "evidence sharpens a fair prior",
          "input": {
            "before": [
              0.5,
              0.5
            ],
            "after": [
              0.9,
              0.1
            ],
            "base": 2
          },
          "expected": {
            "gain": 0.531004406410719
          },
          "interpretation": "Moving from a fair coin to a 90/10 belief removes about 0.531 bits of uncertainty."
        }
      ],
      "proofObligations": [
        "entropy_difference_definition",
        "probabilities_non_negative",
        "positive_distribution_sum"
      ],
      "plainLanguageUseCase": "Use when YURI needs to quantify how much an evidence update reduced uncertainty, for example crediting the epsilon energy term for genuine belief sharpening.",
      "units": {
        "inputs": {
          "before": "dimensionless prior probability weights; normalized internally",
          "after": "dimensionless posterior probability weights; normalized internally",
          "base": "dimensionless logarithm base"
        },
        "output": "bits when base=2, nats when base=e, otherwise units of the selected log base",
        "parameterSlots": [
          "base"
        ]
      },
      "inputConstraints": [
        "before and after must be finite non-negative non-empty arrays",
        "each distribution must have positive mass",
        "base must be greater than 1"
      ],
      "counterexamples": [
        {
          "name": "empty prior distribution",
          "input": {
            "before": [],
            "after": [
              0.5,
              0.5
            ],
            "base": 2
          },
          "expectedError": "must be a non-empty array"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "credit an update for genuinely sharpening belief",
          "compare uncertainty before and after evidence is applied"
        ],
        "avoidWhen": [
          "the two distributions describe different event spaces",
          "the question is directional drift rather than uncertainty reduction"
        ],
        "yuriApplications": [
          "epsilon energy term information credit",
          "claim-cortex belief sharpening reward",
          "evidence value scoring"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#informationGain",
        "proofGateFormulaId": "information-gain",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "evidence sharpens a fair prior",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "empty prior distribution",
          "expectedError": "must be a non-empty array"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.mjs#informationGain",
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs"
      ]
    }
  ]
}
