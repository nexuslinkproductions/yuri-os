{
  "schema": "yuri.math.formula-bank.v0",
  "id": "probability-calibration",
  "version": "0.2.0",
  "promotionStatus": "verified-baseline",
  "advisoryOnly": false,
  "formulas": [
    {
      "id": "brier-score",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "probability-calibration",
      "notation": "BS = (1 / n) * sum_i (p_i - y_i)^2",
      "purpose": "Measure the squared error of probabilistic predictions against observed outcomes.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#brierScore",
      "variables": [
        { "symbol": "p_i", "meaning": "predicted probability", "type": "number", "constraints": ["0 <= p_i <= 1"] },
        { "symbol": "y_i", "meaning": "observed outcome or target probability", "type": "number", "constraints": ["0 <= y_i <= 1"] },
        { "symbol": "n", "meaning": "number of paired observations", "type": "integer", "constraints": ["n > 0"] }
      ],
      "assumptions": ["predictions and outcomes are paired in the same order"],
      "invalidInputs": ["empty arrays", "unequal lengths", "values outside [0, 1]"],
      "failureModes": ["A low score does not prove causality or explain why predictions are accurate."],
      "workedExamples": [
        {
          "name": "two prediction smoke check",
          "input": { "predictions": [0.9, 0.2], "outcomes": [1, 0] },
          "expected": { "score": 0.025 },
          "interpretation": "The predictions are close to the observed outcomes on this synthetic fixture."
        }
      ],
      "proofObligations": ["paired_probability_bounds", "mean_squared_error_determinism"]
    },
    {
      "id": "log-loss",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "probability-calibration",
      "notation": "LL = -(1 / n) * sum_i [y_i log(p_i) + (1-y_i) log(1-p_i)]",
      "purpose": "Penalize overconfident wrong probabilistic predictions.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#logLoss",
      "variables": [
        { "symbol": "p_i", "meaning": "predicted probability", "type": "number", "constraints": ["0 <= p_i <= 1"] },
        { "symbol": "y_i", "meaning": "observed outcome or target probability", "type": "number", "constraints": ["0 <= y_i <= 1"] },
        { "symbol": "epsilon", "meaning": "clipping value for numerical stability", "type": "number", "constraints": ["0 < epsilon < 0.5"] }
      ],
      "assumptions": ["binary or fractional target in [0, 1]", "epsilon is explicit"],
      "invalidInputs": ["empty arrays", "unequal lengths", "invalid probabilities", "invalid epsilon"],
      "failureModes": ["Extreme clipping choices can hide numerical instability."],
      "workedExamples": [
        {
          "name": "two prediction smoke check",
          "input": { "predictions": [0.9, 0.2], "outcomes": [1, 0] },
          "expected": { "loss": 0.164252033486018 },
          "interpretation": "The loss is low because both predictions assign high probability to the observed target."
        }
      ],
      "proofObligations": ["probability_bounds", "epsilon_bounds", "deterministic_clipping"]
    },
    {
      "id": "bayes-update",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "probability",
      "notation": "P(H|E) = P(E|H)P(H) / [P(E|H)P(H) + P(E|not H)P(not H)]",
      "purpose": "Update a binary hypothesis probability after evidence.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#bayesUpdate",
      "variables": [
        { "symbol": "P(H)", "meaning": "prior probability of hypothesis", "type": "number", "constraints": ["0 <= P(H) <= 1"] },
        { "symbol": "P(E|H)", "meaning": "likelihood of evidence if hypothesis is true", "type": "number", "constraints": ["P(E|H) >= 0"] },
        { "symbol": "P(E|not H)", "meaning": "likelihood of evidence if hypothesis is false", "type": "number", "constraints": ["P(E|not H) >= 0"] }
      ],
      "assumptions": ["binary hypothesis split", "likelihoods use the same evidence event"],
      "invalidInputs": ["invalid prior", "negative likelihoods", "zero total evidence mass"],
      "failureModes": ["Wrong likelihoods produce precise-looking but false updates."],
      "workedExamples": [
        {
          "name": "balanced prior with strong evidence",
          "input": { "prior": 0.5, "likelihoodIfTrue": 0.8, "likelihoodIfFalse": 0.2 },
          "expected": { "posterior": 0.8 },
          "interpretation": "Evidence four times likelier under the hypothesis moves a neutral prior to 0.8."
        }
      ],
      "proofObligations": ["positive_evidence_mass", "posterior_probability_bounds"]
    },
    {
      "id": "softmax",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "probability-normalization",
      "notation": "softmax(x_i) = exp(x_i / T) / sum_j exp(x_j / T)",
      "purpose": "Convert finite scores into a normalized probability-like distribution.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#softmax",
      "variables": [
        { "symbol": "x_i", "meaning": "finite score", "type": "number", "constraints": ["finite"] },
        { "symbol": "T", "meaning": "temperature", "type": "number", "constraints": ["T > 0"] }
      ],
      "assumptions": ["scores are comparable", "temperature is explicit"],
      "invalidInputs": ["empty vector", "non-finite scores", "non-positive temperature"],
      "failureModes": ["Softmax can make arbitrary scores look probabilistic even when scores lack evidence."],
      "workedExamples": [
        {
          "name": "equal scores",
          "input": { "values": [0, 0] },
          "expected": { "distribution": [0.5, 0.5] },
          "interpretation": "Equal scores receive equal mass."
        }
      ],
      "proofObligations": ["positive_temperature", "normalized_output_sum"]
    }
  ]
}
