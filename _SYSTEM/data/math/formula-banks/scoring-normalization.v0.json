    {
      "id": "weighted-mean",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "statistics",
      "notation": "mu_w = sum_i w_i x_i / sum_i w_i",
      "purpose": "Aggregate finite values according to explicit non-negative weights.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#weightedMean",
      "variables": [
        {
          "symbol": "x_i",
          "meaning": "finite value",
          "type": "number",
          "constraints": [
            "finite"
          ]
        },
        {
          "symbol": "w_i",
          "meaning": "non-negative weight",
          "type": "number",
          "constraints": [
            "w_i >= 0",
            "sum_i w_i > 0"
          ]
        }
      ],
      "assumptions": [
        "weights are explicit and comparable"
      ],
      "invalidInputs": [
        "empty arrays",
        "unequal lengths",
        "negative weights",
        "zero weight sum"
      ],
      "failureModes": [
        "Weights can encode policy bias; formula correctness does not validate the weighting policy."
      ],
      "workedExamples": [
        {
          "name": "weighted average fixture",
          "input": {
            "values": [
              1,
              2,
              3
            ],
            "weights": [
              1,
              1,
              2
            ]
          },
          "expected": {
            "mean": 2.25
          },
          "interpretation": "The final value receives twice the mass of each earlier value."
        }
      ],
      "proofObligations": [
        "positive_weight_sum",
        "equal_lengths"
      ],
      "plainLanguageUseCase": "Use when YURI combines finite scored evidence with explicit non-negative importance weights.",
      "units": {
        "inputs": {
          "values": "score units declared by the caller",
          "weights": "non-negative dimensionless weights"
        },
        "output": "same units as values"
      },
      "inputConstraints": [
        "values and weights must be equal-length finite arrays",
        "weights must be non-negative and have positive sum"
      ],
      "counterexamples": [
        {
          "name": "zero total weight",
          "input": {
            "values": [
              1,
              2
            ],
            "weights": [
              0,
              0
            ]
          },
          "expectedError": "positive sum"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "combining evidence criteria with declared weights",
          "release or memory scoring needs explainable aggregation"
        ],
        "avoidWhen": [
          "weights are implicit vibes",
          "one invalid criterion should veto rather than average"
        ],
        "yuriApplications": [
          "release scoring",
          "memory score aggregation",
          "provenance scoring"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#weightedMean",
        "proofGateFormulaId": "weighted-mean",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "weighted average fixture",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "zero total weight",
          "expectedError": "positive sum"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs",
        "local:_SYSTEM/research-archive/yuri-math-engine-2026-05/13_math_application_playbook.md"
      ]
    },
    {
      "id": "weighted-variance",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "statistics",
      "notation": "var_w = sum_i w_i (x_i - mu_w)^2 / sum_i w_i",
      "purpose": "Measure weighted spread around a weighted mean.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#weightedVariance",
      "variables": [
        {
          "symbol": "x_i",
          "meaning": "finite value",
          "type": "number",
          "constraints": [
            "finite"
          ]
        },
        {
          "symbol": "w_i",
          "meaning": "non-negative weight",
          "type": "number",
          "constraints": [
            "w_i >= 0",
            "sum_i w_i > 0"
          ]
        }
      ],
      "assumptions": [
        "population-style variance",
        "weights are explicit"
      ],
      "invalidInputs": [
        "empty arrays",
        "unequal lengths",
        "negative weights",
        "zero weight sum"
      ],
      "failureModes": [
        "Spread is not a cause explanation; it only quantifies dispersion."
      ],
      "workedExamples": [
        {
          "name": "weighted variance fixture",
          "input": {
            "values": [
              1,
              2,
              3
            ],
            "weights": [
              1,
              1,
              2
            ]
          },
          "expected": {
            "variance": 0.6875
          },
          "interpretation": "The values have modest weighted spread around 2.25."
        }
      ],
      "proofObligations": [
        "weighted_mean_dependency",
        "non_negative_variance"
      ],
      "plainLanguageUseCase": "Use when YURI needs to see whether weighted evidence is consistent or spread out around its mean.",
      "units": {
        "inputs": {
          "values": "score units declared by the caller",
          "weights": "non-negative dimensionless weights"
        },
        "output": "squared value units"
      },
      "inputConstraints": [
        "values and weights must be equal-length finite arrays",
        "weights must be non-negative and have positive sum"
      ],
      "counterexamples": [
        {
          "name": "negative weight",
          "input": {
            "values": [
              1,
              2
            ],
            "weights": [
              -1,
              2
            ]
          },
          "expectedError": "non-negative"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "detecting disagreement among evidence components",
          "flagging unstable aggregate scores"
        ],
        "avoidWhen": [
          "values are categorical labels",
          "dispersion is less important than hard threshold failure"
        ],
        "yuriApplications": [
          "release gate disagreement",
          "memory source reliability spread",
          "routing criterion stability"
        ]
      },
      "implementationBinding": {
        "runtime": "node",
        "binding": "_SYSTEM/Scripts/math/math-kernel.mjs#weightedVariance",
        "proofGateFormulaId": "weighted-variance",
        "proofGate": "_SYSTEM/Scripts/math/math-proof-gate.mjs",
        "tests": [
          "_SYSTEM/Scripts/math/math-kernel.test.mjs",
          "_SYSTEM/Scripts/math/math-proof-gate.test.mjs"
        ]
      },
      "testVectors": [
        {
          "type": "worked-example",
          "name": "weighted variance fixture",
          "expected": "matches workedExamples.expected via proof gate"
        },
        {
          "type": "invalid-input",
          "name": "negative weight",
          "expectedError": "non-negative"
        }
      ],
      "sources": [
        "local:_SYSTEM/Scripts/math/math-kernel.test.mjs"
      ]
    },
    {
      "id": "expected-value",
      "promotionStatus": "verified-baseline",
      "advisoryOnly": false,
      "domain": "decision-theory",
      "notation": "E[X] = sum_i x_i P(x_i)",
      "purpose": "Compute the probability-weighted average value of possible outcomes.",
      "implementedBy": "_SYSTEM/Scripts/math/math-kernel.mjs#expectedValue",
      "variables": [
        {
          "symbol": "x_i",
          "meaning": "finite outcome value",
          "type": "number",
          "constraints": [
            "finite"
          ]
        },
        {
          "symbol": "P(x_i)",
          "meaning": "non-negative probability mass",
          "type": "number",
          "constraints": [
            "P(x_i) >= 0",
            "sum_i P(x_i) > 0"
          ]
        }
      ],
      "assumptions": [
        "outcomes and probabilities are paired",
        "probabilities can be normalized"
      ],
      "invalidInputs": [
        "empty arrays",
        "unequal lengths",
        "negative probability mass",
        "zero probability sum"
      ],
      "failureModes": [
        "Expected value can hide tail cases and should not replace risk inspection."
      ],
      "workedExamples": [
        {
          "name": "two-outcome fixture",
          "input": {
            "values": [
              10,
              20
            ],
            "probabilities": [
              1,
              3
            ]
          },
          "expected": {
            "value": 17.5
          },
          "interpretation": "The second outcome receives three quarters of normalized mass."
        }
      ],
      "proofObligations": [
        "probability_normalization",
        "paired_arrays"
      ],
      "plainLanguageUseCase": "Use when YURI compares possible outcomes by probability-weighted value under explicit assumptions.",
      "units": {
        "inputs": {
          "values": "outcome utility or cost units",
          "probabilities": "non-negative probability weights normalized internally"
        },
        "output": "same units as values"
      },
      "inputConstraints": [
        "values and probabilities must be equal-length finite arrays",
        "probability weights must have positive sum"
      ],
      "counterexamples": [
        {
          "name": "zero probability mass",
          "input": {
            "values": [
              10
            ],
            "probabilities": [
              0
            ]
          },
          "expectedError": "positive sum"
        }
      ],
      "selectionGuidance": {
        "useWhen": [
          "choosing among reversible tool/lane options with explicit outcome values",
          "estimating expected utility of a bounded action"
        ],
        "avoidWhen": [
          "tail risk cannot be averaged away",
          "values are not commensurable"
        ],
        "yuriApplications": [
          "tool routing utility",
          "task triage",
          "advisor lane selection"
        ]
      },
      "implementationBinding": {
