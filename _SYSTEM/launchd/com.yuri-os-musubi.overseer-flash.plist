<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DISARMED template — the deepseek-flash trading OVERSEER beat (the fast, cheap lane of the 2-overseer
  team). NOT loaded by anything; this file lives in the repo only. Arming is OWNER-GATED (continuous
  spend + a recurring background process):

    cp _SYSTEM/launchd/com.yuri-os-musubi.overseer-flash.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.yuri-os-musubi.overseer-flash.plist
    # disarm:  launchctl bootout gui/$(id -u)/com.yuri-os-musubi.overseer-flash ; rm ~/Library/LaunchAgents/com.yuri-os-musubi.overseer-flash.plist

  Every 30s it runs ONE overseer beat on the flash lane: gather live trading state → fee-aware reweight
  (deterministic) → write the hot-reloaded overseer-config → ollama-cloud deepseek judgment as an
  ADVISORY proposal posted to the shared board (it can NEVER write binding config). The Sonnet lane (or
  Marcel) ratifies. INV-1 safe: writes config + weights only, never an order path. The ollama key is
  hydrated from Keychain inside overseer.mjs (no secret in this plist).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yuri-os-musubi.overseer-flash</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/marcelspatz/YURI-OS-MUSUBI/_SYSTEM/Scripts/alpha-factor-library/overseer.mjs</string>
        <string>--once</string>
        <string>--lane</string>
        <string>flash</string>
        <string>--llm</string>
        <string>deepseek-v4-flash:cloud</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/marcelspatz/YURI-OS-MUSUBI</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/marcelspatz</string>
        <key>YURI_ROOT</key>
        <string>/Users/marcelspatz/YURI-OS-MUSUBI</string>
    </dict>

    <!-- Every 30s (Marcel's spec for the flash lane). launchd skips a fire if the prior run is still
         in flight, so a slow ollama call naturally throttles the cadence. -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/marcelspatz/YURI-OS-MUSUBI/_SYSTEM/state/overseer-flash.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marcelspatz/YURI-OS-MUSUBI/_SYSTEM/state/overseer-flash.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
