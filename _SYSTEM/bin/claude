#!/usr/bin/env bash
# YURI claude launcher — shows HUD splash for interactive sessions.
# Lives at ~/YURI/bin (prepended to PATH) to intercept all launches.
# Strips itself from PATH before exec'ing the real binary to avoid recursion.

if [[ "${YURI_SPLASH_SHOWN:-0}" != "1" ]]; then
  _interactive=1
  for _arg in "$@"; do
    case "$_arg" in
      --print|-p|--version|-h|--help|--output-format|\
      --dangerously-skip-permissions|--no-update-check)
        _interactive=0; break ;;
    esac
  done
  unset _arg

  if [[ "$_interactive" = "1" ]]; then
    _G='\033[38;2;180;234;144m'
    _G2='\033[38;2;56;87;36m'
    _AU='\033[38;2;92;184;0m'
    _GR='\033[38;2;168;168;168m'
    _CY='\033[38;2;180;234;144m'
    _RS='\033[0m'

    # Read model from settings.json if available; fall back to default
    _SETTINGS="$(dirname "$(dirname "$0")")/.claude/settings.json"
    _MODEL="claude-sonnet-4-6"
    if [[ -f "$_SETTINGS" ]] && command -v node >/dev/null 2>&1; then
      _M="$(node -e "try{const s=require('$_SETTINGS');console.log(s.model||'')}catch(_){}" 2>/dev/null)"
      [[ -n "$_M" ]] && _MODEL="$_M"
    fi
    unset _SETTINGS _M

    printf "\n"
    printf "${_AU}  ◆ CLAUDE CODE${_RS}  ${_G2}──────────────────────────────────────${_RS}\n"
    printf "  ${_GR}%-14s${_RS}%s\n"       "MODEL"     "$_MODEL"
    printf "  ${_GR}%-14s${_CY}%s${_RS}\n" "WORKSPACE" "$(basename "$PWD")"
    printf "  ${_GR}%-14s${_RS}%s\n"       "SESSION"   "$(date '+%Y-%m-%d  %H:%M')"
    printf "  ${_G2}──────────────────────────────────────────────${_RS}\n"
    printf "\n"

    unset _G _G2 _AU _GR _CY _RS _MODEL
  fi
  unset _interactive
fi

export YURI_SPLASH_SHOWN=1

# Strip wrapper dir from PATH so exec resolves the real claude binary.
# Handle both leading and trailing positions.
_WRAPPER_DIR="$HOME/YURI/bin"
_CLEAN_PATH=":${PATH}:"
_CLEAN_PATH="${_CLEAN_PATH//:${_WRAPPER_DIR}:/}"
_CLEAN_PATH="${_CLEAN_PATH#:}"
_CLEAN_PATH="${_CLEAN_PATH%:}"

# Safety: if stripping failed (PATH unchanged minus wrapper), fall back to absolute
if [[ "$_CLEAN_PATH" == *"$_WRAPPER_DIR"* ]]; then
  exec "$HOME/.local/bin/claude" "$@"
fi

exec env PATH="$_CLEAN_PATH" claude "$@"
