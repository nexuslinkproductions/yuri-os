# Test isolation flags
# NUDIMMUD_DB_PATH — unset: live DB via SystemConfig; :memory: = in-memory SQLite for isolated tests;
#   any other value is resolved through SystemConfig root boundary (arbitrary absolute paths outside root are rejected)
NUDIMMUD_DB_PATH=

# NUDIMMUD_TEST_MODE — "1" or "true": implies watcher, interval, and swarm suppression + StabilityGuard off
NUDIMMUD_TEST_MODE=

# NUDIMMUD_DISABLE_WATCHERS — suppresses boot vault ingestion and vault watcher
NUDIMMUD_DISABLE_WATCHERS=

# NUDIMMUD_DISABLE_INTERVALS — suppresses Outlook sync and integration check startup/intervals
NUDIMMUD_DISABLE_INTERVALS=

# NUDIMMUD_DISABLE_SWARM_ORCHESTRATOR — suppresses boot SwarmOrchestrator execution
NUDIMMUD_DISABLE_SWARM_ORCHESTRATOR=

# Runtime providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_BASE_URL=

# DeepSeek V4 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_LITE_MODEL=deepseek-v4-pro

# Kie.ai image generation
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
