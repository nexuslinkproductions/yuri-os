{
  "version": "sol-moe-v3.3-cost-tier",
  "mode": "native-parent-controller",
  "execution": "sessions_spawn-native-push",
  "providerRouteRegistry": {
    "path": "_SYSTEM/config/provider-route-registry.json",
    "selection": "provider-calibration-after-exact-native-canary",
    "unresolvedRoutesAreBlocked": true
  },
  "availabilityDefaults": {
    "zai/glm-5.2": false,
    "opencode-go/mimo-v2.5": true
  },
  "seat": {
    "expert": "sol",
    "agentId": "mure-yuri",
    "model": "openai/gpt-5.6-sol",
    "thinking": "high"
  },
  "providerCalibration": {
    "scope": "all accepted native child dispatches: evidence, primary producers, availability fallbacks, quality escalations, and verifiers; excludes the Sol parent seat",
    "metric": "accepted native child dispatch count; token share is observed separately",
    "windowDispatches": 50,
    "minimumSamples": 30,
    "promotionMargin": 0.03,
    "maximumBrierRegression": 0,
    "activeTargets": {
      "minimax": { "min": 0.3, "max": 0.55 },
      "anthropic": { "min": 0.12, "max": 0.28 },
      "deepseek": { "min": 0.22, "max": 0.45 },
      "mimo": { "min": 0, "max": 0.18 },
      "openai": { "min": 0.10, "max": 0.30 },
      "zai": { "min": 0, "max": 0 }
    },
    "recoveredTargets": {
      "minimax": { "min": 0.28, "max": 0.5 },
      "anthropic": { "min": 0.12, "max": 0.28 },
      "deepseek": { "min": 0.2, "max": 0.4 },
      "mimo": { "min": 0.08, "max": 0.2 },
      "openai": { "min": 0.10, "max": 0.30 },
      "zai": { "min": 0.08, "max": 0.2 }
    },
    "hardRules": [
      "Sol remains the parent control plane and final integrator",
      "Sol is never compiled into a native child worker entry",
      "Sol is never compiled into a native child worker entry — terra and luna are cheap frontier peers and carry real producer volume",
      "cheap models may produce only R0 semantics and R1-R3 evidence",
      "R2 requires an independent frontier verifier",
      "R3 requires independent Opus 4.8 verification"
    ]
  },
  "riskClasses": {
    "R0": "Mechanical, read-only, bounded, and deterministically checkable",
    "R1": "Reversible implementation or analysis requiring a frontier semantic producer",
    "R2": "Important architecture, migration, multi-file logic, or high-blast reversible work",
    "R3": "Security, governance, protected-surface, destructive, irreversible, or outward-facing work"
  },
  "experts": [
