{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuri.workcell-capsule.v0",
  "title": "YURI Workcell Memory Capsule",
  "description": "Read-only memory projection assembled by the orchestrator and injected into worker packets. Runtime validation is performed by validateMemoryCapsule in yuri-workcell.mjs.",
  "type": "object",
  "required": ["version", "assembledAt", "assembledBy", "contexts", "policy"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Capsule schema version string, e.g. 'workcell.capsule.v0'."
    },
    "assembledAt": { "type": "string", "description": "ISO-8601 timestamp when the capsule was assembled." },
    "assembledBy": { "type": "string", "description": "Role or identifier of the entity that assembled this capsule." },
    "goal": { "type": "string", "description": "Sub-task goal that drove memory recall." },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "description": "Repo-relative path to the source memory file." },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "content": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" },
          "truncated": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "maxContexts": { "type": "integer", "minimum": 1 },
    "maxBytesPerContext": { "type": "integer", "minimum": 1 },
    "maxTotalBytes": { "type": "integer", "minimum": 1 },
    "policy": {
      "type": "object",
      "required": ["readOnly", "writeAllowed", "promoteAllowed"],
      "properties": {
        "readOnly": { "const": true },
        "proposalAllowed": { "type": "boolean" },
        "writeAllowed": { "const": false },
        "promoteAllowed": { "const": false },
        "recallAllowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "staleness": {
      "type": "object",
      "properties": {
        "checkedAt": { "type": "string" },
        "staleContextIds": { "type": "array", "items": { "type": "string" } },
        "freshnessWindowHours": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "ledgerSummary": {
      "type": "object",
      "properties": {
        "recentEntryCount": { "type": "integer", "minimum": 0 },
        "lastTimestamp": { "type": "string" },
        "scope": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
