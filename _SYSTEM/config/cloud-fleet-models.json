{
  "meta": {
    "name": "cloud-fleet-models",
    "version": "2.1.0",
    "updated": "2026-07-09",
    "policy": "CLOUD-ONLY with explicit substrate roster. Direct DeepSeek API ACTIVE (re-instated 2026-07-09; daily cap binding $1.25). Ollama Cloud + Cursor kept on the seam but not actively routed. Codex Pro skipped until owner decides. Fable-5 temporarily excluded (limited access till 2026-07-12). M3 native via minimax-portal binding (Ultra tier). Orchestrator uses Anthropic Claude weekly pool first, falls back to GLM-5.2 (Z.ai) when capped.",
    "authority": "Advisory routing map for opus-fleet + MURE. Governance + arm flags always win."
  },
  "orchestrator": {
    "primary": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "ompRole": "default",
      "when": "Claude OAuth window available"
    },
    "fallbacks": [
      {
        "rank": 1,
        "provider": "cursor",
        "model": "composer-2.5",
        "ompRole": "default",
        "when": "Claude session limit / credential block"
      },
      {
        "rank": 2,
        "provider": "z-ai",
        "lane": "glm-max",
        "model": "glm-5.2",
        "when": "heavy synthesis; z.ai plan"
      },
      {
        "rank": 3,
        "provider": "xiaomi-mimo",
        "model": "mimo-v2.5-pro[1m]",
        "when": "Anthropic-protocol alternative; 1M ctx"
      }
    ]
  },
  "substrates": {
    "omp_task": {
      "description": "OMP harness task() subagents — primary native worker substrate",
      "roles": {
        "explore": {
          "lane": "research",
          "model": "default",
          "tools": "read-only"
        },
        "reviewer": {
          "lane": "verification",
          "model": "default"
        },
        "tester": {
          "lane": "testing",
          "model": "default"
        },
        "task": {
          "lane": "codegen",
          "model": "default"
        },
        "librarian": {
          "lane": "research",
          "model": "default"
        },
        "designer": {
          "lane": "design",
          "model": "default"
        },
        "plan": {
          "lane": "architecture",
          "model": "slow"
        },
        "sonic": {
          "lane": "mechanical",
          "model": "smol"
        }
      },
      "rules": [
        "Self-contained assignment per spawn (Goal/Constraints/Contract + Target/Change/Acceptance).",
        "Orchestrator verifies every result against local evidence.",
        "Never finalize (commit/push) from a subagent."
      ]
    },
    "glm_fleet": {
      "script": "_SYSTEM/Scripts/glm-fleet.mjs",
      "armEnv": "YURI_GLM_FLEET",
      "armFlag": "_SYSTEM/state/glm-fleet.enabled",
      "reasoning": "high",
      "tiers": {
        "glm-max": {
          "model": "glm-5.2",
          "ctx": "1M",
          "use": "orchestrator-peer, architecture, adversarial, synthesis"
        },
        "glm": {
          "model": "glm-5.1",
          "ctx": "200K",
          "use": "code-gen, refactor, judgment (workhorse)"
        },
        "glm-flash": {
          "model": "glm-5-turbo",
          "ctx": "200K",
          "use": "census, scan, fast bulk (alias remaps from glm-flash; 4.7-flash unstable)"
        },
        "glm-turbo": {
          "model": "glm-5-turbo",
          "ctx": "200K",
          "use": "reactive / voice-brain / snappy"
        },
        "glm-vision": {
          "model": "glm-4.6v",
          "ctx": "64K",
          "use": "screenshots / UI"
        }
      }
    },
    "ollama_cloud": {
      "script": "_SYSTEM/Scripts/ollama-fleet.mjs",
      "armEnv": "YURI_OLLAMA_FLEET",
      "armFlag": "_SYSTEM/state/ollama-fleet.enabled",
      "concurrency": 3,
      "localForbidden": true,
      "tiers": {
        "flash": {
          "model": "deepseek-v4-flash",
          "use": "default bulk — best quality/usage"
        },
        "minimax": {
          "model": "minimax-m3:cloud",
          "use": "efficient generalist"
        },
        "kimi": {
          "model": "kimi-k2.7-code:cloud",
          "use": "code-heavy peer"
        },
        "nemotron": {
          "model": "nemotron-3-ultra:cloud",
          "use": "heavy reasoning burst"
        },
        "deepseek-pro": {
          "model": "deepseek-v4-pro:cloud",
          "use": "true-1M heavy — avoid bulk (~2x usage)"
        },
        "gemma": {
          "model": "gemma4:31b-cloud",
          "use": "available cloud generalist"
        }
      }
    },
    "mimo": {
      "lanes": {
        "mimo-v2.5-pro[1m]": {
          "use": "Opus-class Anthropic-protocol",
          "ctx": "1M"
        },
        "mimo-v2.5[1m]": {
          "use": "multimodal + reasoning",
          "ctx": "1M"
        },
        "mimo-v2-flash": {
          "use": "fast/cheap",
          "ctx": "256K"
        }
      }
    },
    "cursor": {
      "model": "composer-2.5-fast",
      "ompRole": "on-seam-only",
      "when": "NOT actively routed (Cursor may fall away 2026-07-23). Reserved seam for Composer 2.5 Fast; Grok 4.5 to be added when EU-available.",
      "activeConfig": ["composer-2.5-fast"],
      "pendingConfig": ["grok-4.5-eu"]
    },
    "deepseek_direct": {
      "description": "Direct DeepSeek API substrate (api.deepseek.com/v1) — re-instated 2026-07-09; subject to binding daily budget cap.",
      "script": "_SYSTEM/Scripts/deepseek-fleet.mjs",
      "armEnv": "YURI_DEEPSEEK_DIRECT",
      "armFlag": "_SYSTEM/state/deepseek-direct.enabled",
      "reasoning": "deepseek-v4-pro supports thinking mode (Think Max); deepseek-v4-flash disables",
      "budget": {
        "currency": "USD",
        "dailyCapUsd": 1.25,
        "hardCap": true,
        "warnAtPct": 80,
        "burnLedger": "_SYSTEM/state/deepseek-burn.jsonl"
      },
      "tiers": {
        "flash": {
          "model": "deepseek-v4-flash",
          "use": "cheap direct API; recon + cheap research; thinking disabled",
          "ctx": "200K"
        },
        "pro": {
          "model": "deepseek-v4-pro",
          "use": "heavy reasoning direct API; Think Max enabled; heavy-advisor Tier 2 + sentinel / kernelsmith roles",
          "ctx": "200K"
        }
      }
    },
    "minimax_portal": {
      "description": "MiniMax Portal native binding for M3 (Ultra subscription tier); 1M context + image + video.",
      "binding": "minimax-portal/MiniMax-M3",
      "armEnv": "YURI_MINIMAX_PORTAL",
      "tiers": {
        "m3": {
          "model": "minimax-portal/MiniMax-M3",
          "use": "generalist + cross-modal synthesis + heavy-advisor Tier 2 fallback",
          "ctx": "1M",
          "quota": "minimax-ultra"
        }
      }
    },
    "mure_advisor": {
      "description": "mure-advisor tiered per-turn watchdog substrate (operator-driven).",
      "eligibility": {
        "watcher": ["anthropic/claude-sonnet-5 (prime)", "anthropic/claude-haiku-4-5 (recon/cheap)", "deepseek-v4-flash:direct (capped)"],
        "heavy": ["anthropic/claude-opus-4-8 (anchor + security-only)", "deepseek-v4-pro:direct (capped)", "zai/glm-5.2 (Z.ai quota)", "minimax-portal/MiniMax-M3 (Ultra)"],
        "fallbackChain": ["opus-4-8", "deepseek-v4-pro:direct", "zai/glm-5.2", "minimax-portal/MiniMax-M3"],
        "excluded": ["anthropic/claude-haiku-4-5 at heavy tier (recon/cheap only)", "anthropic/claude-fable-5 (temporarily excluded till 2026-07-12)"]
      },
      "schema": "_SYSTEM/research/advisor-note-schema-2026-07-09.md"
    }
  },
  "retired": {
    "codex": "OWNER-SKIP 2026-07-09: Codex Pro not subscribed yet — skip until owner decides and has the money.",
    "local_ollama": "MacBook cannot run local SLMs in fleet — qwen-local, gemma-local, vibethinker-local forbidden.",
    "direct_deepseek_api": "RE-INSTATE 2026-07-09: was retired 2026-07-06 line in v2.0.0; owner has been using the direct API all along. Roster v2.1.0 adds `deepseek_direct` substrate entry with $1.25/day cap."
  },
  "mureNativeTranslation": {
    "comment": "When MURE emits nativeSpecs with legacy Claude model names, translate to OMP task() under Claude cap.",
    "sonnet": {
      "substrate": "omp_task",
      "agent": "task",
      "role": "Capable generalist — real coding, refactor, integration, analysis, and verification (NOT research/bulk-only; sonnet-4-6 handles substantial implementation work)"
    },
    "haiku": {
      "substrate": "omp_task",
      "agent": "sonic",
      "role": "Mechanical verifier"
    },
    "opus": {
      "substrate": "glm_fleet",
      "lane": "glm-max",
      "note": "orchestrator-only — never spawn opus as leaf"
    }
  }
}
