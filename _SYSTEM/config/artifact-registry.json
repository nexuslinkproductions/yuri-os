    "supersession": "Replacement artifacts must declare supersedes or supersededBy when applicable."
  },
  "artifactTypes": [
    "folder",
    "doc",
    "script",
    "test",
    "config",
    "data",
    "report",
    "runtime_state",
    "external_checkout",
    "model_runtime",
    "skill",
    "wiki_page",
    "generated_artifact",
    "provider_adapter"
