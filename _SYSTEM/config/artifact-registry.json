{
  "schemaVersion": 1,
  "updated": "2026-05-24",
  "purpose": "Master YURI artifact registry seed. This extends folder classification into durable docs, scripts, registries, reports, skills, runtime state, and generated artifacts.",
  "rules": {
    "readByDefault": "Only canonical anchors and context selectors may be read by default.",
    "protected": "Protected paths are never read directly. Registering a protected path is a warning label, not read permission.",
    "creation": "New durable artifacts must choose a storage rule before landing in the repo.",
    "supersession": "Replacement artifacts must declare supersedes or supersededBy when applicable."
  },
  "artifactTypes": [
    "folder",
    "doc",
    "script",
    "test",
    "config",
    "data",
    "report",
    "runtime_state",
    "external_checkout",
    "model_runtime",
    "skill",
    "wiki_page",
    "generated_artifact",
    "provider_adapter"
  ],
  "placementRules": [
    {
      "id": "system-doc",
      "matchPrefix": "_SYSTEM/docs/",
      "artifactType": "doc",
      "class": "system_control_plane",
      "storageRule": "Operating policy, architecture, goals, guardrails, and durable plans live in _SYSTEM/docs/."
    },
    {
      "id": "system-script",
      "matchPrefix": "_SYSTEM/Scripts/",
      "artifactType": "script",
      "class": "system_control_plane",
      "storageRule": "Runtime scripts and script tests live in _SYSTEM/Scripts/."
    },
    {
      "id": "system-config",
      "matchPrefix": "_SYSTEM/config/",
      "artifactType": "config",
      "class": "artifact_registry",
      "storageRule": "Registries, schemas, and machine-readable configuration live in _SYSTEM/config/."
    },
    {
      "id": "context-layer",
      "matchPrefix": "_SYSTEM/context/",
      "artifactType": "doc",
      "class": "context_layer",
      "storageRule": "Context selectors, packet docs, and context routing metadata live in _SYSTEM/context/."
    },
    {
      "id": "wiki-projection",
      "matchPrefix": "_SYSTEM/yuri-wiki/",
      "artifactType": "wiki_page",
      "class": "context_layer",
      "storageRule": "Curated human/RAG-readable projections live in _SYSTEM/yuri-wiki/."
    },
    {
      "id": "runtime-state",
      "matchPrefix": "_SYSTEM/state/",
      "artifactType": "runtime_state",
      "class": "runtime_cache",
      "storageRule": "Runtime state lives in _SYSTEM/state/ and is ignored unless explicitly promoted."
    },
    {
      "id": "report",
      "matchPrefix": "_SYSTEM/reports/",
      "artifactType": "report",
      "class": "generated_artifact",
      "storageRule": "Generated or refreshed reports live in _SYSTEM/reports/."
    },
    {
      "id": "research-archive",
      "matchPrefix": "_SYSTEM/research-archive/",
      "artifactType": "doc",
      "class": "harvest_source",
      "storageRule": "Evidence and research sources live in _SYSTEM/research-archive/ before promotion."
    },
    {
      "id": "tool-checkout",
      "matchPrefix": "_SYSTEM/tools/",
      "artifactType": "external_checkout",
      "class": "external_tool_checkout",
      "storageRule": "Repo-local external tools live in _SYSTEM/tools/ and remain isolated from YURI source truth."
    },
    {
      "id": "skill",
      "matchPrefix": ".agents/skills/",
      "artifactType": "skill",
      "class": "system_control_plane",
      "storageRule": "YURI-owned reusable skills live in .agents/skills/."
    },
    {
      "id": "codex-skill",
      "matchPrefix": ".codex/skills/",
      "artifactType": "skill",
      "class": "provider_adapter",
      "storageRule": "Codex-specific skills live in .codex/skills/ and must not become global policy."
    },
    {
      "id": "active-project",
      "matchPrefix": "01_PROJECTS/",
      "artifactType": "doc",
      "class": "human_workspace",
      "storageRule": "Active project material lives under 01_PROJECTS/<project>/."
    },
    {
      "id": "resource",
      "matchPrefix": "03_RESOURCES/",
      "artifactType": "doc",
      "class": "human_workspace",
      "storageRule": "Durable reusable references live under 03_RESOURCES/."
    },
    {
      "id": "archive",
      "matchPrefix": "07_ARCHIVE/",
      "artifactType": "doc",
      "class": "archive",
      "storageRule": "Inactive historical material lives in 07_ARCHIVE/."
    }
  ],
  "protectedPrefixes": [
    ".env",
    "backend/data/",
    ".claude/state/",
    ".claude/history/",
    "node_modules/",
    ".amp/"
  ],
  "artifacts": [
    {
      "path": "_SYSTEM/yuri-origin.md",
      "type": "doc",
      "class": "canonical_anchor",
      "owner": "YURI",
      "status": "active",
      "readByDefault": true,
      "protected": false,
      "storageRule": "Canonical authority anchor.",
      "rebuildRule": "Manual edit only; verify persona and control-plane tests.",
      "notes": "Primary YURI operating contract."
    },
    {
      "path": "SOUL.md",
      "type": "doc",
      "class": "canonical_anchor",
      "owner": "YURI",
      "status": "active",
      "readByDefault": true,
      "protected": false,
