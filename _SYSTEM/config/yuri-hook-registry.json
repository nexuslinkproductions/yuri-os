{
  "schemaVersion": 1,
  "kind": "yuri-universal-hook-registry",
  "authority": {
    "owner": "YURI",
    "canonicalSource": "This manifest defines logical hook roles and contracts. Harness files are replaceable projections, never policy authorities.",
    "architecture": "MURE-matrix-first",
    "namedTerminalsAreRoles": false,
    "retiredAdapters": [
      "OpenClaw"
    ],
    "retiredAgentSurfaces": [
      ".openclaw/agents",
      ".omp/agents"
    ]
  },
  "rootPolicy": {
    "canonicalRoot": "Git worktree root",
    "discovery": "Resolve from the adapter module URL; rendered Codex commands use git rev-parse --show-toplevel from the session cwd.",
    "cwdIndependentWithinWorktree": true,
    "absoluteCanonicalClonePathsForbidden": true
  },
  "providerMergeContracts": {
    "claude-code": {
      "settingsSources": [
        ".claude/settings.json",
        ".claude/settings.local.json"
      ],
      "mergeRule": "Repository project and project-local hook groups are additive. Health validates their effective repository merge; user-level settings remain outside source validation.",
      "eventOwners": {
        "PreToolUse": "yuri.pre-tool.enforcement",
        "UserPromptSubmit": "october.prompt-context.pull",
        "PostToolUse": "yuri.energy.tick"
      },
      "exactCommandCount": 1,
      "lifecycleLiveness": {
        "inventoryAllHookEvents": true,
        "includeStatusLine": true,
        "executeCommands": false,
        "projectSettingsLifecycle": {
          "source": ".claude/settings.json",
          "status": "mutating-lifecycle-chain-retired-during-recovery",
          "requiredCommandCount": 0,
          "requiredHookEntryCount": 0,
          "statusLineAllowed": false,
          "rule": "The former project-owned SessionStart, tool, stop, and status-line chain is retired during recovery. Do not reactivate it by materializing historical hook files."
        },
        "repoLocalCommands": {
          "mustResolveInsideWorktree": true,
          "mustExist": true,
          "mustBelongToRegisteredDependencyClosure": true,
          "forbiddenPathPrefixes": [
            ".claude/hooks/",
            ".omp/agents/",
            ".openclaw/agents/"
          ]
        },
        "canonicalEventContracts": {
          "PreToolUse": {
            "hookType": "command",
            "matcher": "",
            "maxTimeoutSeconds": 10
          },
          "UserPromptSubmit": {
            "hookType": "command",
            "matcher": "",
            "maxTimeoutSeconds": 5
          },
          "PostToolUse": {
            "hookType": "command",
            "matcher": "",
            "maxTimeoutSeconds": 10
          }
        },
        "externalGeneratedCommands": [
          {
            "contractId": "october.claude.generated-lifecycle",
            "owner": "October",
            "classification": "external-generated-october",
            "source": ".claude/settings.local.json",
            "executable": "node",
            "scriptPath": "~/.october/bus-hook.mjs",
            "required": true,
            "mustExist": true,
            "hookType": "command",
            "matcher": "*",
            "maxTimeoutSeconds": 5,
            "eventModes": {
              "SessionStart": "session-start",
              "Stop": "stop",
              "SessionEnd": "session-end",
              "Notification": "notify"
            }
          }
        ],
        "futureSessionDoctor": {
          "status": "not-active-until-separately-registered-and-reviewed",
          "readOnly": true,
          "bounded": true,
          "failSoft": true,
          "rule": "Any future SessionStart doctor must be a registered dependency with a finite timeout, read only non-protected metadata, emit diagnostics without mutation, and never block session startup."
        }
      },
      "forbiddenLegacyCommands": [
        "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.js\""
      ]
    }
  },
  "liveActivation": {
    "ownerApproved": true,
    "approvedOn": "2026-07-17",
    "status": "config-applied-session-reload-and-trust-verification-required",
    "codex": "Restart or reopen from the worktree, inspect /hooks, and trust exactly one changed root-anchored PreToolUse plus one bounded UserPromptSubmit definition. Never bypass hook trust.",
    "claudeCode": "Use the continuous CLI/PTY settings watcher and inspect /hooks; restart that continuous session only if the Local definitions remain stale.",
    "omp": "Reload the owning OMP session so the universal tool_call adapter replaces the prior bash-only handler.",
    "october": "No restart and no hand edit of ~/.october/bus-hook.mjs. If October regenerates .codex/hooks.json, health must fail until the bounded local overlay is reapplied.",
    "rollback": "Restore only the prior provider commands and activation labels together with their registered hashes; do not replace whole generated lifecycle files."
  },
  "hooks": [
    {
      "hookId": "yuri.pre-tool.enforcement",
      "logicalEvent": "PreToolUse",
      "owner": "YURI",
      "version": 1,
      "coreEntrypoint": "_SYSTEM/Scripts/yuri-hook-adapter.mjs",
      "enabled": true,
      "required": true,
      "optional": false,
      "matcher": "*",
      "inputContract": "Harness-native JSON is normalized into tool name, tool input, cwd, and logical PreToolUse event.",
      "outputContract": "Allow emits nothing. Deny emits the harness-native structured block result.",
      "exitContract": {
        "normal": 0,
        "deniedInHookMode": 0,
        "deniedInCheckMode": 2,
        "runtimeDefect": "Never exit 1; evaluator defects become a structured deny with exit 0."
      },
      "cwdPolicy": "The adapter resolves imports from its own module URL; provider commands must be root-anchored.",
      "dependencyClosure": [
        "_SYSTEM/Scripts/yuri-hook-adapter.mjs",
        "_SYSTEM/Scripts/policy/yuri-safety-core.mjs",
        "_SYSTEM/Scripts/policy/repo-integrity-guard.mjs",
        "_SYSTEM/Scripts/_lib/lane-command-gate.mjs",
        "_SYSTEM/Scripts/url-policy.mjs"
      ],
      "failMode": "fail-closed decision, fail-soft process",
      "protectedScope": "May classify protected path names from hook input; never reads protected contents.",
      "teardown": "Remove only the generated provider projection; shared policy sources remain registered.",
      "sourceRefs": [
        "_SYSTEM/yuri-origin.md",
        "_SYSTEM/config/yuri-hook-registry.json"
      ],
      "providerAdapters": [
        {
          "provider": "claude-code",
          "projection": ".claude/settings.local.json",
          "activation": "active-config-verified-session-reload-required",
          "command": "node \"$CLAUDE_PROJECT_DIR/_SYSTEM/Scripts/yuri-hook-adapter.mjs\" --harness claude",
          "invokedPaths": [
            "_SYSTEM/Scripts/yuri-hook-adapter.mjs"
          ]
        },
        {
          "provider": "codex",
          "projection": ".codex/config.toml",
          "activation": "active-config-verified-session-reload-required",
          "command": "node \"$(git rev-parse --show-toplevel)/_SYSTEM/Scripts/yuri-hook-adapter.mjs\" --harness codex",
          "invokedPaths": [
            "_SYSTEM/Scripts/yuri-hook-adapter.mjs"
          ]
        },
        {
          "provider": "omp",
          "projection": ".omp/hooks/pre/url-safety-guard.js",
          "activation": "active-universal-projection-session-reload-required",
          "command": "OMP HookAPI imports the shared YURI policy and URL cores from the worktree root.",
          "invokedPaths": [
            ".omp/hooks/pre/url-safety-guard.js",
            "_SYSTEM/Scripts/policy/yuri-safety-core.mjs",
            "_SYSTEM/Scripts/url-policy.mjs"
          ]
        }
      ]
    },
    {
      "hookId": "october.prompt-context.pull",
      "logicalEvent": "UserPromptSubmit",
      "owner": "October",
      "wrapperOwner": "YURI",
      "version": 1,
      "coreEntrypoint": "_SYSTEM/Scripts/yuri-hook-adapter.mjs",
      "enabled": true,
      "required": false,
      "optional": true,
      "matcher": "",
      "inputContract": "Pass the harness prompt-event JSON unchanged to October's generated bus hook.",
      "outputContract": "Forward successful October context output; timeout, absence, or transport failure emits nothing.",
      "exitContract": {
        "normal": 0,
        "timeout": 0,
        "delegateError": 0,
        "runtimeDefect": "Never exit 1; this context/telemetry hook is fail-soft."
      },
      "cwdPolicy": "YURI wrapper resolves its own worktree root and invokes the external October generator output with a bounded deadline.",
      "dependencyClosure": [
        "_SYSTEM/Scripts/yuri-hook-adapter.mjs"
      ],
      "failMode": "fail-soft with 1800 ms internal deadline",
      "protectedScope": "Does not inspect protected runtime or secrets; transports the current prompt event to the local October bus.",
      "teardown": "Remove only the generated provider projection. Never edit ~/.october/bus-hook.mjs by hand.",
      "sourceRefs": [
        "_SYSTEM/config/october-capability-registry.json",
        "_SYSTEM/config/yuri-hook-registry.json"
      ],
      "providerAdapters": [
        {
          "provider": "claude-code",
          "projection": ".claude/settings.local.json",
          "activation": "active-config-verified-session-reload-required",
          "command": "node \"$CLAUDE_PROJECT_DIR/_SYSTEM/Scripts/yuri-hook-adapter.mjs\" --delegate-october pre-prompt --timeout-ms 1800",
          "invokedPaths": [
            "_SYSTEM/Scripts/yuri-hook-adapter.mjs",
            "~/.october/bus-hook.mjs"
          ]
        },
        {
          "provider": "codex",
          "projection": ".codex/hooks.json",
          "activation": "external-generated-local-overlay-active-reapply-after-regeneration",
          "command": "node \"$(git rev-parse --show-toplevel)/_SYSTEM/Scripts/yuri-hook-adapter.mjs\" --delegate-october pre-prompt --timeout-ms 1800",
          "invokedPaths": [
            "_SYSTEM/Scripts/yuri-hook-adapter.mjs",
            "~/.october/bus-hook.mjs"
          ]
        }
      ]
    },
    {
      "hookId": "yuri.energy.tick",
      "logicalEvent": "PostToolUse",
      "owner": "YURI",
      "version": 1,
      "coreEntrypoint": "_SYSTEM/Scripts/energy-tick-adapter.mjs",
      "enabled": true,
      "required": false,
      "optional": true,
      "providerActivationRequired": false,
      "matcher": "",
      "inputContract": "One harness PostToolUse JSON object. The adapter consumes only structured transition fields and a bounded, sanitized session identifier.",
      "outputContract": "Emits nothing. When explicitly enabled, appends a privacy-gated energy trace and atomically replaces the bounded session snapshot.",
      "exitContract": {
        "normal": 0,
        "disabled": 0,
        "runtimeError": 0
      },
      "cwdPolicy": "The adapter resolves imports and the default state root from its own module URL; the provider command is worktree-rooted.",
      "dependencyClosure": [
        "_SYSTEM/Scripts/energy-tick-adapter.mjs",
        "_SYSTEM/Scripts/energy-tick-core.mjs",
        "_SYSTEM/Scripts/energy-breaker.mjs",
        "_SYSTEM/Scripts/math/yuri-energy-trace.mjs",
        "_SYSTEM/Scripts/math/yuri-energy.mjs",
        "_SYSTEM/Scripts/math/yuri-energy-config.mjs",
        "_SYSTEM/Scripts/math/yuri-energy-gate-trace.mjs",
        "_SYSTEM/Scripts/math/math-kernel.mjs",
        "_SYSTEM/Scripts/yuri-user.mjs",
        "_SYSTEM/Scripts/claim-ledger.mjs",
        "_SYSTEM/Scripts/claim-cortex.mjs",
        "_SYSTEM/Scripts/claim-integrity-gate.mjs",
        "_SYSTEM/Scripts/artifact-registry.mjs",
        "_SYSTEM/Scripts/_lib/repository-path-presence.mjs",
        "_SYSTEM/Scripts/yuri-truth-promotion-enforcement.mjs",
        "_SYSTEM/Scripts/lane-kernel.mjs",
        "_SYSTEM/SELF/energy-weights.json"
      ],
      "failMode": "fail-soft telemetry; disabled unless YURI_ENERGY_OBSERVABILITY=1",
      "protectedScope": "Classifies protected path names already present in hook input; never opens protected contents or secrets.",
      "teardown": "Remove only the optional provider projection. Preserve the registered core and historical traces; never revive .claude/hooks.",
      "sourceRefs": [
        "_SYSTEM/Scripts/energy-tick-core.mjs",
        "_SYSTEM/docs/energy-gate-runbook.md",
        "_SYSTEM/config/yuri-hook-registry.json"
      ],
      "providerAdapters": [
        {
          "provider": "claude-code",
          "projection": ".claude/settings.local.json",
          "activation": "registered-projection-not-applied",
          "command": "node \"$CLAUDE_PROJECT_DIR/_SYSTEM/Scripts/energy-tick-adapter.mjs\"",
          "invokedPaths": [
            "_SYSTEM/Scripts/energy-tick-adapter.mjs"
          ]
        }
      ]
    }
  ],
  "legacyInventory": [
    {
      "surface": ".claude/settings.json project lifecycle and statusLine chain",
      "status": "mutating-lifecycle-chain-retired-during-recovery",
      "rule": "Project settings contain zero lifecycle commands during recovery. PreToolUse and UserPromptSubmit are projected exactly once through .claude/settings.local.json. The repository-owned PostToolUse energy adapter is registered there as an optional, not-yet-applied projection; a future SessionStart doctor must be separately registered, read-only, bounded, and fail-soft."
    },
    {
      "surface": ".claude/hooks/user-prompt-submit.js and historical PreToolUse implementations",
      "status": "unregistered-legacy-implementation",
      "rule": "Do not revive these files as active provider registrations. Migrate any still-needed logical behavior explicitly into the universal registry and shared adapter."
    },
    {
      "surface": ".codex/hooks/pre-tool-use.mjs",
      "status": "compatibility-shim",
      "rule": "May delegate to the universal adapter; project activation should invoke the universal adapter with a worktree-rooted command."
    },
    {
      "surface": ".codex/hooks.json",
      "status": "external-generated-lifecycle-projection-with-bounded-local-overlay",
      "rule": "October owns the lifecycle projection. YURI replaces only the raw UserPromptSubmit command with its bounded wrapper; health must detect and reapply that overlay if October regenerates the file. Other October endpoints remain unchanged."
    },
    {
      "surface": ".omp/hooks/pre/url-safety-guard.js",
      "status": "active-provider-projection-universal",
      "rule": "Routes every OMP tool event through shared YURI safety, then applies URL policy only to normalized shell tools. It is a replaceable provider adapter, not a logical-role authority."
    },
    {
      "surface": ".openclaw/agents and .omp/agents",
      "status": "retired-agent-authority-surfaces",
      "rule": "Neither historical surface may regain MURE role, model-route, or orchestration authority."
    },
    {
      "surface": "_SYSTEM/Scripts/yuri-merge-settings.mjs",
      "status": "transitional-installer",
      "rule": "Preserve additive/idempotent user-setting merge behavior; migrate its YURI source input to registry rendering in a separately reviewed installer change."
    },
    {
      "surface": "_SYSTEM/Scripts/golden-path.test.mjs",
      "status": "registry-aware",
      "rule": "The S1-to-S2 test validates the universal manifest and adapter, not sparse-absent historical Claude hook files."
    },
    {
      "surface": "~/.october/bus-hook.mjs",
      "status": "external-generated-delegate",
      "rule": "October owns and regenerates this file. YURI may bound it but must not hand-edit it."
    }
  ],
