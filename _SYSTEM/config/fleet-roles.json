  "meta": {
    "name": "MURE",
    "kanji": "群れ",
    "gloss": "a flock / school / swarm — collective intelligence, after Sakana (魚, fish)",
    "version": "1.0.0",
    "created": "2026-06-22",
    "modeledOn": "Sakana.ai operating model — functional archetypes, never impersonations",
    "topology": "STAR + shared blackboard (.claude/jobs/<run>/results/*.json)",
    "substrates": {
      "native": "Anthropic Claude Agents (Agent tool) — opus/sonnet/haiku; writes, native tools, commit discipline; bills Claude weekly pool",
      "glm": "z.ai GLM lanes via runSwarm/glmFleet — glm-max/glm/glm-flash/glm-sub-orch; breadth, 1M ctx, zero-Anthropic-spend; bills z.ai plan"
    },
    "autonomyClasses": {
      "self-governable": "default-decides + executes when the 6-gate charter all-passes (reversible · evidence-decidable · in-doctrine · blast<=MEDIUM · not-outward · not-contended)",
      "owner-gated": "default produces a finished ruling and HOLDS for one-token owner confirm"
    },
    "governance": "_SYSTEM/mure/governance.mjs (the 6-gate charter, deterministic, not LLM-judged)",
    "mathBridge": "_SYSTEM/mure/math-bridge.mjs (cross-references decision-sim / quantum / energy / prediction-ledger)",
    "disarmedByDefault": true,
    "armNote": "self-goal-setting + autonomous dispatch are BUILT but DISARMED; arming is owner-gated (YURI_MURE_ARMED + _SYSTEM/state/mure.enabled)"
  },
