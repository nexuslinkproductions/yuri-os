{
  "version": "2026-05-05.trading-bot.v1",
  "repo_root": "/Users/marcelspatz/YURI-OS-MUSUBI",
  "mode": "scoped_mutation_trading_bot",
  "description": "Mutation policy for trading bot Phase 0-2 implementation: allows file creation/write in .claude/trading-bot only",
  "allowed_mutation_paths": [
    ".claude/trading-bot/**",
    ".claude/trading-bot-logs/**"
  ],
  "allowed_write_extensions": [
    ".md",
    ".json",
    ".jsonl",
    ".js",
    ".mjs",
    ".ts",
    ".yaml",
    ".yml",
    ".csv"
  ],
  "forbidden_mutation_paths": [
    ".env",
    ".git",
    "backend/data",
    ".claude/history",
    ".claude/state",
    ".claude/cache",
    "node_modules",
    "package.json",
    "package-lock.json"
  ],
  "allowed_files_read": [
    "package.json",
    "_SYSTEM/Scripts/ai",
    "_SYSTEM/Scripts/offload.sh",
    "_SYSTEM/Scripts/offload-runner.mjs",
    "_SYSTEM/Scripts/nudimmud-repl.mjs",
    "_SYSTEM/Scripts/yuri-guarded-executor.mjs",
    ".claude/rules/nudimmud_operating_dna.md",
    ".claude/rules/research_pipeline.md",
    ".claude/rules/local_execution.md"
  ],
  "allowed_commands": [
    "mkdir",
    "touch",
    "echo",
    "cat",
    "pwd",
    "git_status_scoped",
    "git_branch_show_current",
    "ls_path",
    "wc_l_file",
    "grep_file",
    "node_check_script"
  ],
  "forbidden_commands": [
    "rm",
    "rm -rf",
    "sudo",
    "chmod",
    "chown",
    "docker",
    "pip",
    "npm install",
    "git push",
    "git reset --hard",
    "git checkout ."
  ],
  "allowed_actions": [
    "CREATE_FILE",
    "WRITE_FILE",
    "CREATE_DIRECTORY",
    "READ_FILE",
    "RUN_SCOPED_COMMAND",
    "VALIDATE_STRUCTURE"
  ],
  "denied_actions": [
    "DELETE_FILE",
    "DELETE_DIRECTORY",
    "MODIFY_GIT",
    "COMMIT",
    "PUSH",
    "READ_SECRET",
    "READ_DB",
    "MCP_CALL",
    "SUBAGENT_CALL"
  ],
  "caps": {
    "max_file_size_bytes": 102400,
    "max_files_per_action": 10,
    "max_command_output_chars": 2000
  }
}
