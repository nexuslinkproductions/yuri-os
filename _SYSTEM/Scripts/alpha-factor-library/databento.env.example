# Databento credential template — ORDERFLOW-QUANT P1
#
# DO NOT put your real key in THIS file (it is tracked in git).
# Instead, either:
#   1) export it in your shell (ephemeral, nothing on disk):
#        export DATABENTO_API_KEY='db-XXXXXXXXXXXXXXXX'
#   2) copy this file to  databento.secrets  (gitignored via *.secrets) and fill the key:
#        cp databento.env.example databento.secrets
#        # then edit databento.secrets and replace the placeholder
#
# The key is generated instantly at https://databento.com after signup (no OAuth).
# It is read from the DATABENTO_API_KEY env var by the SDK (db.Historical()).
DATABENTO_API_KEY=db-REPLACE_ME
