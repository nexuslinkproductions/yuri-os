#!/usr/bin/env bash

set -euo pipefail

# ── Key hydration (runs before any node exec — same pattern as offload.sh) ──
# shellcheck source=/dev/null
[ -f "$HOME/.config/yuri/env.sh" ] && source "$HOME/.config/yuri/env.sh"
if [ -f "$HOME/.zshrc" ]; then
  for _lane_var in DEEPSEEK_API_KEY CODE_DEEPSEEK_API_KEY KIMI_API_KEY MOONSHOT_API_KEY OPENROUTER_API_KEY NVIDIA_API_KEY OPENAI_API_KEY OLLAMA_API_KEY OLLAMA_CLOUD_API_KEY; do
    if [ -z "${!_lane_var:-}" ]; then
      _line="$(grep -E "^export ${_lane_var}=" "$HOME/.zshrc" | tail -n 1 || true)"
      [ -n "$_line" ] && eval "$_line"
    fi
  done
  unset _lane_var _line
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${ROOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
OFFLOAD_RUNNER="$SCRIPT_DIR/offload-runner.mjs"
OFFLOAD_CONTRACT="$SCRIPT_DIR/offload-contract.mjs"

usage() {
  cat <<'EOF'
Usage: ai <command> [prompt]

Commands:
  code|vscode|open [path]
      Open a path in VS Code. Defaults to the current directory.

  claude
      Start Claude in safe interactive mode (Agent and scouts disabled).

  claude-full
      Start raw Claude interactively with full tool and scout behavior.

  codex [prompt]
      Start Codex interactively, or run a one-shot prompt with codex exec.

  @codex|@gpt-5.5 [prompt]
      Run Codex full implementation lane with gpt-5.5.

  @codex-mini|@gpt-5.4-mini [prompt]
      Run Codex mini implementation/review lane with gpt-5.4-mini.

  btw [prompt]
      Route a live steering hint to the best lane, local first.

  moonshot [prompt]
      Route directly to the Moonshot cloud lane (deprecated compatibility).

  offload [options] [prompt]
      Route through the YURI offload system (auto, --model, --swarm, --list, --dry-run, --route-only).

  offload swarm [prompt]
      Run offload swarm with the shared default workhorse lane set.

  offload capabilities
      Print the full lane and model inventory (JSON).

  swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out GPT-OSS as needed.

  doctor
      Check that the launcher and offload entrypoints are available.

  route [prompt]
      Print the lane that btw would choose without executing it.

  route-plan [prompt]
      Print the automatic route, scenario, lifecycle, and learning capture plan (JSON).

  route-examples
      Print embedded end-to-end routing scenarios (JSON).

  search|find "<query>" [--top N] [--json]
      Corpus full-text search (FTS5/BM25) over ~26k docs/code. Finds things on demand.
      This is SEARCH, not memory — results are file+snippet, never auto-injected.

  reindex|search-index [--full]
      Build/refresh the corpus search index (_SYSTEM/OS_KERNEL/search-index.db).

  auto [prompt]
      Automatically classify, dispatch, and execute through the shared contract.

  sandbox [prompt]
      Run the Yuri sandbox improvement loop live and write artifact-only reports.

  @kimi [prompt]
      Deprecated compatibility route to the Kimi cloud offload lane.

  @gpt-oss [prompt]
      Run the direct GPT-OSS local offload lane.

  @codex-spark|@spark|@fast-codex [prompt]
      Run the bounded Codex Spark offload lane (gpt-5.3-codex-spark).

  @nvidia [prompt]
      Run the default NVIDIA NIM lane (meta/llama-3.3-70b-instruct). Tools default ON.

  @nvidia-llama-405b [prompt]
      Run NVIDIA NIM with meta/llama-3.1-405b-instruct.

  @nvidia-nemotron [prompt]
      Run NVIDIA NIM with nvidia/llama-3.1-nemotron-70b-instruct.

  nemotron --task <string|@file> --files <comma,list> [--handles <string|@file>] [--briefing <@file>] [--dry-run]
      Assemble the YURI framework preamble, symbol inventory, and advisory dispatch for nvidia/nemotron-3-ultra-550b-a55b.

  ds-reason --task <string|@file> --files <comma,list> [--handles <string|@file>] [--briefing <@file>] [--dry-run]
      Disciplined DeepSeek adapter (framework preamble, symbol inventory, Track-A handles, falsifier extraction) for deepseek-v4-pro. NOTE: '@deepseek' is the RAW cloud lane with no discipline wrapper; 'ds-reason' adds the wrapper on top of the same lane.

  @nvidia-mistral [prompt]
      Run NVIDIA NIM with mistralai/mistral-large-2-instruct.

  @nvidia-qwen [prompt]
      Run NVIDIA NIM with qwen/qwen2.5-72b-instruct.

  @nvidia-phi [prompt]
      Run NVIDIA NIM with microsoft/phi-4.

  @deepseek [prompt]
      Run the default DeepSeek cloud lane. Local DeepSeek is frozen.

  @deepseek-v4-flash [prompt]
      Run the official DeepSeek V4 Flash lane. Tool/skill intent belongs in the prompt contract.

  @deepseek-v4-pro [prompt]
      Run the official DeepSeek V4 Pro lane. Add reasoning depth in the prompt or use offload.sh --reasoning.

  @triage-local [prompt]
      Run the triage-local lane (fast lightweight local model).

  @summarize-local [prompt]
      Run the summarize-local lane (summarization-optimized local model).

  @code-local [prompt]
      Run the code-local lane (code-specialized local model, prefers qwen2.5-coder).

  @ollama [prompt]
      Run additive Ollama auto lane (local first, cloud fallback only if configured).

  @ollama-local [prompt]
      Run additive local Ollama utility lane for private, bounded low-risk work.

  @ollama-cloud [prompt]
      Run additive Ollama Cloud fallback lane using OLLAMA_API_KEY.

  @reason-kimi [prompt]
      Deprecated compatibility route for Kimi reasoning (cloud, thinking enabled).

  @deepseek-workhorse [prompt]
      Run DeepSeek workhorse swarm (cloud): shared workhorse pair from Scripts/offload-contract.mjs.
      Supports --dry-run / --route-only to preview lanes without live API calls.
      Read-only routing only. No write, patch, stage, or commit capability.

  @claude [prompt]
      Run the bounded Claude Sonnet council lane with advisory-only output.

  @claude-sonnet-code [prompt]
      Run Claude Sonnet xhigh as a bounded coding lane. Edits allowed, no commit/push.

  @claude-opus-comain [prompt]
      Wake Claude with Haiku, then run Opus 4.7 as bounded co-main coding/reasoning lane.

  @claude-opus-audit [prompt]
      Compatibility alias for @claude-opus-comain.

  @claude-opus-design-edit [prompt]
      Run Sonnet xhigh context pass, then Opus 4.7 high-reasoning bounded design edit.

  @reason-cloud [prompt]
      Run the reason-cloud lane (Ollama Cloud reasoning, defaults to qwen2.5:72b).

  @code-cloud [prompt]
      Run the code-cloud lane (Ollama Cloud code, defaults to qwen2.5-coder:32b).

  @gemma [prompt]
      Run the gemma lane (cloud-first if OLLAMA_API_KEY set, local Gemma4 fallback).

  @gemma-local [prompt]
      Run the gemma-local lane (local Gemma4 only, no non-Gemma fallback).

  @gemma-cloud [prompt]
      Run the gemma-cloud lane (Ollama Cloud Gemma4 only).

  @swarm [prompt]
      DEPRECATED — parallel swarm fan-out is retired. Use the native Opus Workflow tool for
      fan-out, or '@deepseek <prompt>' for a single advisory lane.

  ruflo [prompt]
      Ask Ruflo for routing guidance without executing the routed lane.

  triage [prompt]
      Run active review lanes in parallel: Claude if available, Codex, and a single DeepSeek advisory.

  cortex|pulse|pulse-status
      Print Pulse Cortex self-inspection status.

  soak|trivial-audit|pulse-soak
      Run the Pulse soak audit against pulse-hook telemetry.

Examples:
  ai code .
  ai claude
  ai claude-full
  ai codex "Find the riskiest file in backend/src"
  ai btw "offload this review"
  ai moonshot "deep architecture review"
  ai swarm "review this branch"
  ai doctor
  ai route "offload swarm proceed"
  ai route-plan "fix the failing api test"
  ai auto "fix the failing api test"
  ai sandbox "first Yuri sandbox operational proving run"
  ai @deepseek-workhorse "Summarize this branch"
  ai @swarm "Review the auth flow"
  ai triage "What should I change first?"
  ai ruflo "Route this feature"
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 127
  fi
}

offload_contract() {
  local subcommand="$1"
  shift || true
  require_cmd node
  node "$OFFLOAD_CONTRACT" "$subcommand" "$@"
}

run_claude_safe() {
  local _claude_bin="${CLAUDE_BIN:-claude}"
  local _claude_model="${YURI_CLAUDE_MODEL:-${YURI_MODEL:-sonnet}}"
  local _claude_effort="${YURI_CLAUDE_EFFORT:-max}"
  require_cmd "$_claude_bin"
  YURI_DISABLE_SCOUTS=1 exec "$_claude_bin" \
    --model "$_claude_model" \
    --effort "$_claude_effort" \
    --permission-mode default \
    --disallowed-tools Agent,TaskCreate,WebSearch,WebFetch \
    --tools Read,Write,Edit,MultiEdit,Bash,Glob,Ls,TodoRead,TodoWrite \
    "$@"
}

claude_prompt_not_allowed() {
  local route="${1:-claude}"
  printf '%s\n' "Claude prompt route disabled: ${route}" >&2
  printf '%s\n' "Use one continuous Claude CLI session through Kagami/tmux/PTY instead." >&2
  printf '%s\n' "Forbidden here: Claude SDK, claude -p, --print, --no-session-persistence prompt calls." >&2
  printf '%s\n' "Launch interactively with: _SYSTEM/Scripts/ai claude" >&2
  return 64
}

build_claude_council_prompt() {
  local prompt="$1"
  cat <<EOF
You are Claude Sonnet in the Yuri OS model council.

Role: architecture/risk/protocol reviewer only.
Authority: advisory_only=true; local_truth_claim=false; Codex/main session remains executor, verifier, and final authority.
Bounds: max 80 lines. Do not propose protected writes, staging, commits, broad repo scans, secrets access, DB reads, or scope expansion.
Evidence rule: every repo-state claim needs exact file/path evidence supplied in the prompt or must be marked unverified.

Return exactly these sections:
findings:
risks:
upgrade_candidates:
tests_needed:
reject_or_accept_reasoning:

Task:
$prompt
EOF
}

emit_claude_advisory_output() {
  local stdout_file="$1"
  local stderr_file="$2"
  local status="$3"
  local line_cap="${CLAUDE_COUNCIL_LINE_CAP:-80}"
  local capped cap_marker stdout_sha stderr_sha stdout_lines stderr_bytes

  if ! [[ "$line_cap" =~ ^[0-9]+$ ]]; then
    line_cap=80
  fi
  if [ "$line_cap" -gt 200 ]; then
    line_cap=200
  fi

  capped="$(head -n "$line_cap" "$stdout_file" 2>/dev/null || true)"
  stdout_lines="$(printf '%s' "$capped" | wc -l | tr -d ' ')"
  cap_marker="FULL"
  if [ "$(wc -l < "$stdout_file" | tr -d ' ')" -gt "$line_cap" ]; then
    cap_marker="TRUNCATED"
  fi
  stdout_sha="$(printf '%s' "$capped" | shasum -a 256 | awk '{print $1}')"
  stderr_sha="$(shasum -a 256 "$stderr_file" 2>/dev/null | awk '{print $1}')"
  stderr_bytes="$(wc -c < "$stderr_file" 2>/dev/null | tr -d ' ')"

  printf '# ADVISORY_CLAUDE_COUNCIL_OUTPUT\n'
  printf '# lane: @claude\n'
  printf '# model: %s\n' "${YURI_CLAUDE_COUNCIL_MODEL:-claude-sonnet-4-6}"
  printf '# reasoning: %s\n' "${YURI_CLAUDE_COUNCIL_EFFORT:-xhigh}"
  printf '# advisory_only=true\n'
  printf '# local_truth_claim=false\n'
  printf '# codex_final_authority=true\n'
  printf '# required_sections=findings,risks,upgrade_candidates,tests_needed,reject_or_accept_reasoning\n'
  printf '# stdout_sha256: %s\n' "$stdout_sha"
  printf '# stdout_lines: %s\n' "$stdout_lines"
  printf '# stdout_cap_marker: %s\n' "$cap_marker"
  printf '# stderr_sha256: %s\n' "${stderr_sha:-}"
  printf '# stderr_bytes: %s\n' "${stderr_bytes:-0}"
  printf '# exit_code: %s\n' "$status"
  printf '# NOT_LOCAL_TRUTH\n\n'
  printf '%s\n' "$capped"
}

run_claude_safe_prompt() {
  local prompt="$1"
  (void_prompt="$prompt"; unset void_prompt)
  claude_prompt_not_allowed "@claude"
}

build_claude_sonnet_code_prompt() {
  local prompt="$1"
  cat <<EOF
You are Claude Sonnet in the Yuri OS bounded coding lane.

Role: implementation partner for scoped code, tests, refactors, docs-to-code translation, and cleanup.
Authority: coding_allowed=true; local_truth_claim=false until verified; Codex/main remains release gate and final verifier.
Bounds: edit only files clearly required by the task. No commits, no pushes, no protected paths, no secrets, no destructive commands, no unauthorized offensive activity. For cybersecurity work, owned/authorized labs only.
Quality bar: make minimal coherent edits, add or update focused tests when behavior changes, and run the cheapest relevant verification you can.
Failsafe: inspect your own diff before finishing. Name assumptions, changed files, tests run, and what Codex must double-check.

Return exactly these sections:
summary:
changed_files:
tests_run:
risks:
codex_double_check_required:

Task:
$prompt
EOF
}

run_claude_sonnet_code_prompt() {
  local prompt="$1"
  (void_prompt="$prompt"; unset void_prompt)
  claude_prompt_not_allowed "@claude-sonnet-code"
}

