    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_llm_lane gemma-local "$@"
    ;;
  @gemma-cloud|gemma-cloud)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_llm_lane gemma-cloud "$@"
    ;;
  @swarm|swarm)
    shift || true
    printf '%s\n' "⬡ @swarm is retired. Fan-out is replaced by the native Opus Workflow tool; for a single advisory lane use '@deepseek <prompt>' or '@codex <prompt>'." >&2
    exit 0
    ;;
  ruflo)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
      printf 'ruflo\n'
      exit 0
    fi
    run_ruflo_route "$prompt"
    ;;
  triage|research)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_triage "$prompt"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
