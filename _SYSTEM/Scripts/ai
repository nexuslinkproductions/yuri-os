  local prompt="$1"
  cat <<EOF
You are Claude Opus in the Yuri OS Shintai co-main lane.

Role: second owner/main for architecture, coding, tests, contradiction synthesis, and long-context continuity.
Authority: co_main=true; local_truth_claim=false until verified; Codex/main remains final release gate after independent verification.
Bounds: repo-scoped read/write/edit and Bash are allowed only for the named task and allowed files. No commits, no pushes, no protected paths, no destructive commands, no secrets, no unauthorized offensive activity. Offensive cybersecurity work is owned/authorized lab-only.
Failsafe: double-check your own output and explicitly name what Codex must verify. Also challenge Codex proposals when they are vague, untested, or unsafe.
Evidence rule: every repo-state claim needs supplied evidence or must be marked unverified.

Return exactly these sections:
findings:
contradictions:
missed_context:
implementation_or_patch_plan:
edits_made_or_patch_suggestions:
tests_run_or_needed:
risks_and_rails:
codex_double_check_required:

Task:
$prompt
EOF
}

run_claude_opus_audit_prompt() {
  local prompt="$1"
  (void_prompt="$prompt"; unset void_prompt)
  claude_prompt_not_allowed "@claude-opus-comain"
}

build_claude_design_context_prompt() {
  local prompt="$1"
  cat <<EOF
You are Claude Sonnet in the Yuri OS design context lane.

Role: context gathering and design brief sharpening only.
Authority: advisory_only=true; no edits; no commits; no protected paths.
Use only the supplied task and embedded design contract. Do not call tools.

Embedded design contract:
- YURI has separate surfaces: HUD is operator/mechanical; Kagami is cinematic/editorial/reflective.
- This task is Kagami, not HUD.
- Kagami presentations must be continuous authored objects, not slide decks or dashboards.
- The user's durable preferences for this artifact: no HUD, no slide deck, not logbook-like, fewer boxes/cards, more typography/path/mirror/motion, varied section layouts, visible scroll/camera choreography, Japanese structure without garnish.
- Design Master must select from the full YURI skill tree: frontend-design, math-curve-loaders, pattern-mirror-core/sharingan when inspecting artifacts, design-source-pack when extracting reusable language, and prompt-engineering for lane contracts.

Required output:
brief:
must_keep:
must_remove:
design_sources_to_use:
opus_edit_constraints:

Task:
$prompt
EOF
}

build_claude_opus_design_edit_prompt() {
  local prompt="$1"
  local context="$2"
  cat <<EOF
You are Claude Opus in the Yuri OS design edit lane.

Objective: directly edit the requested YURI design artifact so it matches the user's stated visual taste and the YURI Kagami design system.

Authority and boundaries:
- You may edit only the exact target files named in the task.
- Do not commit, stage, push, install dependencies, read protected paths, or expand scope.
- Do not use Agent, WebSearch, or WebFetch.
- Prefer Edit/MultiEdit over broad rewrites unless the target file is explicitly a standalone HTML artifact.
- If something is uncertain, make the strongest reversible local design improvement and explain the choice.

Design contract:
- Surface is Kagami, not HUD.
- The artifact must be one continuous cinematic presentation, not a slide deck and not a logbook.
- No HUD system, status bars, dashboard grids, or operator panels.
- Reduce boxed/card-heavy information. Use open typography, path, line, mask, mirror geometry, spacing, and motion to group meaning.
- Avoid identical layouts section after section.
- Use Japanese layout principles structurally: ma, asymmetry, vertical rhythm, seal/mirror geometry.
- Add visible motion design: scroll choreography, camera movement, parallax, mask/text reveals, and reduced-motion fallback.
- Use the full YURI design system and Design Master skill, not just generic frontend design.
- Preserve readability and avoid text overlap at desktop and mobile.

Sonnet context pass:
$context

Task:
$prompt

After editing, return:
changed_files:
design_decisions:
verification_to_run:
EOF
}

run_claude_opus_design_edit_prompt() {
  local prompt="$1"
  (void_prompt="$prompt"; unset void_prompt)
  claude_prompt_not_allowed "@claude-opus-design-edit"
}

run_claude_full() {
  local _claude_bin="${CLAUDE_BIN:-claude}"
  local _claude_model="${YURI_CLAUDE_MODEL:-${YURI_MODEL:-sonnet}}"
  local _claude_effort="${YURI_CLAUDE_EFFORT:-max}"
  require_cmd "$_claude_bin"
  exec "$_claude_bin" --model "$_claude_model" --effort "$_claude_effort" "$@"
}

join_prompt() {
  printf '%s' "$*"
}

print_section() {
  local title="$1"
  local file="$2"
  printf '\n[%s]\n' "$title"
  if [ -s "$file" ]; then
    sed -n '1,220p' "$file"
  else
    echo "(no output)"
  fi
}

print_route_section() {
  local title="$1"
  local file="$2"
  if [ -s "$file" ]; then
    printf '\n[%s route]\n' "$title"
    sed -n '1,220p' "$file"
  fi
}

cleanup_tmpdir() {
  local path="${1:-}"
  if [ -n "$path" ] && [ -d "$path" ]; then
    rm -rf -- "$path"
  fi
}

run_triage() {
  local prompt="$1"
  local tmpdir="" claude_out claude_err offload_out offload_err codex_out codex_err
  local pid_claude="" pid_offload="" pid_codex="" status has_claude=0

  require_cmd codex
  if command -v "${CLAUDE_BIN:-claude}" >/dev/null 2>&1; then
    has_claude=1
  fi

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-triage.XXXXXX")"
  claude_out="$tmpdir/claude.txt"
  claude_err="$tmpdir/claude.route.txt"
  offload_out="$tmpdir/offload-swarm.txt"
  offload_err="$tmpdir/offload-swarm.route.txt"
  codex_out="$tmpdir/codex.txt"
  codex_err="$tmpdir/codex.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  if [ "$has_claude" -eq 1 ]; then
    (
      run_claude_safe_prompt "$prompt" >"$claude_out" 2>"$claude_err"
    ) &
    pid_claude=$!
  else
    printf 'Claude unavailable; skipped dormant provider lane.\n' >"$claude_out"
  fi

  (
    bash "$SCRIPT_DIR/offload.sh" --swarm default "$prompt" >"$offload_out" 2>"$offload_err"
  ) &
  pid_offload=$!

  (
    codex exec --cd "$ROOT_DIR" "$prompt" >"$codex_out" 2>"$codex_err"
  ) &
  pid_codex=$!

  status=0
  if [ -n "$pid_claude" ] && ! wait "$pid_claude"; then
    status=1
  fi
  if ! wait "$pid_offload"; then
    status=1
  fi
  if ! wait "$pid_codex"; then
    status=1
  fi

  print_section "claude" "$claude_out"
  print_route_section "claude" "$claude_err"
  print_section "offload-swarm" "$offload_out"
  print_route_section "offload-swarm" "$offload_err"
  print_section "codex" "$codex_out"
  print_route_section "codex" "$codex_err"

  return "$status"
}

run_codex_offload() {
  local agent="$1"
  shift

  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" "@${agent} $(join_prompt "$@")"
}

run_codex_model_prompt() {
  local model="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"
  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'codex:%s\n' "$model"
    return
  fi
  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" --model "$model" "$prompt"
}

run_amp_offload() {
  shift || true
  printf 'Amp lane retired: use Codex, Shintai, DeepSeek, or validated NIM lanes instead.\n' >&2
  return 64
}

run_offload_lane() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"
  local runner="$OFFLOAD_RUNNER"

  case "$lane" in
    deepseek-cloud|code-deepseek|deepseek-reasoner|deepseek-v4-pro-lite-budget)
      lane="deepseek-v4-pro"
      ;;
    deepseek-chat)
      lane="deepseek-v4-flash"
      ;;
    codex-spark|spark|fast-codex|gpt-5.3-codex-spark)
      runner="$SCRIPT_DIR/codex-offload-runner.mjs"
      lane="codex-spark"
      ;;
  esac

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  require_cmd node
  OFFLOAD_PROMPT_TEXT="$prompt" node "$runner" "$lane"
}

run_kagami_or_fallback() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"

  # If Kagami facade is not enabled, fall through to direct offload
  if [ "${KAGAMI_FACADE_ENABLED:-}" != "1" ]; then
    run_offload_lane "$lane" "$prompt"
    return $?
  fi

  require_cmd node

  local facade_script="$SCRIPT_DIR/kagami-facade.mjs"
  local exit_code=0

  node "$facade_script" --lane "$lane" -- "$prompt" || exit_code=$?

  if [ "$exit_code" -ne 0 ]; then
    # Kagami unreachable or failed — transparent fallback
    run_offload_lane "$lane" "$prompt"
    return $?
  fi

  return 0
}

run_codex_swarm() {
  local prompt="$1"
  local tmpdir="" lane_out lane_err lane
  local swarm_models=""
  local status=0

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    offload_contract swarm-default
    return
  fi

  require_cmd node

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-swarm.XXXXXX")"
  swarm_models="$(offload_contract swarm-default)"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  # Local lanes: serialize to avoid M2 Pro memory contention.
  IFS=',' read -ra _swarm_lanes <<< "$swarm_models"
  for lane in "${_swarm_lanes[@]}"; do
    lane_out="$tmpdir/$lane.txt"
    lane_err="$tmpdir/$lane.route.txt"
    if ! node "$OFFLOAD_RUNNER" "$lane" "$prompt" >"$lane_out" 2>"$lane_err"; then
      status=1
    fi
    print_section "$lane" "$lane_out"
    print_route_section "$lane" "$lane_err"
  done

  return "$status"
}

run_ruflo_route() {
  local prompt="$1"

  if command -v ruflo >/dev/null 2>&1; then
    ruflo hooks route -t "$prompt"
    return
  fi

  require_cmd npx
  npx -y ruflo@latest hooks route -t "$prompt"
}
# Evidence bundle extractor: runs yuri-memory-map for recognized surfaces
run_ruflo_swarm() {
  local prompt="$1"
  local route route_lower

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'ruflo\n'
    return
  fi

  route="$(run_ruflo_route "$prompt" 2>/dev/null || true)"
  route_lower="$(printf '%s' "$route" | tr '[:upper:]' '[:lower:]')"

  if [[ "${AI_TRACE_ROUTING:-0}" == "1" && -n "$route" ]]; then
    printf '\n[ruflo]\n%s\n' "$route"
  fi

  case "$route_lower" in
    *deepseek*)
      run_offload_lane deepseek "$prompt"
      ;;
    *qwen*|*triage*)
      run_offload_lane triage-local "$prompt"
      ;;
    *summarize*)
      run_offload_lane summarize-local "$prompt"
      ;;
    *gpt-oss*|*gptoss*)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *ollama*local*|*local*ollama*)
      run_offload_lane ollama-local "$prompt"
      ;;
    *ollama*cloud*|*cloud*ollama*)
      run_offload_lane ollama-cloud "$prompt"
      ;;
    *ollama*)
      run_offload_lane ollama "$prompt"
      ;;
    *kimi*|*moonshot*)
      run_offload_lane kimi "$prompt"
      ;;
    *swarm*|*parallel*|*fan-out*|*hierarchical*|*hive*)
      run_codex_swarm "$prompt"
      ;;
    *)
      run_codex_swarm "$prompt"
      ;;
  esac
}

run_codex_hint() {
  local prompt="$1"
  local lane
  lane="$(select_btw_lane "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    *)
      run_offload_lane "$lane" "$prompt"
      ;;
  esac
}

run_auto_route() {
  local prompt="$1"
  local plan_json
  local lane

  plan_json="$(offload_contract route-plan "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$plan_json"
    return
  fi

  lane="$(node -e 'const plan=JSON.parse(process.argv[1]); process.stdout.write(plan.lane)' "$plan_json")"

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    *)
      run_kagami_or_fallback "$lane" "$prompt"
      ;;
  esac
}

select_btw_lane() {
  local prompt="$1"
  offload_contract steer "$prompt"
}

check_cmd() {
  local label="$1"
  local bin="$2"

  if command -v "$bin" >/dev/null 2>&1; then
    printf 'ok  %s -> %s\n' "$label" "$(command -v "$bin")"
    return 0
  fi

  printf 'miss %s\n' "$label"
  return 1
}

check_lane() {
  local prompt="$1"
  local expected="$2"
  local lane

  lane="$(select_btw_lane "$prompt")"
  if [ "$lane" = "$expected" ]; then
    printf 'ok  route "%s" -> %s\n' "$prompt" "$lane"
    return 0
  fi

  printf 'miss route "%s" -> %s (expected %s)\n' "$prompt" "$lane" "$expected"
  return 1
}

