  (void_prompt="$prompt"; unset void_prompt)
  claude_prompt_not_allowed "@claude-opus-design-edit"
}

run_claude_full() {
  local _claude_bin="${CLAUDE_BIN:-claude}"
  local _claude_model="${YURI_CLAUDE_MODEL:-${YURI_MODEL:-sonnet}}"
  local _claude_effort="${YURI_CLAUDE_EFFORT:-max}"
  require_cmd "$_claude_bin"
  exec "$_claude_bin" --model "$_claude_model" --effort "$_claude_effort" "$@"
}

join_prompt() {
  printf '%s' "$*"
}

run_claude_mimo() {
  local _claude_bin="${CLAUDE_BIN:-claude}"
  local _mimo_key="${MIMO_API_KEY:-}"
  local _mimo_url="https://token-plan-ams.xiaomimimo.com/anthropic"
  require_cmd "$_claude_bin"
  if [ -z "$_mimo_key" ]; then
    printf 'ERROR: MIMO_API_KEY not set.\nStore it: security add-generic-password -U -a "$USER" -s yuri-mimo-api-key -w "tp-..."\n' >&2
    exit 1
  fi
  ANTHROPIC_BASE_URL="$_mimo_url" \
  ANTHROPIC_AUTH_TOKEN="$_mimo_key" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="mimo-v2.5-pro[1m]" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="mimo-v2.5[1m]" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="mimo-v2-flash" \
  ANTHROPIC_MODEL="mimo-v2.5-pro[1m]" \
  exec "$_claude_bin" --model "mimo-v2.5-pro[1m]" --effort max "$@"
}

print_section() {
  local title="$1"
  local file="$2"
  printf '\n[%s]\n' "$title"
  if [ -s "$file" ]; then
    sed -n '1,220p' "$file"
  else
    echo "(no output)"
  fi
}

print_route_section() {
  local title="$1"
  local file="$2"
  if [ -s "$file" ]; then
    printf '\n[%s route]\n' "$title"
    sed -n '1,220p' "$file"
  fi
}

cleanup_tmpdir() {
  local path="${1:-}"
  if [ -n "$path" ] && [ -d "$path" ]; then
    rm -rf -- "$path"
  fi
}

run_triage() {
  local prompt="$1"
  local tmpdir="" claude_out claude_err llm_compat_out llm_compat_err codex_out codex_err
  local pid_claude="" pid_llm="" pid_codex="" status has_claude=0

  require_cmd codex
  if command -v "${CLAUDE_BIN:-claude}" >/dev/null 2>&1; then
    has_claude=1
  fi

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-triage.XXXXXX")"
  claude_out="$tmpdir/claude.txt"
  claude_err="$tmpdir/claude.route.txt"
  llm_compat_out="$tmpdir/llm-swarm.txt"
  llm_compat_err="$tmpdir/llm-swarm.route.txt"
  codex_out="$tmpdir/codex.txt"
  codex_err="$tmpdir/codex.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  if [ "$has_claude" -eq 1 ]; then
    (
      run_claude_safe_prompt "$prompt" >"$claude_out" 2>"$claude_err"
    ) &
    pid_claude=$!
  else
    printf 'Claude unavailable; skipped dormant provider lane.\n' >"$claude_out"
  fi

  (
    bash "$SCRIPT_DIR/llm-compat.sh" --swarm default "$prompt" >"$llm_compat_out" 2>"$llm_compat_err"
  ) &
  pid_llm=$!

  (
    codex exec --cd "$ROOT_DIR" "$prompt" >"$codex_out" 2>"$codex_err"
  ) &
  pid_codex=$!

  status=0
  if [ -n "$pid_claude" ] && ! wait "$pid_claude"; then
    status=1
  fi
  if ! wait "$pid_llm"; then
    status=1
  fi
  if ! wait "$pid_codex"; then
    status=1
  fi

  print_section "claude" "$claude_out"
  print_route_section "claude" "$claude_err"
  print_section "llm-swarm" "$llm_compat_out"
  print_route_section "llm-swarm" "$llm_compat_err"
  print_section "codex" "$codex_out"
  print_route_section "codex" "$codex_err"

  return "$status"
}

run_codex_lane() {
  local agent="$1"
  shift

  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" "@${agent} $(join_prompt "$@")"
}

run_codex_model_prompt() {
  local model="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"
  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'codex:%s\n' "$model"
    return
  fi
  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" --model "$model" "$prompt"
}

run_amp_lane() {
  shift || true
  printf 'Amp lane retired: use Codex, Shintai, DeepSeek, or validated NIM lanes instead.\n' >&2
  return 64
}

run_llm_lane() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"
  # The 3 live reasoning lanes (deepseek/kimi/nemotron) dispatch through the minimal
  # llm-lane.mjs core. codex-spark keeps its own runner. Any other (dead legacy) lane
  # name reaches llm-lane and loud-fails exit 3 (unknown_lane) — correct for a dead lane.
  local runner="$SCRIPT_DIR/llm-lane.mjs"

  case "$lane" in
    deepseek-cloud|code-deepseek|deepseek-reasoner|deepseek-v4-pro-lite-budget)
      lane="deepseek-v4-pro"
      ;;
    codex-spark|spark|fast-codex|gpt-5.3-codex-spark)
      runner="$SCRIPT_DIR/codex-offload-runner.mjs"
      lane="codex-spark"
      ;;
  esac

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  require_cmd node
  LLM_COMPAT_PROMPT_TEXT="$prompt" node "$runner" "$lane"
}

run_kagami_or_fallback() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"

  # If Kagami facade is not enabled, fall through to direct llm-compat dispatch
  if [ "${KAGAMI_FACADE_ENABLED:-}" != "1" ]; then
    run_llm_lane "$lane" "$prompt"
    return $?
  fi

  require_cmd node

  local facade_script="$SCRIPT_DIR/kagami-facade.mjs"
  local exit_code=0

  node "$facade_script" --lane "$lane" -- "$prompt" || exit_code=$?

  if [ "$exit_code" -ne 0 ]; then
    # Kagami unreachable or failed — transparent fallback
    run_llm_lane "$lane" "$prompt"
    return $?
  fi

  return 0
}

run_codex_swarm() {
  local prompt="$1"
  local tmpdir="" lane_out lane_err lane
  local swarm_models=""
  local status=0

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    llm_compat_contract swarm-default
    return
  fi

  require_cmd node

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-swarm.XXXXXX")"
  swarm_models="$(llm_compat_contract swarm-default)"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  # Local lanes: serialize to avoid M2 Pro memory contention.
  IFS=',' read -ra _swarm_lanes <<< "$swarm_models"
  for lane in "${_swarm_lanes[@]}"; do
    lane_out="$tmpdir/$lane.txt"
    lane_err="$tmpdir/$lane.route.txt"
    if ! node "$LLM_COMPAT_RUNNER" "$lane" "$prompt" >"$lane_out" 2>"$lane_err"; then
      status=1
    fi
    print_section "$lane" "$lane_out"
    print_route_section "$lane" "$lane_err"
  done

  return "$status"
}

run_ruflo_route() {
  local prompt="$1"

  if command -v ruflo >/dev/null 2>&1; then
    ruflo hooks route -t "$prompt"
    return
  fi

  require_cmd npx
  npx -y ruflo@latest hooks route -t "$prompt"
}
# Evidence bundle extractor: runs yuri-memory-map for recognized surfaces
run_ruflo_swarm() {
  local prompt="$1"
  local route route_lower

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'ruflo\n'
    return
  fi

  route="$(run_ruflo_route "$prompt" 2>/dev/null || true)"
  route_lower="$(printf '%s' "$route" | tr '[:upper:]' '[:lower:]')"

  if [[ "${AI_TRACE_ROUTING:-0}" == "1" && -n "$route" ]]; then
    printf '\n[ruflo]\n%s\n' "$route"
  fi

  case "$route_lower" in
    *deepseek*)
      run_llm_lane deepseek "$prompt"
      ;;
    *qwen*|*triage*)
      run_llm_lane triage-local "$prompt"
      ;;
    *summarize*)
      run_llm_lane summarize-local "$prompt"
      ;;
    *gpt-oss*|*gptoss*)
      run_llm_lane gpt-oss "$prompt"
      ;;
    *ollama*local*|*local*ollama*)
      run_llm_lane ollama-local "$prompt"
      ;;
    *ollama*cloud*|*cloud*ollama*)
      run_llm_lane ollama-cloud "$prompt"
      ;;
    *ollama*)
      run_llm_lane ollama "$prompt"
      ;;
    *kimi*|*moonshot*)
      run_llm_lane kimi "$prompt"
      ;;
    *swarm*|*parallel*|*fan-out*|*hierarchical*|*hive*)
      run_codex_swarm "$prompt"
      ;;
    *)
      run_codex_swarm "$prompt"
      ;;
  esac
}

run_codex_hint() {
  local prompt="$1"
  local lane
  lane="$(select_btw_lane "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    *)
      run_llm_lane "$lane" "$prompt"
      ;;
  esac
}

run_auto_route() {
  local prompt="$1"
  local plan_json
  local lane

  plan_json="$(llm_compat_contract route-plan "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$plan_json"
    return
  fi

  lane="$(node -e 'const plan=JSON.parse(process.argv[1]); process.stdout.write(plan.lane)' "$plan_json")"

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    *)
      run_kagami_or_fallback "$lane" "$prompt"
      ;;
  esac
}

select_btw_lane() {
  local prompt="$1"
  llm_compat_contract steer "$prompt"
}

check_cmd() {
  local label="$1"
  local bin="$2"

  if command -v "$bin" >/dev/null 2>&1; then
    printf 'ok  %s -> %s\n' "$label" "$(command -v "$bin")"
    return 0
  fi

  printf 'miss %s\n' "$label"
  return 1
}

check_lane() {
  local prompt="$1"
  local expected="$2"
  local lane

  lane="$(select_btw_lane "$prompt")"
  if [ "$lane" = "$expected" ]; then
    printf 'ok  route "%s" -> %s\n' "$prompt" "$lane"
    return 0
  fi

  printf 'miss route "%s" -> %s (expected %s)\n' "$prompt" "$lane" "$expected"
  return 1
}

