#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-commit] npm not found" >&2
  exit 1
fi

echo "[pre-commit] cached diff check"
git diff --cached --check

echo "[pre-commit] offload contract regression"
npm run test:offload-contract --silent

# PATCH 015 — drift gate: block if contract↔dispatch drift detected (excluding legacy)
# Bypass: git commit --no-verify
echo "[pre-commit] offload contract dispatch drift check"
if ! node Scripts/offload-contract-dispatch-check.mjs > /dev/null 2>&1; then
  echo "[pre-commit] ⚠️  Contract-dispatch drift detected." >&2
  echo "[pre-commit]   Run: node Scripts/offload-contract-dispatch-check.mjs (for details)" >&2
  echo "[pre-commit]   Bypass: git commit --no-verify" >&2
  echo "[pre-commit]   Reference: PATCH 015 in .claude/plans/" >&2
  exit 1
fi
