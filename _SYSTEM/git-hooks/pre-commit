#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-commit] cached diff whitespace"
git diff --cached --check

echo "[pre-commit] secret leak scan"
node _SYSTEM/Scripts/secret-leak-scan.mjs

echo "[pre-commit] offload contract dispatch drift"
node _SYSTEM/Scripts/offload-contract-dispatch-check.mjs >/dev/null

echo "[pre-commit] root architecture"
node _SYSTEM/Scripts/root-architecture.test.mjs >/dev/null

echo "[pre-commit] persona contract"
node _SYSTEM/Scripts/yuri-persona-check.mjs >/dev/null

echo "[pre-commit] skill registry"
node _SYSTEM/Scripts/yuri-skill-loader.mjs --validate >/dev/null

echo "[pre-commit] GitNexus staged scope"
node _SYSTEM/Scripts/gitnexus-detect-changes.mjs yuri-os staged >/dev/null

echo "[pre-commit] pass"
