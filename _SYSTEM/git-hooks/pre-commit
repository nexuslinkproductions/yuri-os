#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# When core.hooksPath is absolute (primary _SYSTEM/git-hooks), this dir is the primary checkout's
# hooks — use sibling Scripts for checks that must bind fleet-wide the moment the primary file lands.
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK_SCRIPTS="$(cd "$HOOKS_DIR/../Scripts" && pwd)"

# Marker-only on pass; print captured output on failure (Hermes B2 2026-07-28).
run_quiet() {
  local label="$1"
  shift
  local out rc
  set +e
  out="$("$@" 2>&1)"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "[pre-commit] FAILED: $label (exit $rc)" >&2
    printf '%s\n' "$out" >&2
    exit "$rc"
  fi
}

# FROZEN EVALUATOR GATE — the only freeze layer that travels with the repo.
#
# Doctrine (_SYSTEM/yuri-origin.md -> Loop Discipline) declared FOUR enforcement layers ordered by
# universality. Audited 2026-07-28 by two independent lanes; three of the four did not exist:
#   layer 1  chmod 444        CANNOT be committed. Git encodes only 100644/100755 — there is no
#                             representation for a read-only bit, so it binds one machine and
#                             evaporates on any clone or fresh worktree. Local hygiene, not a layer.
#   layer 2  loop dirty-check EXISTS (atlas-loop.mjs), but only catches UNCOMMITTED eval changes.
#                             Once an edit is committed, worktree == HEAD and the loop accepts it.
#                             It cannot tell a sanctioned evaluator from an unsanctioned one already
#                             baked into HEAD without a separately pinned baseline.
#   layer 3  this check       DID NOT EXIST until now. It is the one that binds every clone.
#   layer 4  harness config   harness-only, never load-bearing.
#
# So this gate is not "extra defence in depth" — before it, commit-time enforcement was zero and the
# doctrine was overclaiming. An agent optimizing a system must not be able to edit the thing that
# scores it; that is the single structural property separating a real improvement loop from an agent
# agreeing with itself.
#
# ESCAPE HATCH is deliberate and loud: legitimate evaluator work exists (construct-validity repair,
# adding a resolver ARM). It must be a conscious act, not a silent one. YURI_EVAL_UNFREEZE=1 states
# intent; per doctrine a construct-validity repair also TERMINATES the current score series and
# forces a re-baseline of every arm.
echo "[pre-commit] frozen evaluator gate"
EVAL_STAGED="$(git diff --cached --name-only -- _SYSTEM/eval || true)"
if [ -n "$EVAL_STAGED" ]; then
  if [ "${YURI_EVAL_UNFREEZE:-0}" != "1" ]; then
    echo "[pre-commit] REJECTED — commit touches the FROZEN EVALUATOR:" >&2
    echo "$EVAL_STAGED" | sed 's/^/    /' >&2
    echo "" >&2
    echo "    _SYSTEM/eval/ holds the scorer and benchmark that grade every candidate." >&2
    echo "    A loop that can edit its own scorer will optimize the scorer, not the system." >&2
    echo "" >&2
    echo "    If this edit is legitimate — a construct-validity repair, or adding a resolver ARM" >&2
    echo "    that changes no scoring math — re-run with:" >&2
    echo "        YURI_EVAL_UNFREEZE=1 git commit ..." >&2
    echo "" >&2
    echo "    A construct-validity repair TERMINATES the score series: re-baseline every arm," >&2
    echo "    record the version break, and treat prior scores as incomparable across it." >&2
    exit 1
  fi
  echo "[pre-commit]   UNFROZEN by YURI_EVAL_UNFREEZE=1 — series break required if scoring changed"

  # SCORE-INVARIANT GATE (owner-approved 2026-07-28, Hermes spec). Only inside this block:
  # eval staged AND explicitly unfrozen. Converts "no scoring math changed" from a commit-message
  # sentence into a checked fact. Non-eval commits never reach here — zero added latency.
  echo "[pre-commit] score-invariant gate"
  # ATOMICITY: the gate measures the WORKTREE scorer but the commit ships the STAGED scorer.
  # Partial staging (old scorer staged, changed scorer left in the worktree) would let a bad
  # commit pass measured against code it does not contain. Refuse when _SYSTEM/eval has BOTH
  # staged and unstaged changes — the commit must be atomic w.r.t. the evaluator.
  UNSTAGED_EVAL="$(git diff --name-only -- _SYSTEM/eval || true)"
  if [ -n "$UNSTAGED_EVAL" ]; then
    echo "[pre-commit] REJECTED — _SYSTEM/eval has BOTH staged and unstaged changes:" >&2
    echo "$UNSTAGED_EVAL" | sed 's/^/    /' >&2
    echo "    The score-invariant gate measures the worktree scorer; a partially staged evaluator" >&2
    echo "    would be verified against code the commit does not contain. Stage or stash the rest." >&2
    exit 1
  fi
  node _SYSTEM/git-hooks/eval-score-invariant.mjs
fi

echo "[pre-commit] cached diff whitespace"
git diff --cached --check

echo "[pre-commit] manifest json validity"
run_quiet "manifest json validity" node "$HOOK_SCRIPTS/manifest-validate.mjs"

echo "[pre-commit] secret leak scan"
node _SYSTEM/Scripts/secret-leak-scan.mjs

echo "[pre-commit] llm-compat contract dispatch drift"
run_quiet "llm-compat contract dispatch drift" node "$HOOK_SCRIPTS/llm-compat-contract-dispatch-check.mjs"

echo "[pre-commit] gitnexus block normalize"
node _SYSTEM/Scripts/gitnexus-block-normalize.mjs

echo "[pre-commit] root architecture"
# Run the hook-adjacent copy so absolute hooksPath binds primary's B-A fix fleet-wide immediately.
# Script resolves scan root via git show-toplevel (this worktree), basename via git-common-dir.
run_quiet "root architecture" node "$HOOK_SCRIPTS/root-architecture.test.mjs"

echo "[pre-commit] persona contract"
run_quiet "persona contract" node "$HOOK_SCRIPTS/yuri-persona-check.mjs"

echo "[pre-commit] skill registry"
run_quiet "skill registry" node _SYSTEM/Scripts/yuri-skill-loader.mjs --validate

echo "[pre-commit] capability registry"
run_quiet "capability registry" node _SYSTEM/Scripts/capability-scan.mjs --check

echo "[pre-commit] GitNexus staged scope"
run_quiet "GitNexus staged scope" node _SYSTEM/Scripts/gitnexus-detect-changes.mjs yuri-os staged

echo "[pre-commit] pass"
