#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-commit] npm not found" >&2
  exit 1
fi

echo "[pre-commit] cached diff check"
git diff --cached --check

echo "[pre-commit] offload contract regression"
npm run test:offload-contract --silent
