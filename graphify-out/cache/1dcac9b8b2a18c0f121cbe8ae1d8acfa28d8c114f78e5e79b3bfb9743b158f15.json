d/terminal-server/src/chat-bridge.js", "source_location": "L231"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "log", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L240"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "warn", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L242"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "log", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L255"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "mkdtempSync", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L337"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "join", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L337"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "tmpdir", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L337"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "replace", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L341"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "join", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L342"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "writeFileSync", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L343"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "from", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L343"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "push", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L344"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "join", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L348"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "map", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L348"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "set", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L362"}, {"caller_nid": "chat_bridge_chatbridge_startsession", "callee": "(async () => {\n      try {\n        console.log(`[chat-bridge] Starting query for session ${sessionId}, agent: ${agentName}, resume: ${sdkSessionId || 'new'}`);\n        console.log(`[chat-bridge] Query options:`, JSON.stringify({ cwd: queryOptions.cwd, agent: queryOptions.agent, resume: queryOptions.resume, allowedTools: queryOptions.allowedTools?.length }, null, 2));\n        const q = sdkQuery({ prompt: finalPrompt, options: queryOptions });\n        console.log(`[chat-bridge] Query created, starting iteration...`);\n\n        for await (const message of q) {\n          if (!session.active) break;\n\n          const eventDetail = message.type === 'stream_event' ? ` event=${message.event?.type} cb=${message.event?.content_block?.type || message.event?.delta?.type || ''}` : '';\n          if (message.type === 'system') {\n            console.log(`[chat-bridge] System message: subtype=${message.subtype}, agent=${message.agent || 'none'}, data=${JSON.stringify(message).slice(0, 200)}`);\n          } else {\n            console.log(`[chat-bridge] Message received: type=${message.type}${eventDetail}`);\n          }\n\n          // Capture SDK session ID from any message that has it\n          if (message.session_id && !session.sdkSessionId) {\n            session.sdkSessionId = message.session_id;\n            if (onMessage) {\n              onMessage({ type: 'session_id', sdkSessionId: message.session_id });\n            }\n          }\n\n          // Auto-detect ticket creation in tool_result blocks.\n          if (message.type === 'user') {\n            const content = message.message?.content || message.content;\n            if (Array.isArray(content)) {\n              for (const block of content) {\n                if (block.type !== 'tool_result') continue;\n                const raw = Array.isArray(block.content)\n                  ? block.content.map(c => (typeof c === 'string' ? c : c?.text || '')).join('\\n')\n                  : (typeof block.content === 'string' ? block.content : '');\n                const ticketId = detectCreatedTicketId(raw);\n                if (ticketId) {\n                  console.log(`[chat-bridge] \u2713 Detected ticket creation: ${ticketId} \u2014 auto-binding to session ${sessionId}`);\n                  if (onMessage) {\n                    onMessage({ type: 'ticket_detected', ticketId });\n                  }\n                }\n              }\n            }\n          }\n\n          if (onMessage) {\n            onMessage(this._transformMessage(message));\n          }\n        }\n        console.log(`[chat-bridge] Query iteration finished for session ${sessionId}`);\n\n        session.active = false;\n        this.sessions.delete(sessionId);\n        if (onComplete) onComplete({ sdkSessionId: session.sdkSessionId });\n      } catch (err) {\n        console.error(`[chat-bridge] Error in session ${sessionId}:`, err.message || err);\n        session.active = false;\n        this.sessions.delete(sessionId);\n        if (err.name === 'AbortError') {\n          if (onComplete) onComplete({ sdkSessionId: session.sdkSessionId });\n        } else {\n          if (onError) onError(err);\n        }\n      }\n    })", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L365"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "get", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L435"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "values", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L442"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "resolve", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L443"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "clear", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L445"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "abort", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L448"}, {"caller_nid": "chat_bridge_chatbridge_stopsession", "callee": "delete", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L450"}, {"caller_nid": "chat_bridge_chatbridge_respondtoapproval", "callee": "get", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L459"}, {"caller_nid": "chat_bridge_chatbridge_respondtoapproval", "callee": "get", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L461"}, {"caller_nid": "chat_bridge_chatbridge_respondtoapproval", "callee": "delete", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L463"}, {"caller_nid": "chat_bridge_chatbridge_respondtoapproval", "callee": "resolve", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L464"}, {"caller_nid": "chat_bridge_chatbridge_getsdksessionid", "callee": "get", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L473"}, {"caller_nid": "chat_bridge_chatbridge_isactive", "callee": "get", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L478"}, {"caller_nid": "chat_bridge_chatbridge_transformmessage", "callee": "map", "source_file": "/Users/marcelspatz/NUDIMMUD/NEURAL-NETWORK/evo-nexus/dashboard/terminal-server/src/chat-bridge.js", "source_location": "L547"}]}