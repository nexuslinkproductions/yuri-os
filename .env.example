# =============================================================================
# YURI — Environment Reference
# Copy to .env and fill in real values. Never commit .env (it is a protected path).
#
# YURI is a governance + continuity exoskeleton. The core is hooks + skills +
# gates + memory + xref/FTS5 search, all driven from the repo. No third-party
# service is required to run it. Set only what you use.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------

# Absolute path to your cloned YURI repo. Every script/hook derives its paths
# from here (with an __dirname fallback). Set this once after cloning.
YURI_ROOT=/path/to/your/yuri

# Operator handle, injected into traces and the persona/role resolver.
YURI_USER=

# -----------------------------------------------------------------------------
# OPERATOR ROLE (dev vs coworker)
# -----------------------------------------------------------------------------

# Key that elevates the session role from 'coworker' (restricted) to 'dev'
# (full owner trust). Generate a strong random value; keep it private.
YURI_DEV_KEY=

# macOS Keychain service prefix used by the role/credential resolver.
YURI_KEYCHAIN_SERVICE_PREFIX=YURI

# -----------------------------------------------------------------------------
# ENERGY GATE (Lyapunov-style work-dynamics scoring)
# -----------------------------------------------------------------------------

# Enable per-turn energy observability (writes the ΔU trace). Default: off.
YURI_ENERGY_OBSERVABILITY=0

# Arm enforcement (blocks on catastrophic, non-offsettable verdicts).
# Requires YURI_ENERGY_OBSERVABILITY=1. Default: off (metrics-only).
YURI_ENERGY_ENFORCE=0

# Set to 1 to force-close a tripped circuit breaker (operator override).
YURI_ENERGY_BREAKER_RESET=0

# -----------------------------------------------------------------------------
# GUARDS & FLAGS
# -----------------------------------------------------------------------------

# Set to 1 to make the URL guard fail loud instead of silently passing on error.
TIRITH_FAIL_LOUD=0

# Suppresses the post-plan-dispatch advisory during an authorized sprint.
YURI_SPRINT_MODE=0

# -----------------------------------------------------------------------------
# PERSONA OVERLAY (private, optional)
# -----------------------------------------------------------------------------

# Activates a private persona overlay for local dev sessions. Off by default and
# never enabled in shared/CI/public environments. Shipping users author their
# own persona in _SYSTEM/persona.md (start from persona.template.md).
# YURI_PRIVATE_PERSONA_OVERLAY is the neutral alias for the same flag; either
# name works (_SYSTEM/Scripts/lane-persona-map.mjs accepts both).
YURI_PRIVATE_RICK_OVERLAY=0
# YURI_PRIVATE_PERSONA_OVERLAY=0

# When the overlay above is on, the Claude lanes (claude-sonnet/claude-opus) display
# an operator-chosen name instead of the committed Rick default, sourced from the
# gitignored .claude/operator.json -> persona.overlay field (e.g. "overlay": "Jeffrey").
# No operator.json, or a non-Claude lane, falls back to the committed Rick roster.
