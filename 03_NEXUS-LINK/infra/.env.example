# Nexus Link — local Supabase stack (copy to .env and change secrets)
# Generate fresh keys: https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
# NEVER commit .env — this file contains placeholders only.

############
# Stack identity
############
COMPOSE_PROJECT_NAME=nexus-link

############
# Postgres
############
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me-super-secret-postgres-password

# Direct host port (Supabase CLI default: 54322)
POSTGRES_HOST_PORT=54322

############
# JWT & API keys (HS256 demo keys — replace for any shared environment)
############
JWT_SECRET=change-me-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Legacy JWT API keys (must be signed with JWT_SECRET above)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Im5leHVzLWxvY2FsIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE3OTk1MzU2MDB9.placeholder-replace-me
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoibmV4dXMtbG9jYWwiLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.placeholder-replace-me

############
# Public URLs (local defaults align with Supabase CLI ports)
############
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
API_EXTERNAL_URL=http://127.0.0.1:54321
SITE_URL=http://127.0.0.1:3000
ADDITIONAL_REDIRECT_URLS=

############
# Kong gateway
############
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=8443

############
# Studio dashboard (basic auth in front of Kong root)
############
STUDIO_PORT=54323
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=Nexus Link
STUDIO_DEFAULT_PROJECT=Local Dev
PG_META_CRYPTO_KEY=change-me-pg-meta-crypto-key-32-chars-min

############
# Auth (GoTrue)
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Nexus Link Local

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Realtime (optional — disabled in slim stack; vars kept for parity)
############
SECRET_KEY_BASE=change-me-secret-key-base-at-least-64-characters-long-for-realtime-if-enabled
REALTIME_DB_ENC_KEY=supabaserealtime

############
# OpenAI (optional — Studio AI assistant)
############
OPENAI_API_KEY=
