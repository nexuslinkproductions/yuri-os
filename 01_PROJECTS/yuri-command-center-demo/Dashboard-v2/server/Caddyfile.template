# Caddyfile — ops.c2moviez.com on Infomaniak compute instance
#
# Setup:
#   1. sudo cp this file to /etc/caddy/Caddyfile
#   2. sudo systemctl reload caddy
#
# Architecture:
#   port 3001 = Express API (netlify functions wrapper, PM2 nex-api)
#   port 3002 = SvelteKit frontend (adapter-node, PM2 nex-frontend)
#   Caddy handles TLS termination + routing between them.

ops.c2moviez.com {
    # ── Netlify Functions API ─────────────────────────────────────────
    handle /.netlify/functions/* {
        reverse_proxy localhost:3001
    }

    # ── Internal cron endpoints (PM2 only) ───────────────────────────
    handle /_internal/* {
        @external not remote_ip 127.0.0.1 ::1
        respond @external 403
        reverse_proxy localhost:3001
    }

    # ── API health check ─────────────────────────────────────────────
    handle /health {
        reverse_proxy localhost:3001
    }

    # ── SvelteKit frontend (SSR + static assets) ──────────────────────
    handle {
        reverse_proxy localhost:3002
    }

    # ── Security headers ──────────────────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
