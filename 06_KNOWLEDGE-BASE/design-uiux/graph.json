    {
      "id": "repo_shadergradient",
      "label": "ShaderGradient",
      "type": "inspiration",
      "url": "https://github.com/ruucm/shadergradient",
      "use_when": "Need ambient hero / motion background; React 3D gradient. Default for atmospheric scenes.",
      "avoid_when": "Logo or brand-treatment work; static UI; performance-sensitive contexts on low-end devices.",
      "fallback": "react-three-fiber (only if custom 3D scene required beyond gradient)"
    },
    {
      "id": "repo_liquid_logo",
      "label": "Liquid Logo (paper-design demo)",
      "type": "inspiration",
      "url": "https://github.com/paper-design/liquid-logo",
      "use_when": "Logo / brand treatment inspiration only — demo site, NOT a library. Real lib is @paper-design/shaders-react.",
      "avoid_when": "Production use of repo code directly; PolyForm Shield 1.0.0 license restricts competing services. Use @paper-design/shaders-react instead.",
      "fallback": "ShaderGradient for inspiration only"
    },
    {
      "id": "repo_liquid_glass_js",
      "label": "Liquid Glass JS",
      "type": "inspiration",
      "url": "https://github.com/dashersw/liquid-glass-js",
      "use_when": "Glass UI prototype; Apple-Liquid-Glass-inspired effects. Pure JS + WebGL.",
      "avoid_when": "Production unless explicitly approved (prototype-grade). Frameworks beyond vanilla JS.",
      "fallback": "react-three-fiber only if custom scene required"
    },
    {
      "id": "repo_react_three_fiber",
      "label": "react-three-fiber (R3F)",
      "type": "inspiration",
      "url": "https://github.com/pmndrs/react-three-fiber",
      "use_when": "Custom 3D scene that ShaderGradient cannot cover. React/Three.js infrastructure. Last-resort only.",
      "avoid_when": "Simple gradients (use ShaderGradient instead); logo work; glass UI (use liquid-glass-js).",
      "fallback": "None — this IS the fallback for custom 3D"
    },
    {
      "id": "theme_visual_effects",
      "label": "Visual Effects",
      "type": "cluster",
      "use_when": "Tasks involving motion, ambient gradients, glass, or 3D scenes",
      "avoid_when": "",
      "fallback": ""
    },
    {
      "id": "theme_brand_treatments",
      "label": "Brand Treatments",
      "type": "cluster",
      "use_when": "Tasks involving logo treatments, brand visualization, identity",
      "avoid_when": "",
      "fallback": ""
    }
