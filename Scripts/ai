#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${ROOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
OFFLOAD_RUNNER="$SCRIPT_DIR/offload-runner.mjs"

usage() {
  cat <<'EOF'
Usage: ai <command> [prompt]

Commands:
  code|vscode|open [path]
      Open a path in VS Code. Defaults to the current directory.

  claude [prompt]
      Start Claude interactively, or run a one-shot prompt with --print.

  gemini [prompt]
      Start Gemini interactively, or run a one-shot prompt with -p.

  codex [prompt]
      Start Codex interactively, or run a one-shot prompt with codex exec.

  btw [prompt]
      Route a live steering hint to the best lane, local first.

  moonshot [prompt]
      Route directly to the Moonshot/Kimi cloud lane.

  offload [options] [prompt]
      Route through the NUDIMMUD offload system (auto, --model, --swarm, --list, --dry-run, --route-only).

  offload swarm [prompt]
      Run offload swarm with default lane set (kimi,gpt-oss,ollama).

  offload capabilities
      Print the full lane and model inventory (JSON).

  swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out Kimi, GPT-OSS, and Ollama as needed.

  doctor
      Check that the launcher and offload entrypoints are available.

  route [prompt]
      Print the lane that btw would choose without executing it.

  @kimi [prompt]
      Run the direct Kimi cloud offload lane.

  @gpt-oss [prompt]
      Run the direct GPT-OSS local offload lane.

  @ollama [prompt]
      Run the direct Ollama local offload lane.

  @deepseek [prompt]
      Run the direct DeepSeek local offload lane.

  @swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out Kimi, GPT-OSS, and Ollama as needed.

  ruflo [prompt]
      Ask Ruflo for routing guidance without executing the routed lane.

  triage [prompt]
      Run claude, gemini, and codex in parallel and print all three outputs.

Examples:
  ai code .
  ai claude "Trace the auth flow in this repo"
  ai gemini "Summarize the latest changes"
  ai codex "Find the riskiest file in backend/src"
  ai btw "offload this review"
  ai moonshot "deep architecture review"
  ai swarm "review this branch"
  ai doctor
  ai route "offload swarm proceed"
  ai @kimi "Summarize this branch"
  ai @swarm "Review the auth flow"
  ai triage "What should I change first?"
  ai ruflo "Route this feature"
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 127
  fi
}

gemini_policy_guard() {
  require_cmd python3
  python3 "$ROOT_DIR/Scripts/gemini-policy-guard.py"
}

run_gemini_safe() {
  gemini_policy_guard
  require_cmd gemini
  exec gemini "$@"
}

run_gemini_prompt() {
  local prompt="$1"
  gemini_policy_guard
  require_cmd gemini
  exec gemini -p "$prompt"
}

join_prompt() {
  printf '%s' "$*"
}

print_section() {
  local title="$1"
  local file="$2"
  printf '\n[%s]\n' "$title"
  if [ -s "$file" ]; then
    sed -n '1,220p' "$file"
  else
    echo "(no output)"
  fi
}

run_triage() {
  local prompt="$1"
  local tmpdir claude_out gemini_out codex_out
  local pid_claude pid_gemini pid_codex status

  require_cmd claude
  require_cmd codex
  gemini_policy_guard

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-triage.XXXXXX")"
  claude_out="$tmpdir/claude.txt"
  gemini_out="$tmpdir/gemini.txt"
  codex_out="$tmpdir/codex.txt"

  trap 'rm -rf "$tmpdir"' EXIT

  (
    claude --print "$prompt" >"$claude_out" 2>&1
  ) &
  pid_claude=$!

  (
    run_gemini_prompt "$prompt" >"$gemini_out" 2>&1
  ) &
  pid_gemini=$!

  (
    codex exec --cd "$ROOT_DIR" "$prompt" >"$codex_out" 2>&1
  ) &
  pid_codex=$!

  status=0
  if ! wait "$pid_claude"; then
    status=1
  fi
  if ! wait "$pid_gemini"; then
    status=1
  fi
  if ! wait "$pid_codex"; then
    status=1
  fi

  print_section "claude" "$claude_out"
  print_section "gemini" "$gemini_out"
  print_section "codex" "$codex_out"

  return "$status"
}

run_codex_offload() {
  local agent="$1"
  shift

  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" "@${agent} $(join_prompt "$@")"
}

run_offload_lane() {
  local lane="$1"
  shift

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  require_cmd node
  exec node "$OFFLOAD_RUNNER" "$lane" "$@"
}

run_codex_swarm() {
  local prompt="$1"
  local tmpdir kimi_out gpt_oss_out ollama_out
  local pid_kimi status

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'kimi\n'
    printf 'gpt-oss\n'
    printf 'ollama\n'
    return
  fi

  require_cmd node

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-swarm.XXXXXX")"
  kimi_out="$tmpdir/kimi.txt"
  gpt_oss_out="$tmpdir/gpt-oss.txt"
  ollama_out="$tmpdir/ollama.txt"

  trap 'rm -rf "$tmpdir"' EXIT

  status=0

  # Cloud lane: kimi runs in background (no local resource contention)
  (
    node "$OFFLOAD_RUNNER" kimi "$prompt" >"$kimi_out" 2>&1
  ) &
  pid_kimi=$!

  # Local lanes: serialize to avoid Ollama GPU/memory contention on M2 Pro
  if ! node "$OFFLOAD_RUNNER" gpt-oss "$prompt" >"$gpt_oss_out" 2>&1; then
    status=1
  fi
  if ! node "$OFFLOAD_RUNNER" ollama "$prompt" >"$ollama_out" 2>&1; then
    status=1
  fi

  if ! wait "$pid_kimi"; then
    status=1
  fi

  print_section "kimi" "$kimi_out"
  print_section "gpt-oss" "$gpt_oss_out"
  print_section "ollama" "$ollama_out"

  return "$status"
}

run_ruflo_route() {
  local prompt="$1"

  if command -v ruflo >/dev/null 2>&1; then
    ruflo hooks route -t "$prompt"
    return
  fi

  require_cmd npx
  npx -y ruflo@latest hooks route -t "$prompt"
}

run_ruflo_swarm() {
  local prompt="$1"
  local route route_lower

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'ruflo\n'
    return
  fi

  route="$(run_ruflo_route "$prompt" 2>/dev/null || true)"
  route_lower="$(printf '%s' "$route" | tr '[:upper:]' '[:lower:]')"

  if [[ "${AI_TRACE_ROUTING:-0}" == "1" && -n "$route" ]]; then
    printf '\n[ruflo]\n%s\n' "$route"
  fi

  case "$route_lower" in
    *gpt-oss*|*gptoss*)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *ollama*)
      run_offload_lane ollama "$prompt"
      ;;
    *kimi*|*moonshot*)
      run_offload_lane kimi "$prompt"
      ;;
    *swarm*|*parallel*|*fan-out*|*hierarchical*|*hive*)
      run_codex_swarm "$prompt"
      ;;
    *)
      run_codex_swarm "$prompt"
      ;;
  esac
}

run_codex_hint() {
  local prompt="$1"
  local lane
  lane="$(select_btw_lane "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    kimi)
      run_offload_lane kimi "$prompt"
      ;;
    gpt-oss)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *)
      run_offload_lane gpt-oss "$prompt"
      ;;
  esac
}

select_btw_lane() {
  local prompt="$1"
  local prompt_lower

  prompt_lower="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')"

  if [[ "$prompt_lower" == *swarm* || "$prompt_lower" == *fan\ out* || "$prompt_lower" == *parallel* || "$prompt_lower" == *compare* ]]; then
    printf 'swarm\n'
    return
  fi

  if [[ "$prompt_lower" == *frontend* || "$prompt_lower" == *ui* || "$prompt_lower" == *design* || "$prompt_lower" == *react* || "$prompt_lower" == *interface* ]]; then
    printf 'gpt-oss\n'
    return
  fi

  if [[ "$prompt_lower" == *moonshot* || "$prompt_lower" == *kimi* || "$prompt_lower" == *cloud* || "$prompt_lower" == *complex* || "$prompt_lower" == *deep* || "$prompt_lower" == *architecture* || "$prompt_lower" == *review* || "$prompt_lower" == *audit* || "$prompt_lower" == *security* ]]; then
    printf 'kimi\n'
    return
  fi

  printf 'gpt-oss\n'
}

check_cmd() {
  local label="$1"
  local bin="$2"

  if command -v "$bin" >/dev/null 2>&1; then
    printf 'ok  %s -> %s\n' "$label" "$(command -v "$bin")"
    return 0
  fi

  printf 'miss %s\n' "$label"
  return 1
}

check_lane() {
  local prompt="$1"
  local expected="$2"
  local lane

  lane="$(select_btw_lane "$prompt")"
  if [ "$lane" = "$expected" ]; then
    printf 'ok  route "%s" -> %s\n' "$prompt" "$lane"
    return 0
  fi

  printf 'miss route "%s" -> %s (expected %s)\n' "$prompt" "$lane" "$expected"
  return 1
}

case "${1:-help}" in
  code|vscode|open)
    shift || true
    require_cmd code
    if [ "$#" -eq 0 ]; then
      exec code .
    fi
    exec code "$@"
    ;;
  claude)
    shift || true
    require_cmd claude
    if [ "$#" -eq 0 ]; then
      # ── Claude Code launch splash ─────────────────────────────
      _G="\033[38;2;180;234;144m"
      _G2="\033[38;2;56;87;36m"
      _AU="\033[38;2;92;184;0m"
      _GR="\033[38;2;168;168;168m"
      _CY="\033[38;2;180;234;144m"
      _BD="\033[1m"
      _RS="\033[0m"
      printf "\n"
      printf "${_AU}  ◆ CLAUDE CODE${_RS}  ${_G2}──────────────────────────────────────${_RS}\n"
      printf "  ${_GR}%-14s${_RS}%s\n"       "MODEL"     "claude-sonnet-4-6"
      printf "  ${_GR}%-14s${_CY}%s${_RS}\n" "WORKSPACE" "NUDIMMUD"
      printf "  ${_GR}%-14s${_RS}%s\n"       "SESSION"   "$(date '+%Y-%m-%d  %H:%M')"
      printf "  ${_G2}──────────────────────────────────────────────${_RS}\n"
      printf "\n"
      unset _G _G2 _AU _GR _CY _BD _RS
      export NUDIMMUD_SPLASH_SHOWN=1
      exec claude
    fi
    exec claude --print "$(join_prompt "$@")"
    ;;
  gemini)
    shift || true
    if [ "$#" -eq 0 ]; then
      run_gemini_safe
    fi
    run_gemini_prompt "$(join_prompt "$@")"
    ;;
  moonshot|kimi|@moonshot)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_offload_lane moonshot "$prompt"
    ;;
  offload)
    shift || true
    case "${1:-}" in
      swarm|@swarm)
        shift || true
        _dry_run=0
        _prompt_parts=()
        for _arg in "$@"; do
          case "$_arg" in
            --route-only|--dry-run|-d) _dry_run=1 ;;
            *) _prompt_parts+=("$_arg") ;;
          esac
        done
        prompt="$(join_prompt ${_prompt_parts[@]+"${_prompt_parts[@]}"})"
        if [ -z "$prompt" ] && [ "$_dry_run" -eq 0 ]; then
          usage
          exit 1
        fi
        if [ "$_dry_run" -eq 1 ]; then
          exec "$SCRIPT_DIR/offload.sh" --dry-run --swarm "kimi,gpt-oss,ollama" "$prompt"
        fi
        exec "$SCRIPT_DIR/offload.sh" --swarm "kimi,gpt-oss,ollama" "$prompt"
        ;;
      capabilities|inventory)
        shift || true
        require_cmd node
        exec node "$OFFLOAD_RUNNER" --inventory
        ;;
      *)
        exec "$SCRIPT_DIR/offload.sh" "$@"
        ;;
    esac
    ;;
  swarm|@swarm)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_ruflo_swarm "$prompt"
    ;;
  btw|/btw)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_codex_hint "$prompt"
    ;;
  route|plan)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    select_btw_lane "$prompt"
    ;;
  mythos|openmythos|openmythos-swarm)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the openmythos-swarm skill. ${prompt}"
    ;;
  claudeunpacked|claude-code-unpacked|claudecodeunpacked)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the claude-code-unpacked skill. ${prompt}"
    ;;
  frontenddesign|frontend-design|frontend)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the frontend-design skill. ${prompt}"
    ;;
  doctor|check|status)
    shift || true
    status=0
    printf 'ai launcher: %s\n' "$ROOT_DIR"
    check_cmd "code" code || status=1
    check_cmd "claude" claude || status=1
    check_cmd "gemini" gemini || status=1
    if gemini_policy_guard >/dev/null 2>&1; then
      printf 'ok  gemini policy guard -> %s\n' "$ROOT_DIR/Scripts/gemini-policy-guard.py"
    else
      printf 'miss gemini policy guard\n'
      status=1
    fi
    check_cmd "codex" codex || status=1
    check_cmd "btw" btw || status=1
    if command -v ruflo >/dev/null 2>&1; then
      printf 'ok  ruflo -> %s\n' "$(command -v ruflo)"
    elif command -v npx >/dev/null 2>&1; then
      printf 'ok  ruflo -> npx -y ruflo@latest (fallback)\n'
    else
      printf 'miss ruflo\n'
      status=1
    fi
    check_cmd "moonshot" moonshot || status=1
    check_cmd "swarm" swarm || status=1
    check_cmd "mythos" mythos || status=1
    check_cmd "claudeunpacked" claudeunpacked || status=1
    check_cmd "frontenddesign" frontenddesign || status=1
    check_cmd "openmythos" openmythos || status=1
    check_cmd "openmythos-swarm" openmythos-swarm || status=1
    check_lane "offload swarm proceed" swarm || status=1
    check_lane "frontend design audit" gpt-oss || status=1
    check_lane "deep architecture review" kimi || status=1
    exit "$status"
    ;;
  codex)
    shift || true
    require_cmd codex
    if [ "$#" -eq 0 ]; then
      exec codex
    fi
    case "${1:-}" in
      kimi)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload kimi "$@"
        ;;
      moonshot|@moonshot)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload kimi "$@"
        ;;
      gpt-oss|gptoss|gpt_oss)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload gpt-oss "$@"
        ;;
      ollama)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload ollama "$@"
        ;;
      swarm|triage)
        shift || true
        prompt="$(join_prompt "$@")"
        if [ -z "$prompt" ]; then
          usage
          exit 1
        fi
        run_codex_swarm "$prompt"
        ;;
      *)
        exec codex exec --cd "$ROOT_DIR" "$(join_prompt "$@")"
        ;;
    esac
    ;;
  @kimi|kimi)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane kimi "$@"
    ;;
  @gpt-oss|gpt-oss|@gptoss|gptoss|@gpt_oss|gpt_oss)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane gpt-oss "$@"
    ;;
  @ollama|ollama)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane ollama "$@"
    ;;
  @deepseek|deepseek)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek "$@"
    ;;
  @swarm|swarm)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_ruflo_swarm "$prompt"
    ;;
  ruflo)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
      printf 'ruflo\n'
      exit 0
    fi
    run_ruflo_route "$prompt"
    ;;
  triage|research)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_triage "$prompt"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
