#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${ROOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
OFFLOAD_RUNNER="$SCRIPT_DIR/offload-runner.mjs"

usage() {
  cat <<'EOF'
Usage: ai <command> [prompt]

Commands:
  code|vscode|open [path]
      Open a path in VS Code. Defaults to the current directory.

  claude [prompt]
      Start Claude interactively, or run a one-shot prompt with --print.

  gemini [prompt]
      Start Gemini interactively, or run a one-shot prompt with -p.

  codex [prompt]
      Start Codex interactively, or run a one-shot prompt with codex exec.

  btw [prompt]
      Route a live steering hint to the best lane, local first.

  moonshot [prompt]
      Route directly to the Moonshot cloud lane (deprecated compatibility).

  offload [options] [prompt]
      Route through the NUDIMMUD offload system (auto, --model, --swarm, --list, --dry-run, --route-only).

  offload swarm [prompt]
      Run offload swarm with default lane set (gpt-oss,ollama).

  offload capabilities
      Print the full lane and model inventory (JSON).

  swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out GPT-OSS and Ollama as needed.

  doctor
      Check that the launcher and offload entrypoints are available.

  route [prompt]
      Print the lane that btw would choose without executing it.

  @kimi [prompt]
      Deprecated compatibility route to the Kimi cloud offload lane.

  @gpt-oss [prompt]
      Run the direct GPT-OSS local offload lane.

  @ollama [prompt]
      Run the direct Ollama local offload lane.

  @deepseek [prompt]
      Run the direct DeepSeek local offload lane.

  @deepseek-v4-flash [prompt]
      Run the official DeepSeek V4 Flash lane (non-thinking default).

  @deepseek-v4-pro [prompt]
      Run the official DeepSeek V4 Pro lane (thinking default).

  @deepseek-v4-pro-lite-budget [prompt]
      Run the DeepSeek V4 Pro budget lane (non-thinking, tight caps).

  @deepseek-chat [prompt]
      Compatibility alias for DeepSeek V4 Flash non-thinking mode.

  @deepseek-reasoner [prompt]
      Compatibility alias for DeepSeek V4 Flash thinking mode.

  @deepseek-cloud [prompt]
      Compatibility alias for DeepSeek V4 Pro.

  @triage-local [prompt]
      Run the triage-local lane (fast lightweight local model).

  @summarize-local [prompt]
      Run the summarize-local lane (summarization-optimized local model).

  @code-local [prompt]
      Run the code-local lane (code-specialized local model, prefers qwen2.5-coder).

  @reason-kimi [prompt]
      Deprecated compatibility route for Kimi reasoning (cloud, thinking enabled).

  @code-deepseek [prompt]
      Run the code-deepseek lane (compatibility alias for DeepSeek V4 Pro).

  @deepseek-workhorse [prompt]
      Run DeepSeek workhorse swarm (cloud): deepseek-v4-pro-lite-budget,deepseek-v4-flash.
      Supports --dry-run / --route-only to preview lanes without live API calls.
      Read-only routing only. No write, patch, stage, or commit capability.

  @reason-cloud [prompt]
      Run the reason-cloud lane (Ollama Cloud reasoning, defaults to qwen2.5:72b).

  @code-cloud [prompt]
      Run the code-cloud lane (Ollama Cloud code, defaults to qwen2.5-coder:32b).

  @gemma [prompt]
      Run the gemma lane (cloud-first if OLLAMA_API_KEY set, local Gemma4 fallback).

  @gemma-local [prompt]
      Run the gemma-local lane (local Gemma4 only, no non-Gemma fallback).

  @gemma-cloud [prompt]
      Run the gemma-cloud lane (Ollama Cloud Gemma4 only).

  @swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out Kimi, GPT-OSS, and Ollama as needed.

  ruflo [prompt]
      Ask Ruflo for routing guidance without executing the routed lane.

  triage [prompt]
      Run claude, gemini, and codex in parallel and print all three outputs.

Examples:
  ai code .
  ai claude "Trace the auth flow in this repo"
  ai gemini "Summarize the latest changes"
  ai codex "Find the riskiest file in backend/src"
  ai btw "offload this review"
  ai moonshot "deep architecture review"
  ai swarm "review this branch"
  ai doctor
  ai route "offload swarm proceed"
  ai @deepseek-workhorse "Summarize this branch"
  ai @swarm "Review the auth flow"
  ai triage "What should I change first?"
  ai ruflo "Route this feature"
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 127
  fi
}

gemini_policy_guard() {
  require_cmd python3
  python3 "$ROOT_DIR/Scripts/gemini-policy-guard.py"
}

run_gemini_safe() {
  gemini_policy_guard
  require_cmd gemini
  exec gemini "$@"
}

run_gemini_prompt() {
  local prompt="$1"
  gemini_policy_guard
  require_cmd gemini
  exec gemini -p "$prompt"
}

join_prompt() {
  printf '%s' "$*"
}

print_section() {
  local title="$1"
  local file="$2"
  printf '\n[%s]\n' "$title"
  if [ -s "$file" ]; then
    sed -n '1,220p' "$file"
  else
    echo "(no output)"
  fi
}

print_route_section() {
  local title="$1"
  local file="$2"
  if [ -s "$file" ]; then
    printf '\n[%s route]\n' "$title"
    sed -n '1,220p' "$file"
  fi
}

cleanup_tmpdir() {
  local path="${1:-}"
  if [ -n "$path" ] && [ -d "$path" ]; then
    rm -rf -- "$path"
  fi
}

run_triage() {
  local prompt="$1"
  local tmpdir="" claude_out claude_err gemini_out gemini_err codex_out codex_err
  local pid_claude pid_gemini pid_codex status

  require_cmd claude
  require_cmd codex
  gemini_policy_guard

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-triage.XXXXXX")"
  claude_out="$tmpdir/claude.txt"
  claude_err="$tmpdir/claude.route.txt"
  gemini_out="$tmpdir/gemini.txt"
  gemini_err="$tmpdir/gemini.route.txt"
  codex_out="$tmpdir/codex.txt"
  codex_err="$tmpdir/codex.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  (
    claude --print "$prompt" >"$claude_out" 2>"$claude_err"
  ) &
  pid_claude=$!

  (
    run_gemini_prompt "$prompt" >"$gemini_out" 2>"$gemini_err"
  ) &
  pid_gemini=$!

  (
    codex exec --cd "$ROOT_DIR" "$prompt" >"$codex_out" 2>"$codex_err"
  ) &
  pid_codex=$!

  status=0
  if ! wait "$pid_claude"; then
    status=1
  fi
  if ! wait "$pid_gemini"; then
    status=1
  fi
  if ! wait "$pid_codex"; then
    status=1
  fi

  print_section "claude" "$claude_out"
  print_route_section "claude" "$claude_err"
  print_section "gemini" "$gemini_out"
  print_route_section "gemini" "$gemini_err"
  print_section "codex" "$codex_out"
  print_route_section "codex" "$codex_err"

  return "$status"
}

run_codex_offload() {
  local agent="$1"
  shift

  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" "@${agent} $(join_prompt "$@")"
}

run_offload_lane() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  require_cmd node
  OFFLOAD_PROMPT_TEXT="$prompt" exec node "$OFFLOAD_RUNNER" "$lane"
}

run_codex_swarm() {
  local prompt="$1"
  local tmpdir="" gpt_oss_out gpt_oss_err ollama_out ollama_err
  local status=0

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'gpt-oss\n'
    printf 'ollama\n'
    return
  fi

  require_cmd node

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-swarm.XXXXXX")"
  gpt_oss_out="$tmpdir/gpt-oss.txt"
  gpt_oss_err="$tmpdir/gpt-oss.route.txt"
  ollama_out="$tmpdir/ollama.txt"
  ollama_err="$tmpdir/ollama.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  # Local lanes: serialize to avoid Ollama GPU/memory contention on M2 Pro
  if ! node "$OFFLOAD_RUNNER" gpt-oss "$prompt" >"$gpt_oss_out" 2>"$gpt_oss_err"; then
    status=1
  fi
  if ! node "$OFFLOAD_RUNNER" ollama "$prompt" >"$ollama_out" 2>"$ollama_err"; then
    status=1
  fi
  print_section "gpt-oss" "$gpt_oss_out"
  print_route_section "gpt-oss" "$gpt_oss_err"
  print_section "ollama" "$ollama_out"
  print_route_section "ollama" "$ollama_err"

  return "$status"
}

run_ruflo_route() {
  local prompt="$1"

  if command -v ruflo >/dev/null 2>&1; then
    ruflo hooks route -t "$prompt"
    return
  fi

  require_cmd npx
  npx -y ruflo@latest hooks route -t "$prompt"
}

_fused_swarm_orchestrate() {
  local _dry_run=0
  local _route_only=0
  local _artifact_root="/private/tmp/yuri-artifacts"
  local _prompt_parts=()

  for _arg in "$@"; do
    case "$_arg" in
      --dry-run|-d) _dry_run=1 ;;
      --route-only) _route_only=1 ;;
      *)
        _prompt_parts+=("$_arg")
        ;;
    esac
  done

  local prompt="$(join_prompt ${_prompt_parts[@]+"${_prompt_parts[@]}"})"

  if [ -z "$prompt" ]; then
    if [ "$_dry_run" -eq 0 ] && [ "$_route_only" -eq 0 ]; then
      usage
      exit 1
    fi
  fi

  if [ "$_dry_run" -eq 1 ] || [ "$_route_only" -eq 1 ]; then
    printf 'FUSED_SWARM_DRY_RUN=1\n'
    printf 'FUSED_SWARM_ARTIFACT_ROOT=%s\n' "$_artifact_root"
    printf 'FUSED_SWARM_RUFLO=advisory_status_only\n'
    printf 'FUSED_SWARM_WORKHORSE=deepseek-v4-pro-lite-budget,deepseek-v4-flash\n'
    printf 'FUSED_SWARM_ADVISORY_ONLY=true\n'
    printf 'FUSED_SWARM_LOCAL_TRUTH_CLAIM=false\n'
    printf 'FUSED_SWARM_REQUIRES_APPROVAL=true\n'
    return 0
  fi

  require_cmd node
  require_cmd shasum

  _run_id="$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 4)"
  _run_dir="$_artifact_root/$_run_id"
  mkdir -p "$_run_dir"

  _prompt_sha256="$(printf '%s' "$prompt" | shasum -a 256 | awk '{print $1}')"

  _swarm_stdout="$_run_dir/swarm_output.tmp"
  _swarm_stderr="$_run_dir/swarm_error.txt"
  _swarm_status=0

  # Run ruflo swarm and capture output
  if ! run_ruflo_swarm "$prompt" >"$_swarm_stdout" 2>"$_swarm_stderr"; then
    _swarm_status=$?
  fi

  _stdout_bytes="$(wc -c < "$_swarm_stdout" | tr -d ' ')"
  _stdout_lines="$(wc -l < "$_swarm_stdout" | tr -d ' ')"
  _stderr_bytes="$(wc -c < "$_swarm_stderr" | tr -d ' ')"
  _stdout_sha256="$(shasum -a 256 "$_swarm_stdout" | awk '{print $1}')"

  # Write advisory output
  {
    printf '# ADVISORY_FUSED_SWARM_OUTPUT\n'
    printf '# route: @swarm\n'
    printf '# run_id: %s\n' "$_run_id"
    printf '# sha256: %s\n' "$_stdout_sha256"
    printf '# advisory_only=true\n'
    printf '# local_truth_claim=false\n'
    printf '# requires_approval=true\n'
    printf '\n'
    cat "$_swarm_stdout"
  } >"$_run_dir/output.md"

  # Write summary.json
  printf '{"run_id":"%s","route":"@swarm","fused":true,"artifact_root":"%s","prompt_sha256":"%s","advisory_only":true,"local_truth_claim":false,"requires_approval":true,"stdout_bytes":%s,"stdout_lines":%s,"stderr_bytes":%s,"exit_code":%s,"ruflo_status":"advisory_status_only","workhorse_status":"deepseek-v4-pro-lite-budget,deepseek-v4-flash","paid_lanes":["deepseek"],"non_claims":["no write capability","no patch application","no executor widening"]}\n' \
    "$_run_id" "$_artifact_root" "$_prompt_sha256" \
    "$_stdout_bytes" "$_stdout_lines" "$_stderr_bytes" "$_swarm_status" \
    >"$_run_dir/summary.json"

  printf 'FUSED_SWARM_RUN=%s\n' "$_run_dir"
  printf 'FUSED_SWARM_SUMMARY=%s\n' "$_run_dir/summary.json"
  printf 'FUSED_SWARM_STATUS=%s\n' "PASS"

  rm -f "$_swarm_stdout" "$_swarm_stderr"
}

run_ruflo_swarm() {
  local prompt="$1"
  local route route_lower

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'ruflo\n'
    return
  fi

  route="$(run_ruflo_route "$prompt" 2>/dev/null || true)"
  route_lower="$(printf '%s' "$route" | tr '[:upper:]' '[:lower:]')"

  if [[ "${AI_TRACE_ROUTING:-0}" == "1" && -n "$route" ]]; then
    printf '\n[ruflo]\n%s\n' "$route"
  fi

  case "$route_lower" in
    *gpt-oss*|*gptoss*)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *ollama*)
      run_offload_lane ollama "$prompt"
      ;;
    *kimi*|*moonshot*)
      run_codex_swarm "$prompt"
      ;;
    *swarm*|*parallel*|*fan-out*|*hierarchical*|*hive*)
      run_codex_swarm "$prompt"
      ;;
    *)
      run_codex_swarm "$prompt"
      ;;
  esac
}

run_codex_hint() {
  local prompt="$1"
  local lane
  lane="$(select_btw_lane "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    kimi)
      run_offload_lane kimi "$prompt"
      ;;
    gpt-oss)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *)
      run_offload_lane gpt-oss "$prompt"
      ;;
  esac
}

select_btw_lane() {
  local prompt="$1"
  local prompt_lower

  prompt_lower="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')"

  if [[ "$prompt_lower" == *swarm* || "$prompt_lower" == *fan\ out* || "$prompt_lower" == *parallel* || "$prompt_lower" == *compare* ]]; then
    printf 'swarm\n'
    return
  fi

  if [[ "$prompt_lower" == *frontend* || "$prompt_lower" == *ui* || "$prompt_lower" == *design* || "$prompt_lower" == *react* || "$prompt_lower" == *interface* ]]; then
    printf 'gpt-oss\n'
    return
  fi

  if [[ "$prompt_lower" == *moonshot* || "$prompt_lower" == *kimi* || "$prompt_lower" == *cloud* || "$prompt_lower" == *complex* || "$prompt_lower" == *deep* || "$prompt_lower" == *architecture* || "$prompt_lower" == *review* || "$prompt_lower" == *audit* || "$prompt_lower" == *security* ]]; then
    printf 'swarm\n'
    return
  fi

  printf 'gpt-oss\n'
}

check_cmd() {
  local label="$1"
  local bin="$2"

  if command -v "$bin" >/dev/null 2>&1; then
    printf 'ok  %s -> %s\n' "$label" "$(command -v "$bin")"
    return 0
  fi

  printf 'miss %s\n' "$label"
  return 1
}

check_lane() {
  local prompt="$1"
  local expected="$2"
  local lane

  lane="$(select_btw_lane "$prompt")"
  if [ "$lane" = "$expected" ]; then
    printf 'ok  route "%s" -> %s\n' "$prompt" "$lane"
    return 0
  fi

  printf 'miss route "%s" -> %s (expected %s)\n' "$prompt" "$lane" "$expected"
  return 1
}

case "${1:-help}" in
  code|vscode|open)
    shift || true
    require_cmd code
    if [ "$#" -eq 0 ]; then
      exec code .
    fi
    exec code "$@"
    ;;
  claude)
    shift || true
    require_cmd claude
    if [ "$#" -eq 0 ]; then
      # ── Claude Code launch splash ─────────────────────────────
      _G="\033[38;2;180;234;144m"
      _G2="\033[38;2;56;87;36m"
      _AU="\033[38;2;92;184;0m"
      _GR="\033[38;2;168;168;168m"
      _CY="\033[38;2;180;234;144m"
      _BD="\033[1m"
      _RS="\033[0m"
      printf "\n"
      printf "${_AU}  ◆ CLAUDE CODE${_RS}  ${_G2}──────────────────────────────────────${_RS}\n"
      printf "  ${_GR}%-14s${_RS}%s\n"       "MODEL"     "claude-sonnet-4-6"
      printf "  ${_GR}%-14s${_CY}%s${_RS}\n" "WORKSPACE" "NUDIMMUD"
      printf "  ${_GR}%-14s${_RS}%s\n"       "SESSION"   "$(date '+%Y-%m-%d  %H:%M')"
      printf "  ${_G2}──────────────────────────────────────────────${_RS}\n"
      printf "\n"
      unset _G _G2 _AU _GR _CY _BD _RS
      export NUDIMMUD_SPLASH_SHOWN=1
      exec claude
    fi
    exec claude --print "$(join_prompt "$@")"
    ;;
  gemini)
    shift || true
    if [ "$#" -eq 0 ]; then
      run_gemini_safe
    fi
    run_gemini_prompt "$(join_prompt "$@")"
    ;;
  moonshot|kimi|@moonshot)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_offload_lane moonshot "$prompt"
    ;;
  offload)
    shift || true
  case "${1:-}" in
      swarm|@swarm)
        shift || true
        _dry_run=0
        _prompt_parts=()
        for _arg in "$@"; do
          case "$_arg" in
            --route-only|--dry-run|-d) _dry_run=1 ;;
            *) _prompt_parts+=("$_arg") ;;
          esac
        done
        prompt="$(join_prompt ${_prompt_parts[@]+"${_prompt_parts[@]}"})"
        if [ -z "$prompt" ] && [ "$_dry_run" -eq 0 ]; then
          usage
          exit 1
        fi
        if [ "$_dry_run" -eq 1 ]; then
          exec "$SCRIPT_DIR/offload.sh" --dry-run --swarm "gpt-oss,ollama" "$prompt"
        fi
        exec "$SCRIPT_DIR/offload.sh" --swarm "gpt-oss,ollama" "$prompt"
        ;;
      capabilities|inventory)
        shift || true
        require_cmd node
        exec node "$OFFLOAD_RUNNER" --inventory
        ;;
      *)
        exec "$SCRIPT_DIR/offload.sh" "$@"
        ;;
    esac
    ;;
  btw|/btw)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_codex_hint "$prompt"
    ;;
  route|plan)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    select_btw_lane "$prompt"
    ;;
  mythos|openmythos|openmythos-swarm)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the openmythos-swarm skill. ${prompt}"
    ;;
  claudeunpacked|claude-code-unpacked|claudecodeunpacked)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the claude-code-unpacked skill. ${prompt}"
    ;;
  frontenddesign|frontend-design|frontend)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    exec codex exec --cd "$ROOT_DIR" "Use the frontend-design skill. ${prompt}"
    ;;
  doctor|check|status)
    shift || true
    status=0
    printf 'ai launcher: %s\n' "$ROOT_DIR"
    check_cmd "code" code || status=1
    check_cmd "claude" claude || status=1
    check_cmd "gemini" gemini || status=1
    if gemini_policy_guard >/dev/null 2>&1; then
      printf 'ok  gemini policy guard -> %s\n' "$ROOT_DIR/Scripts/gemini-policy-guard.py"
    else
      printf 'miss gemini policy guard\n'
      status=1
    fi
    check_cmd "codex" codex || status=1
    check_cmd "btw" btw || status=1
    if command -v ruflo >/dev/null 2>&1; then
      printf 'ok  ruflo -> %s\n' "$(command -v ruflo)"
    elif command -v npx >/dev/null 2>&1; then
      printf 'ok  ruflo -> npx -y ruflo@latest (fallback)\n'
    else
      printf 'miss ruflo\n'
      status=1
    fi
    check_cmd "moonshot" moonshot || status=1
    check_cmd "swarm" swarm || status=1
    check_cmd "mythos" mythos || status=1
    check_cmd "claudeunpacked" claudeunpacked || status=1
    check_cmd "frontenddesign" frontenddesign || status=1
    check_cmd "openmythos" openmythos || status=1
    check_cmd "openmythos-swarm" openmythos-swarm || status=1
    check_lane "offload swarm proceed" swarm || status=1
    check_lane "frontend design audit" gpt-oss || status=1
    check_lane "deep architecture review" swarm || status=1
    exit "$status"
    ;;
  codex)
    shift || true
    require_cmd codex
    if [ "$#" -eq 0 ]; then
      exec codex
    fi
    case "${1:-}" in
      kimi)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload kimi "$@"
        ;;
      moonshot|@moonshot)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload kimi "$@"
        ;;
      gpt-oss|gptoss|gpt_oss)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload gpt-oss "$@"
        ;;
      ollama)
        shift || true
        if [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        run_codex_offload ollama "$@"
        ;;
      @swarm|swarm|triage)
        shift || true
        prompt="$(join_prompt "$@")"
        if [ -z "$prompt" ]; then
          usage
          exit 1
        fi
        run_codex_swarm "$prompt"
        ;;
      *)
        exec codex exec --cd "$ROOT_DIR" "$(join_prompt "$@")"
        ;;
    esac
    ;;
  @kimi|kimi)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane kimi "$@"
    ;;
  @gpt-oss|gpt-oss|@gptoss|gptoss|@gpt_oss|gpt_oss)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane gpt-oss "$@"
    ;;
  @ollama|ollama)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane ollama "$@"
    ;;
  @deepseek|deepseek)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek "$@"
    ;;
  @deepseek-v4-flash|deepseek-v4-flash)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-v4-flash "$@"
    ;;
  @deepseek-v4-pro|deepseek-v4-pro)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-v4-pro "$@"
    ;;
  @deepseek-v4-pro-lite-budget|deepseek-v4-pro-lite-budget)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-v4-pro-lite-budget "$@"
    ;;
  @deepseek-chat|deepseek-chat)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-chat "$@"
    ;;
  @deepseek-reasoner|deepseek-reasoner)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-reasoner "$@"
    ;;
  @deepseek-cloud|deepseek-cloud)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane deepseek-cloud "$@"
    ;;
  @triage-local|triage-local)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane triage-local "$@"
    ;;
  @summarize-local|summarize-local)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane summarize-local "$@"
    ;;
  @code-local|code-local)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane code-local "$@"
    ;;
  @reason-kimi|reason-kimi)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane reason-kimi "$@"
    ;;
  @code-deepseek|code-deepseek)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane code-deepseek "$@"
    ;;
  @deepseek-workhorse|deepseek-workhorse)
    shift || true
    _dry_run=0
    _artifact_root=""
    _line_cap=80
    _max_bytes=12000
    _prompt_parts=()
    _WORKHORSE_DEFAULT_ROOT="/private/tmp/nudimmud-workhorse-bundles"
    _skip_next=0
    for _arg in "$@"; do
      if [ "$_skip_next" -eq 1 ]; then
        _skip_next=0
        continue
      fi
      case "$_arg" in
        --route-only|--dry-run|-d) _dry_run=1 ;;
        --bundle-artifacts) _artifact_root="$_WORKHORSE_DEFAULT_ROOT" ;;
        --artifact-bundle)
          # value follows as next arg — mark skip and consume inline via shift-style workaround
          # handled via positional loop below; flag without value is a no-op guard
          _artifact_root="__NEXT__"
          ;;
        --line-cap) _artifact_root_flag_next_linecap=1 ;;
        --max-output-bytes) _artifact_root_flag_next_bytes=1 ;;
        *)
          if [ "${_artifact_root:-}" = "__NEXT__" ]; then
            _artifact_root="$_arg"
          elif [ "${_artifact_root_flag_next_linecap:-0}" = "1" ]; then
            _line_cap="$_arg"
            _artifact_root_flag_next_linecap=0
          elif [ "${_artifact_root_flag_next_bytes:-0}" = "1" ]; then
            _max_bytes="$_arg"
            _artifact_root_flag_next_bytes=0
          else
            _prompt_parts+=("$_arg")
          fi
          ;;
      esac
    done
    # Clamp caps
    [ "$_line_cap" -gt 200 ] && _line_cap=200
    [ "$_max_bytes" -gt 50000 ] && _max_bytes=50000
    prompt="$(join_prompt ${_prompt_parts[@]+"${_prompt_parts[@]}"})"

    # --- Non-bundle path (original behavior preserved) ---
    if [ -z "$_artifact_root" ] || [ "$_artifact_root" = "__NEXT__" ]; then
      if [ -z "$prompt" ] && [ "$_dry_run" -eq 0 ]; then
        usage
        exit 1
      fi
      if [ "$_dry_run" -eq 1 ]; then
        exec "$SCRIPT_DIR/offload.sh" --dry-run --swarm "deepseek-v4-pro-lite-budget,deepseek-v4-flash" "$prompt"
      fi
      exec "$SCRIPT_DIR/offload.sh" --swarm "deepseek-v4-pro-lite-budget,deepseek-v4-flash" "$prompt"
    fi

    # --- Artifact bundle path ---

    # Security: reject repo-internal or relative artifact roots
    _repo_root="$(cd "$SCRIPT_DIR/.." && pwd)"
    case "$_artifact_root" in
      /Users/marcelspatz/NUDIMMUD*|"$_repo_root"*)
        printf 'ERROR: artifact-bundle root must be outside the repo: %s\n' "$_artifact_root" >&2
        exit 1
        ;;
      [^/]*)
        printf 'ERROR: artifact-bundle root must be an absolute path: %s\n' "$_artifact_root" >&2
        exit 1
        ;;
    esac

    if [ -z "$prompt" ] && [ "$_dry_run" -eq 0 ]; then
      usage
      exit 1
    fi

    if [ "$_dry_run" -eq 1 ]; then
      printf 'WORKHORSE_BUNDLE_DRY_RUN=1\n'
      printf 'WORKHORSE_BUNDLE_ROOT=%s\n' "$_artifact_root"
      printf 'WORKHORSE_BUNDLE_LANES=deepseek-v4-pro-lite-budget,deepseek-v4-flash\n'
      printf 'WORKHORSE_BUNDLE_LINE_CAP=%s\n' "$_line_cap"
      printf 'WORKHORSE_BUNDLE_MAX_BYTES=%s\n' "$_max_bytes"
      exit 0
    fi

    require_cmd node
    require_cmd shasum

    _run_id="$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 4)"
    _run_dir="$_artifact_root/$_run_id"
    mkdir -p "$_run_dir"

    _prompt_sha256="$(printf '%s' "$prompt" | shasum -a 256 | awk '{print $1}')"
    _lanes=("deepseek-v4-pro-lite-budget" "deepseek-v4-flash")
    _bundle_status="PASS"
    _lanes_summary=""
    _total_bytes=0
    _all_ok=true

    for _lane in "${_lanes[@]}"; do
      _lane_dir="$_run_dir/$_lane"
      mkdir -p "$_lane_dir"
      _stdout_raw="$_lane_dir/stdout_raw.tmp"
      _stderr_file="$_lane_dir/stderr.txt"
      _stdout_md="$_lane_dir/stdout.md"
      _meta_file="$_lane_dir/meta.json"
      _started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      _lane_exit=0

      OFFLOAD_PROMPT_TEXT="$prompt" node "$OFFLOAD_RUNNER" "$_lane" >"$_stdout_raw" 2>"$_stderr_file" || _lane_exit=$?

      _ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      _stdout_raw_bytes="$(wc -c < "$_stdout_raw" | tr -d ' ')"
      _stdout_raw_lines="$(wc -l < "$_stdout_raw" | tr -d ' ')"
      _cap_marker="FULL"

      # Apply byte cap first, then line cap
      if [ "$_stdout_raw_bytes" -gt "$_max_bytes" ]; then
        _capped_content="$(head -c "$_max_bytes" "$_stdout_raw")"
        _cap_marker="TRUNCATED"
      else
        _capped_content="$(cat "$_stdout_raw")"
      fi
      _capped_lines="$(printf '%s' "$_capped_content" | wc -l | tr -d ' ')"
      if [ "$_capped_lines" -gt "$_line_cap" ]; then
        _capped_content="$(printf '%s' "$_capped_content" | head -n "$_line_cap")"
        _cap_marker="TRUNCATED"
      fi

      _stdout_sha256="$(printf '%s' "$_capped_content" | shasum -a 256 | awk '{print $1}')"
      _stderr_bytes="$(wc -c < "$_stderr_file" | tr -d ' ')"
      _stderr_sha256="$(shasum -a 256 "$_stderr_file" | awk '{print $1}')"
      _written_bytes="$(printf '%s' "$_capped_content" | wc -c | tr -d ' ')"
      _written_lines="$(printf '%s' "$_capped_content" | wc -l | tr -d ' ')"

      # Write advisory stdout.md
      {
        printf '# ADVISORY_WORKHORSE_OUTPUT\n'
        printf '# lane: %s\n' "$_lane"
        printf '# route: @deepseek-workhorse\n'
        printf '# run_id: %s\n' "$_run_id"
        printf '# sha256: %s\n' "$_stdout_sha256"
        printf '# cap: %s\n' "$_cap_marker"
        printf '# NOT_LOCAL_TRUTH\n'
        printf '\n'
        printf '%s\n' "$_capped_content"
      } >"$_stdout_md"

      _lane_status="ok"
      if [ "$_lane_exit" -ne 0 ]; then
        _lane_status="error"
        _bundle_status="PARTIAL"
        _all_ok=false
      fi

      # Write meta.json
      printf '{"lane_id":"%s","route_class":"@deepseek-workhorse","prompt_sha256":"%s","stdout_sha256":"%s","stderr_sha256":"%s","stdout_bytes":%s,"stdout_lines":%s,"stdout_cap_marker":"%s","stderr_bytes":%s,"exit_code":%s,"status":"%s","started_at":"%s","ended_at":"%s"}\n' \
        "$_lane" "$_prompt_sha256" "$_stdout_sha256" "$_stderr_sha256" \
        "$_written_bytes" "$_written_lines" "$_cap_marker" \
        "$_stderr_bytes" "$_lane_exit" "$_lane_status" \
        "$_started" "$_ended" >"$_meta_file"

      _total_bytes=$(( _total_bytes + _written_bytes ))
      _lanes_summary="${_lanes_summary}{\"lane\":\"${_lane}\",\"lane_id\":\"${_lane}\",\"status\":\"${_lane_status}\",\"exit_code\":${_lane_exit},\"stdout_bytes\":${_written_bytes},\"stdout_lines\":${_written_lines},\"cap\":\"${_cap_marker}\",\"stdout_cap_marker\":\"${_cap_marker}\"},"

      rm -f "$_stdout_raw"
    done

    # Trim trailing comma from lanes summary array
    _lanes_summary="[${_lanes_summary%,}]"

    # Write summary.json
    printf '{"run_id":"%s","route":"@deepseek-workhorse","artifact_root":"%s","prompt_sha256":"%s","lanes":%s,"total_stdout_bytes":%s,"total_bytes":%s,"all_lanes_ok":%s,"advisory_label":"ADVISORY_WORKHORSE_OUTPUT","local_truth_disclaimer":"NOT_LOCAL_TRUTH — bundle is advisory only; not executor truth","user_approval_required":true,"proposal_validation_status":null,"non_claims":["no write capability","no patch application","no guarded executor widening","no staging/commit through DeepSeek"]}\n' \
      "$_run_id" "$_artifact_root" "$_prompt_sha256" "$_lanes_summary" \
      "$_total_bytes" "$_total_bytes" "$_all_ok" >"$_run_dir/summary.json"

    printf 'WORKHORSE_BUNDLE_RUN=%s\n' "$_run_dir"
    printf 'WORKHORSE_BUNDLE_SUMMARY=%s\n' "$_run_dir/summary.json"
    printf 'WORKHORSE_BUNDLE_STATUS=%s\n' "$_bundle_status"
    ;;
  @reason-cloud|reason-cloud)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane reason-cloud "$@"
    ;;
  @code-cloud|code-cloud)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane code-cloud "$@"
    ;;
  @gemma|gemma)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane gemma "$@"
    ;;
  @gemma-local|gemma-local)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane gemma-local "$@"
    ;;
  @gemma-cloud|gemma-cloud)
    shift || true
    if [ "$#" -eq 0 ]; then
      usage
      exit 1
    fi
    run_offload_lane gemma-cloud "$@"
    ;;
  @swarm|swarm)
    shift || true
    _fused_swarm_orchestrate "$@"
    ;;
  ruflo)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
      printf 'ruflo\n'
      exit 0
    fi
    run_ruflo_route "$prompt"
    ;;
  triage|research)
    shift || true
    prompt="$(join_prompt "$@")"
    if [ -z "$prompt" ]; then
      usage
      exit 1
    fi
    run_triage "$prompt"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
