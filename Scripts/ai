#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${ROOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
OFFLOAD_RUNNER="$SCRIPT_DIR/offload-runner.mjs"

usage() {
  cat <<'EOF'
Usage: ai <command> [prompt]

Commands:
  code|vscode|open [path]
      Open a path in VS Code. Defaults to the current directory.

  claude [prompt]
      Start Claude interactively, or run a one-shot prompt with --print.

  gemini [prompt]
      Start Gemini interactively, or run a one-shot prompt with -p.

  codex [prompt]
      Start Codex interactively, or run a one-shot prompt with codex exec.

  btw [prompt]
      Route a live steering hint to the best lane, local first.

  moonshot [prompt]
      Route directly to the Moonshot cloud lane (deprecated compatibility).

  offload [options] [prompt]
      Route through the NUDIMMUD offload system (auto, --model, --swarm, --list, --dry-run, --route-only).

  offload swarm [prompt]
      Run offload swarm with default lane set (gpt-oss,ollama).

  offload capabilities
      Print the full lane and model inventory (JSON).

  swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out GPT-OSS and Ollama as needed.

  doctor
      Check that the launcher and offload entrypoints are available.

  route [prompt]
      Print the lane that btw would choose without executing it.

  @kimi [prompt]
      Deprecated compatibility route to the Kimi cloud offload lane.

  @gpt-oss [prompt]
      Run the direct GPT-OSS local offload lane.

  @ollama [prompt]
      Run the direct Ollama local offload lane.

  @deepseek [prompt]
      Run the direct DeepSeek local offload lane.

  @deepseek-v4-flash [prompt]
      Run the official DeepSeek V4 Flash lane (non-thinking default).

  @deepseek-v4-pro [prompt]
      Run the official DeepSeek V4 Pro lane (thinking default).

  @deepseek-v4-pro-lite-budget [prompt]
      Run the DeepSeek V4 Pro budget lane (non-thinking, tight caps).

  @deepseek-chat [prompt]
      Compatibility alias for DeepSeek V4 Flash non-thinking mode.

  @deepseek-reasoner [prompt]
      Compatibility alias for DeepSeek V4 Flash thinking mode.

  @deepseek-cloud [prompt]
      Compatibility alias for DeepSeek V4 Pro.

  @triage-local [prompt]
      Run the triage-local lane (fast lightweight local model).

  @summarize-local [prompt]
      Run the summarize-local lane (summarization-optimized local model).

  @code-local [prompt]
      Run the code-local lane (code-specialized local model, prefers qwen2.5-coder).

  @reason-kimi [prompt]
      Deprecated compatibility route for Kimi reasoning (cloud, thinking enabled).

  @code-deepseek [prompt]
      Run the code-deepseek lane (compatibility alias for DeepSeek V4 Pro).

  @deepseek-workhorse [prompt]
      Run DeepSeek workhorse swarm (cloud): deepseek-v4-pro-lite-budget,deepseek-v4-flash.
      Supports --dry-run / --route-only to preview lanes without live API calls.
      Read-only routing only. No write, patch, stage, or commit capability.

  @reason-cloud [prompt]
      Run the reason-cloud lane (Ollama Cloud reasoning, defaults to qwen2.5:72b).

  @code-cloud [prompt]
      Run the code-cloud lane (Ollama Cloud code, defaults to qwen2.5-coder:32b).

  @gemma [prompt]
      Run the gemma lane (cloud-first if OLLAMA_API_KEY set, local Gemma4 fallback).

  @gemma-local [prompt]
      Run the gemma-local lane (local Gemma4 only, no non-Gemma fallback).

  @gemma-cloud [prompt]
      Run the gemma-cloud lane (Ollama Cloud Gemma4 only).

  @swarm [prompt]
      Run Ruflo-backed swarm routing, then fan out Kimi, GPT-OSS, and Ollama as needed.

  ruflo [prompt]
      Ask Ruflo for routing guidance without executing the routed lane.

  triage [prompt]
      Run claude, gemini, and codex in parallel and print all three outputs.

Examples:
  ai code .
  ai claude "Trace the auth flow in this repo"
  ai gemini "Summarize the latest changes"
  ai codex "Find the riskiest file in backend/src"
  ai btw "offload this review"
  ai moonshot "deep architecture review"
  ai swarm "review this branch"
  ai doctor
  ai route "offload swarm proceed"
  ai @deepseek-workhorse "Summarize this branch"
  ai @swarm "Review the auth flow"
  ai triage "What should I change first?"
  ai ruflo "Route this feature"
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 127
  fi
}

gemini_policy_guard() {
  require_cmd python3
  python3 "$ROOT_DIR/Scripts/gemini-policy-guard.py"
}

run_gemini_safe() {
  gemini_policy_guard
  require_cmd gemini
  exec gemini "$@"
}

run_gemini_prompt() {
  local prompt="$1"
  gemini_policy_guard
  require_cmd gemini
  exec gemini -p "$prompt"
}

join_prompt() {
  printf '%s' "$*"
}

print_section() {
  local title="$1"
  local file="$2"
  printf '\n[%s]\n' "$title"
  if [ -s "$file" ]; then
    sed -n '1,220p' "$file"
  else
    echo "(no output)"
  fi
}

print_route_section() {
  local title="$1"
  local file="$2"
  if [ -s "$file" ]; then
    printf '\n[%s route]\n' "$title"
    sed -n '1,220p' "$file"
  fi
}

cleanup_tmpdir() {
  local path="${1:-}"
  if [ -n "$path" ] && [ -d "$path" ]; then
    rm -rf -- "$path"
  fi
}

run_triage() {
  local prompt="$1"
  local tmpdir="" claude_out claude_err gemini_out gemini_err codex_out codex_err
  local pid_claude pid_gemini pid_codex status

  require_cmd claude
  require_cmd codex
  gemini_policy_guard

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-triage.XXXXXX")"
  claude_out="$tmpdir/claude.txt"
  claude_err="$tmpdir/claude.route.txt"
  gemini_out="$tmpdir/gemini.txt"
  gemini_err="$tmpdir/gemini.route.txt"
  codex_out="$tmpdir/codex.txt"
  codex_err="$tmpdir/codex.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  (
    claude --print "$prompt" >"$claude_out" 2>"$claude_err"
  ) &
  pid_claude=$!

  (
    run_gemini_prompt "$prompt" >"$gemini_out" 2>"$gemini_err"
  ) &
  pid_gemini=$!

  (
    codex exec --cd "$ROOT_DIR" "$prompt" >"$codex_out" 2>"$codex_err"
  ) &
  pid_codex=$!

  status=0
  if ! wait "$pid_claude"; then
    status=1
  fi
  if ! wait "$pid_gemini"; then
    status=1
  fi
  if ! wait "$pid_codex"; then
    status=1
  fi

  print_section "claude" "$claude_out"
  print_route_section "claude" "$claude_err"
  print_section "gemini" "$gemini_out"
  print_route_section "gemini" "$gemini_err"
  print_section "codex" "$codex_out"
  print_route_section "codex" "$codex_err"

  return "$status"
}

run_codex_offload() {
  local agent="$1"
  shift

  require_cmd codex
  exec codex exec --cd "$ROOT_DIR" "@${agent} $(join_prompt "$@")"
}

run_offload_lane() {
  local lane="$1"
  shift
  local prompt
  prompt="$(join_prompt "$@")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  require_cmd node
  OFFLOAD_PROMPT_TEXT="$prompt" exec node "$OFFLOAD_RUNNER" "$lane"
}

run_codex_swarm() {
  local prompt="$1"
  local tmpdir="" gpt_oss_out gpt_oss_err ollama_out ollama_err
  local status=0

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'gpt-oss\n'
    printf 'ollama\n'
    return
  fi

  require_cmd node

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-swarm.XXXXXX")"
  gpt_oss_out="$tmpdir/gpt-oss.txt"
  gpt_oss_err="$tmpdir/gpt-oss.route.txt"
  ollama_out="$tmpdir/ollama.txt"
  ollama_err="$tmpdir/ollama.route.txt"

  trap "cleanup_tmpdir \"$tmpdir\"" EXIT

  # Local lanes: serialize to avoid Ollama GPU/memory contention on M2 Pro
  if ! node "$OFFLOAD_RUNNER" gpt-oss "$prompt" >"$gpt_oss_out" 2>"$gpt_oss_err"; then
    status=1
  fi
  if ! node "$OFFLOAD_RUNNER" ollama "$prompt" >"$ollama_out" 2>"$ollama_err"; then
    status=1
  fi
  print_section "gpt-oss" "$gpt_oss_out"
  print_route_section "gpt-oss" "$gpt_oss_err"
  print_section "ollama" "$ollama_out"
  print_route_section "ollama" "$ollama_err"

  return "$status"
}

run_ruflo_route() {
  local prompt="$1"

  if command -v ruflo >/dev/null 2>&1; then
    ruflo hooks route -t "$prompt"
    return
  fi

  require_cmd npx
  npx -y ruflo@latest hooks route -t "$prompt"
}
# Evidence bundle extractor: runs yuri-memory-map for recognized surfaces
_fused_swarm_extract_evidence_bundle() {
  local _prompt_lower
  _prompt_lower="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  local _all_surfaces="rules vault archive workhorse graphify model-registry"
  local _found_surfaces=""
  local _surface
  for _surface in $_all_surfaces; do
    if printf '%s' "$_prompt_lower" | grep -Fq "$_surface"; then
      _found_surfaces="$_found_surfaces $_surface"
    fi
  done
  _found_surfaces="$(printf '%s' "$_found_surfaces" | xargs)"
  FUSED_SWARM_EVIDENCE_SURFACES="$_found_surfaces"
  if [ -z "$_found_surfaces" ]; then
    FUSED_SWARM_EVIDENCE_ENABLED=false
    FUSED_SWARM_EVIDENCE_BUNDLE=""
    FUSED_SWARM_EVIDENCE_TRUNCATED=false
    return
  fi
  FUSED_SWARM_EVIDENCE_ENABLED=true
  local _bundle=""
  local _line_count=0
  local _per_surface_max=12
  local _total_max=80
  local _truncated=false
  local _output
  for _surface in $_found_surfaces; do
    if [ "$_line_count" -ge "$_total_max" ]; then
      _truncated=true
      break
    fi
    _output="$(node Scripts/yuri-memory-map.mjs --surface "$_surface" 2>/dev/null || echo 'SURFACE_ERROR')"
    _bundle="${_bundle}surface=${_surface}"$'\n'
    _line_count=$(( _line_count + 1 ))
    local _per_surface_count=0
    while IFS= read -r _line; do
      if [ "$_per_surface_count" -ge "$_per_surface_max" ] || [ "$_line_count" -ge "$_total_max" ]; then
        if [ "$_per_surface_count" -ge "$_per_surface_max" ]; then
          _bundle="${_bundle}  [capped at ${_per_surface_max} lines]"$'\n'
          _line_count=$(( _line_count + 1 ))
        fi
        _truncated=true
        break
      fi
      _bundle="${_bundle}  ${_line}"$'\n'
      _line_count=$(( _line_count + 1 ))
      _per_surface_count=$(( _per_surface_count + 1 ))
    done <<< "$_output"
  done

  # Append bounded rule-vault term evidence if both rules and vault are detected
  local _has_rules=0 _has_vault=0 _f
  for _f in $_found_surfaces; do
    [ "$_f" = "rules" ] && _has_rules=1
    [ "$_f" = "vault" ] && _has_vault=1
  done
  if [ "$_has_rules" -eq 1 ] && [ "$_has_vault" -eq 1 ] && [ "$_line_count" -lt "$_total_max" ]; then
    local _term_evidence=""
    _term_evidence="$(_fused_swarm_extract_rule_vault_term_evidence "$_line_count" "$_total_max")"
    if [ -n "$_term_evidence" ]; then
      _bundle="${_bundle}${_term_evidence}"
      local _term_lines
      _term_lines="$(printf '%s' "$_term_evidence" | wc -l | tr -d ' ')"
      _line_count=$(( _line_count + _term_lines ))
    fi
  fi

  FUSED_SWARM_EVIDENCE_TRUNCATED=$_truncated
  FUSED_SWARM_EVIDENCE_BUNDLE="$_bundle"
}

# Bounded deterministic rule-vault term matching: scans .claude/rules for vault domain terms
_fused_swarm_extract_rule_vault_term_evidence() {
  local _current_lines="$1"
  local _max_lines="$2"
  local _remaining=$(( _max_lines - _current_lines ))
  [ "$_remaining" -le 0 ] && return

  local _rules_dir=".claude/rules"
  local _max_matches=80
  local _max_per_file_per_term=3
  local _excerpt_max=160
  local _domains="COSMOLOGY CONSCIOUSNESS COMMUNICATION SYNTHESIS OPERATIONAL META HERMETIC DEPLOYMENT EVOLUTION DISTRIBUTION QUALITY DEFENSE SWARM CANON INGESTION SYSTEM RESOURCE MEMORY COMMAND NEURAL PROJECT_ENGINE CLAUDIO_VAULT PROJECTS"
  local _result=""
  local _match_count=0
  local _no_match_count=0
  local _header_printed=false
  local _budget_spent=0

  for _rule_file in "$ROOT_DIR/$_rules_dir"/*.md; do
    [ -f "$_rule_file" ] || continue
    local _basename="$(basename "$_rule_file")"
    for _term in $_domains; do
      [ "$_budget_spent" -ge "$_remaining" ] && break 2
      [ "$_match_count" -ge "$_max_matches" ] && break 2
      local _search_pat="$_term"
      if printf '%s' "$_term" | grep -q '_'; then
        local _spaced; _spaced="$(printf '%s' "$_term" | tr '_' ' ')"
        local _hyphened; _hyphened="$(printf '%s' "$_term" | tr '_' '-')"
        _search_pat="${_term}|${_spaced}|${_hyphened}"
      fi
      local _matches
      _matches="$(grep -in "$_search_pat" "$_rule_file" 2>/dev/null | head -n "$_max_per_file_per_term")" || true
      if [ -n "$_matches" ]; then
        while IFS= read -r _mline; do
          [ "$_budget_spent" -ge "$_remaining" ] && break 2
          [ "$_match_count" -ge "$_max_matches" ] && break 2
          if ! $_header_printed; then
            _result="${_result}surface=rule_vault_term_matches"$'
'
            _budget_spent=$(( _budget_spent + 1 ))
            _header_printed=true
          fi
          local _lnum; _lnum="$(printf '%s' "$_mline" | cut -d: -f1)"
          local _text; _text="$(printf '%s' "$_mline" | cut -d: -f2- | head -c "$_excerpt_max")"
          _result="${_result}MATCH file=.claude/rules/${_basename} term=${_term} line=${_lnum} excerpt="${_text}""$'
'
          _match_count=$(( _match_count + 1 ))
          _budget_spent=$(( _budget_spent + 1 ))
        done <<< "$_matches"
      else
        _no_match_count=$(( _no_match_count + 1 ))
      fi
    done
  done
  if $_header_printed && [ "$_match_count" -eq 0 ]; then
    _result="${_result}  no_matches: vault domain terms not found in .claude/rules content"$'\n'
  fi

  # Append deterministic aggregate counts from MATCH lines
  if $_header_printed && [ "$_match_count" -gt 0 ]; then
    local _agg_section="" _count _name _files _filelist _terms _termlist
    local _agg_terms _agg_files _match_data
    _match_data="$(printf '%s' "$_result" | grep '^MATCH ')"
    _agg_terms="$(printf '%s' "$_match_data" | sed 's/.*term=//;s/ .*//' | sort | uniq -c | sort -rn | head -30)"
    _agg_files="$(printf '%s' "$_match_data" | sed 's/^MATCH file=.claude.rules.//;s/ term=.*//' | sort | uniq -c | sort -rn | head -20)"
    _agg_section="${_agg_section}surface=rule_vault_term_aggregates"$'\n'
    if [ -n "$_agg_terms" ]; then
      while read -r _count _name; do
        [ -z "$_count" ] && continue
        _files="$(printf '%s' "$_match_data" | grep " term=${_name} " | grep -o 'file=[^ ]*' | sort -u | wc -l | tr -d ' ')"
        _filelist="$(printf '%s' "$_match_data" | grep " term=${_name} " | grep -o 'file=[^ ]*' | sort -u | tr '\n' ',' | sed 's/,$//')"
        _agg_section="${_agg_section}TERM_COUNT term=${_name} count=${_count}"$'\n'
      done <<< "$_agg_terms"
    fi
    if [ -n "$_agg_files" ]; then
      while read -r _count _name; do
        [ -z "$_count" ] && continue
        _terms="$(printf '%s' "$_match_data" | grep -F "${_name}" | grep -o 'term=[^ ]*' | sed 's/term=//' | sort -u | wc -l | tr -d ' ')"
        _termlist="$(printf '%s' "$_match_data" | grep -F "${_name}" | grep -o 'term=[^ ]*' | sed 's/term=//' | sort -u | tr '\n' ',' | sed 's/,$//')"
        _agg_section="${_agg_section}FILE_COUNT file=.claude/rules/${_name} count=${_count}"$'\n'
      done <<< "$_agg_files"
    fi
    _result="${_result}${_agg_section}"
  fi

  printf '%s' "$_result"
}

_fused_swarm_write_evidence_bundle() {
  local _bundle="$1"
  local _run_dir="$2"
  {
    printf 'EVIDENCE_BUNDLE_START\nadvisory_only=true\nlocal_truth_claim=false\n'
    if [ "$FUSED_SWARM_EVIDENCE_TRUNCATED" = true ]; then
      printf 'EVIDENCE_BUNDLE_TRUNCATED=true\n'
    fi
    printf '%s' "$_bundle"
    printf 'EVIDENCE_BUNDLE_END\n'
  } > "$_run_dir/evidence-bundle.txt"
}

_fused_swarm_prepend_evidence() {
  local _prompt="$1"
  local _bundle="$2"
  if [ -z "$_bundle" ]; then
    printf '%s' "$_prompt"
    return
  fi
  printf 'EVIDENCE_BUNDLE_START\nadvisory_only=true\nlocal_truth_claim=false\n'
  if [ "$FUSED_SWARM_EVIDENCE_TRUNCATED" = true ]; then
    printf 'EVIDENCE_BUNDLE_TRUNCATED=true\n'
  fi
  printf '%s' "$_bundle"
  printf 'EVIDENCE_BUNDLE_END\n\n'
  printf 'Use only paths and surface names present in EVIDENCE_BUNDLE.\n'
  printf 'If evidence is insufficient, say no_evidence.\n'
  printf 'Do not invent file paths, rule IDs, vault paths, archive paths, or model-registry paths.\n'
  printf 'All output is advisory_only=true and local_truth_claim=false.\n\n'
  printf '%s' "$_prompt"
}

_fused_swarm_orchestrate() {
  local _dry_run=0
  local _route_only=0
  local _artifact_root="/private/tmp/yuri-artifacts"
  local _prompt_parts=()

  for _arg in "$@"; do
    case "$_arg" in
      --dry-run|-d) _dry_run=1 ;;
      --route-only) _route_only=1 ;;
      *)
        _prompt_parts+=("$_arg")
        ;;
    esac
  done

  local prompt="$(join_prompt ${_prompt_parts[@]+"${_prompt_parts[@]}"})"

  if [ -z "$prompt" ]; then
    if [ "$_dry_run" -eq 0 ] && [ "$_route_only" -eq 0 ]; then
      usage
      exit 1
    fi
  fi

  # Extract evidence bundle from prompt
  _fused_swarm_extract_evidence_bundle "$prompt"

  if [ "$_dry_run" -eq 1 ] || [ "$_route_only" -eq 1 ]; then
    printf 'FUSED_SWARM_DRY_RUN=1\n'
    printf 'FUSED_SWARM_ARTIFACT_ROOT=%s\n' "$_artifact_root"
    printf 'FUSED_SWARM_RUFLO=advisory_status_only\n'
    printf 'FUSED_SWARM_WORKHORSE=deepseek-v4-pro-lite-budget,deepseek-v4-flash\n'
    printf 'FUSED_SWARM_ADVISORY_ONLY=true\n'
    printf 'FUSED_SWARM_LOCAL_TRUTH_CLAIM=false\n'
    printf 'FUSED_SWARM_REQUIRES_APPROVAL=true\n'
    printf 'FUSED_SWARM_EVIDENCE_HOOK=enabled\n'
    printf 'FUSED_SWARM_EVIDENCE_SURFACES=%s\n' "${FUSED_SWARM_EVIDENCE_SURFACES:-none}"
    printf 'FUSED_SWARM_EVIDENCE_MAX_LINES=80\n'
    return 0
  fi

  require_cmd node
  require_cmd shasum

  _run_id="$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 4)"
  _run_dir="$_artifact_root/$_run_id"
  mkdir -p "$_run_dir"

  # Prepend evidence bundle to prompt
  local _enhanced_prompt
  _enhanced_prompt="$(_fused_swarm_prepend_evidence "$prompt" "$FUSED_SWARM_EVIDENCE_BUNDLE")"

  _prompt_sha256="$(printf '%s' "$_enhanced_prompt" | shasum -a 256 | awk '{print $1}')"

  _swarm_stdout="$_run_dir/swarm_output.tmp"
  _swarm_stderr="$_run_dir/swarm_error.txt"
  _swarm_status=0

  # Write evidence bundle to artifact dir
  _fused_swarm_write_evidence_bundle "$FUSED_SWARM_EVIDENCE_BUNDLE" "$_run_dir"

  # Run ruflo swarm with portable timeout (timeout cannot call bash functions directly)
  local _swarm_timeout=120
  local _swarm_pid
  local _swarm_timed_out=0
  _swarm_completion="completed"
  _swarm_status=0

  run_ruflo_swarm "$_enhanced_prompt" >"$_swarm_stdout" 2>"$_swarm_stderr" &
  _swarm_pid=$!

  # Wait with timeout check in a loop (sleep 1s granularity)
  local _swarm_elapsed=0
  while [ "$_swarm_elapsed" -lt "$_swarm_timeout" ] && kill -0 "$_swarm_pid" 2>/dev/null; do
    sleep 1
    _swarm_elapsed=$(( _swarm_elapsed + 1 ))
  done

  if kill -0 "$_swarm_pid" 2>/dev/null; then
    # Still running after timeout — kill it
    kill "$_swarm_pid" 2>/dev/null || true
    _swarm_completion="timeout"
    _swarm_status=124
  else
    # Process exited; collect exit code
    wait "$_swarm_pid" 2>/dev/null
    _swarm_status=$?
    if [ "$_swarm_status" -ne 0 ]; then
      _swarm_completion="failed"
    fi
  fi

  # Capture output metrics (files may be partial if timed out, but wc/shasum handle empty files)
  _stdout_bytes="$(wc -c < "$_swarm_stdout" 2>/dev/null | tr -d ' ')"
  _stdout_lines="$(wc -l < "$_swarm_stdout" 2>/dev/null | tr -d ' ')"
  _stderr_bytes="$(wc -c < "$_swarm_stderr" 2>/dev/null | tr -d ' ')"
  _stdout_sha256="$(shasum -a 256 "$_swarm_stdout" 2>/dev/null | awk '{print $1}')"
  : "${_stdout_bytes:=0}" "${_stdout_lines:=0}" "${_stderr_bytes:=0}" "${_stdout_sha256:=}"

  # Write advisory output (always, even if partial)
  {
    printf '# ADVISORY_FUSED_SWARM_OUTPUT\n'
    printf '# route: @swarm\n'
    printf '# run_id: %s\n' "$_run_id"
    printf '# sha256: %s\n' "$_stdout_sha256"
    printf '# advisory_only=true\n'
    printf '# local_truth_claim=false\n'
    printf '# requires_approval=true\n'
    printf '# completion_status=%s\n' "$_swarm_completion"
    printf '# exit_code=%s\n' "$_swarm_status"
    printf '\n'
    cat "$_swarm_stdout" 2>/dev/null || printf '# no output captured\n'
  } >"$_run_dir/output.md"

  # Write summary.json (always, even if partial or timed out)
  local _output_md="$_run_dir/output.md"
  printf '{"run_id":"%s","route":"@swarm","fused":true,"artifact_root":"%s","prompt_sha256":"%s","advisory_only":true,"local_truth_claim":false,"requires_approval":true,"stdout_bytes":%s,"stdout_lines":%s,"stderr_bytes":%s,"exit_code":%s,"completion_status":"%s","ruflo_status":"advisory_status_only","workhorse_status":"deepseek-v4-pro-lite-budget,deepseek-v4-flash","paid_lanes":["deepseek"],"non_claims":["no write capability","no patch application","no executor widening"],"evidence_hook_enabled":true,"evidence_surfaces":["%s"],"evidence_bundle_path":"%s","evidence_bundle_truncated":%s,"swarm_output_path":"%s","swarm_error_path":"%s","output_path":"%s"}\n' \
    "$_run_id" "$_artifact_root" "$_prompt_sha256" \
    "$_stdout_bytes" "$_stdout_lines" "$_stderr_bytes" "$_swarm_status" \
    "$_swarm_completion" \
    "${FUSED_SWARM_EVIDENCE_SURFACES:-}" "$_run_dir/evidence-bundle.txt" \
    "${FUSED_SWARM_EVIDENCE_TRUNCATED:-false}" \
    "$_swarm_stdout" "$_swarm_stderr" "$_output_md" \
    >"$_run_dir/summary.json"

  printf 'FUSED_SWARM_RUN=%s\n' "$_run_dir"
  printf 'FUSED_SWARM_SUMMARY=%s\n' "$_run_dir/summary.json"

  # Run Yuri evidence contract validator on completed runs with evidence hook
  local _contract_status=""
  if [ "$_swarm_completion" = "completed" ] && [ "${FUSED_SWARM_EVIDENCE_ENABLED:-false}" = true ]; then
    if ! _contract_status="$(node Scripts/yuri-evidence-contract.mjs "$_run_dir" 2>/dev/null)"; then
      printf 'FUSED_SWARM_STATUS=%s\n' "contract_fail"
      printf 'FUSED_SWARM_CONTRACT=%s\n' "$_contract_status"
    else
      printf 'FUSED_SWARM_STATUS=%s\n' "PASS"
      printf 'FUSED_SWARM_CONTRACT=%s\n' "$_contract_status"
    fi
  elif [ "$_swarm_completion" = "completed" ]; then
    printf 'FUSED_SWARM_STATUS=%s\n' "PASS"
  else
    printf 'FUSED_SWARM_STATUS=%s\n' "${_swarm_completion}"
  fi

  rm -f "$_swarm_stdout" "$_swarm_stderr" 2>/dev/null || true
}

run_ruflo_swarm() {
  local prompt="$1"
  local route route_lower

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf 'ruflo\n'
    return
  fi

  route="$(run_ruflo_route "$prompt" 2>/dev/null || true)"
  route_lower="$(printf '%s' "$route" | tr '[:upper:]' '[:lower:]')"

  if [[ "${AI_TRACE_ROUTING:-0}" == "1" && -n "$route" ]]; then
    printf '\n[ruflo]\n%s\n' "$route"
  fi

  case "$route_lower" in
    *gpt-oss*|*gptoss*)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *ollama*)
      run_offload_lane ollama "$prompt"
      ;;
    *kimi*|*moonshot*)
      run_codex_swarm "$prompt"
      ;;
    *swarm*|*parallel*|*fan-out*|*hierarchical*|*hive*)
      run_codex_swarm "$prompt"
      ;;
    *)
      run_codex_swarm "$prompt"
      ;;
  esac
}

run_codex_hint() {
  local prompt="$1"
  local lane
  lane="$(select_btw_lane "$prompt")"

  if [[ "${AI_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$lane"
    return
  fi

  case "$lane" in
    swarm)
      run_ruflo_swarm "$prompt"
      ;;
    kimi)
      run_offload_lane kimi "$prompt"
      ;;
    gpt-oss)
      run_offload_lane gpt-oss "$prompt"
      ;;
    *)
      run_offload_lane gpt-oss "$prompt"
      ;;
  esac
}

select_btw_lane() {
  local prompt="$1"
  local prompt_lower

  prompt_lower="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')"

  if [[ "$prompt_lower" == *swarm* || "$prompt_lower" == *fan\ out* || "$prompt_lower" == *parallel* || "$prompt_lower" == *compare* ]]; then
    printf 'swarm\n'
    return
  fi

  if [[ "$prompt_lower" == *frontend* || "$prompt_lower" == *ui* || "$prompt_lower" == *design* || "$prompt_lower" == *react* || "$prompt_lower" == *interface* ]]; then
    printf 'gpt-oss\n'
    return
  fi

  if [[ "$prompt_lower" == *moonshot* || "$prompt_lower" == *kimi* || "$prompt_lower" == *cloud* || "$prompt_lower" == *complex* || "$prompt_lower" == *deep* || "$prompt_lower" == *architecture* || "$prompt_lower" == *review* || "$prompt_lower" == *audit* || "$prompt_lower" == *security* ]]; then
    printf 'swarm\n'
    return
  fi

  printf 'gpt-oss\n'
}

check_cmd() {
  local label="$1"
  local bin="$2"

  if command -v "$bin" >/dev/null 2>&1; then
    printf 'ok  %s -> %s\n' "$label" "$(command -v "$bin")"
    return 0
  fi

  printf 'miss %s\n' "$label"
  return 1
}

check_lane() {
  local prompt="$1"
  local expected="$2"
  local lane

  lane="$(select_btw_lane "$prompt")"
  if [ "$lane" = "$expected" ]; then
    printf 'ok  route "%s" -> %s\n' "$prompt" "$lane"
    return 0
  fi

  printf 'miss route "%s" -> %s (expected %s)\n' "$prompt" "$lane" "$expected"
  return 1
}

