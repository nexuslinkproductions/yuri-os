{
  "version": "2026-05-05.scoped-mutation.v1",
  "repo_root": "/Users/marcelspatz/NUDIMMUD",
  "mode": "scoped_mutation_default",
  "allowed_mutation_paths": [
    ".claude/trading-bot/**",
    ".claude/trading-bot-logs/**"
  ],
  "denied_mutation_paths": [
    ".env",
    ".git",
    "backend/data",
    ".claude/history",
    ".claude/state",
    ".claude/cache",
    "node_modules",
    "package.json",
    "package-lock.json"
  ],
  "allowed_files": [
    "Scripts/ai",
    "Scripts/offload.sh",
    "Scripts/offload-runner.mjs",
    "Scripts/nudimmud-repl.mjs",
    "Scripts/yuri-guarded-executor.mjs",
    "Scripts/policy/yuri-guarded-executor.readonly.json",
    ".claude/rules/nudimmud_operating_dna.md",
    ".claude/rules/research_pipeline.md",
    ".claude/rules/local_execution.md",
    "_SYSTEM/yuri-history-archive/session_boot_packet_2026-05-03.md",
    "_SYSTEM/model-registry.md",
    ".claude/config/models.json",
    "package.json"
  ],
  "allowed_write_extensions": [
    ".md",
    ".json",
    ".jsonl",
    ".js",
    ".mjs",
    ".ts",
    ".yaml",
    ".yml",
    ".csv"
  ],
  "denied_path_markers": [
    ".env",
    "secret",
    "token",
    "credential",
    "private_key",
    "id_rsa",
    "backend/data",
    ".db",
    ".sqlite",
    ".wal",
    ".shm"
  ],
  "denied_extensions": [
    ".db",
    ".sqlite",
    ".sqlite3",
    ".wal",
    ".shm",
    ".bin",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".pdf",
    ".zip",
    ".tar",
    ".gz"
  ],
  "denied_globs": [
    "backend/data/*",
    "_SYSTEM/**/*.md"
  ],
  "allowed_checks": [
    "PWD",
    "GIT_BRANCH_SHOW_CURRENT",
    "GIT_REV_PARSE_SHORT_HEAD",
    "GIT_DIFF_CACHED_NAME_ONLY",
    "GIT_STATUS_SCOPED_MANIFEST_AND_DB_FILES",
    "NODE_CHECK_SCRIPT",
    "GREP_Q_MARKER",
    "WC_L_FILE"
  ],
  "allowed_actions": [
    "CREATE_FILE",
    "WRITE_FILE",
    "CREATE_DIRECTORY",
    "READ_FILE",
    "RUN_SCOPED_COMMAND",
    "VALIDATE_STRUCTURE"
  ],
  "denied_actions": [
    "DELETE_FILE",
    "DELETE_DIRECTORY",
    "MODIFY_GIT",
    "COMMIT",
    "PUSH",
    "READ_SECRET",
    "READ_DB",
    "MCP_CALL",
    "SUBAGENT_CALL"
  ],
  "caps": {
    "read_window_lines": 80,
    "aggregate_read_lines": 320,
    "full_small_file_max_lines": 40,
    "search_matches_per_action": 12,
    "search_context_lines_max": 1,
    "command_output_chars": 400,
    "summary_items": 12,
    "max_file_size_bytes": 102400,
    "max_files_per_action": 10
  }
}
